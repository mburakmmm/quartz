# Quartz Contract — Authorized Network Transport & Safety Gate
import nox.http
import nox.strings
import nox.time
import nox.url
from nox.http import HttpRequest, HttpResponse, HttpError, HttpTimeoutError, HttpCapabilityError, stream
from nox.time import Instant
from nox.url import URL, UrlError
from contract.types import ContractCheckResult
from contract.schema import SchemaDescriptor
from contract.compare import validate_response

class NetworkSafetyError(Exception):
    pass

class NetworkNotAllowedError(NetworkSafetyError):
    pass

class UnauthorizedTargetError(NetworkSafetyError):
    pass

class NetworkPolicy:
    allow_network: bool
    authorized_target: str
    timeout_ms: int
    max_body_bytes: int
    enable_http2: bool
    enable_http3: bool
    pool_max_idle: int
    pool_idle_timeout_ms: int
    allow_redirects: bool

    def __init__(self: NetworkPolicy, allow_network: bool = False, authorized_target: str = "", timeout_ms: int = 2000, max_body_bytes: int = 1048576, enable_http2: bool = False, enable_http3: bool = False, pool_max_idle: int = 0, pool_idle_timeout_ms: int = 90000, allow_redirects: bool = False) -> None:
        self.allow_network = allow_network
        self.authorized_target = authorized_target
        self.timeout_ms = timeout_ms
        self.max_body_bytes = max_body_bytes
        self.enable_http2 = enable_http2
        self.enable_http3 = enable_http3
        self.pool_max_idle = pool_max_idle
        self.pool_idle_timeout_ms = pool_idle_timeout_ms
        self.allow_redirects = allow_redirects

def apply_network_transport_options(policy: NetworkPolicy) -> None:
    if policy.enable_http2:
        nox.http.set_http2(True)
    if policy.enable_http3:
        nox.http.set_http3(True)
    if policy.pool_max_idle > 0:
        nox.http.client_pool(policy.pool_max_idle, policy.pool_idle_timeout_ms)

def default_network_policy() -> NetworkPolicy:
    # Safe default: network strictly disabled
    return NetworkPolicy(False, "", 2000, 1048576)

def loopback_network_policy(timeout_ms: int = 2000) -> NetworkPolicy:
    # Explicit loopback-only policy
    return NetworkPolicy(True, "", timeout_ms, 1048576)

def authorized_network_policy(authorized_target: str, timeout_ms: int = 2000) -> NetworkPolicy:
    # Explicit authorized remote target policy
    return NetworkPolicy(True, authorized_target, timeout_ms, 1048576)

class ParsedUrl:
    scheme: str
    host: str
    port: int
    path: str
    origin: str

    def __init__(self: ParsedUrl, scheme: str, host: str, port: int, path: str, origin: str) -> None:
        self.scheme = scheme
        self.host = host
        self.port = port
        self.path = path
        self.origin = origin

def _extract_raw_authority(url: str) -> str:
    sep: int = nox.strings.index_of(url, "://")
    if sep < 0:
        return ""
    rest: str = url[sep + 3:len(url)]
    cut: int = len(rest)
    slash: int = nox.strings.index_of(rest, "/")
    if slash >= 0 and slash < cut:
        cut = slash
    q: int = nox.strings.index_of(rest, "?")
    if q >= 0 and q < cut:
        cut = q
    h: int = nox.strings.index_of(rest, "#")
    if h >= 0 and h < cut:
        cut = h
    return rest[0:cut]

def parse_url(url: str) -> ParsedUrl:
    if len(url) == 0:
        raise NetworkSafetyError("empty URL rejected")
    if nox.strings.contains(url, "\r") or nox.strings.contains(url, "\n"):
        raise NetworkSafetyError("control character rejected in URL")

    raw_auth: str = _extract_raw_authority(url)
    if nox.strings.contains(raw_auth, "@"):
        raise NetworkSafetyError("userinfo / '@' authority rejected (SSRF protection): " + url)
    if nox.strings.contains(raw_auth, "\\"):
        raise NetworkSafetyError("backslash rejected in URL authority: " + url)

    parsed: URL = URL("", "", "", 0, "/", {}, "")
    try:
        parsed = nox.url.parse(url)
    except UrlError as ue:
        raise NetworkSafetyError("invalid URL: " + str(ue))
    except Exception as ex:
        raise NetworkSafetyError("failed to parse URL: " + str(ex))

    scheme: str = nox.strings.lower(parsed.scheme)
    if scheme != "http" and scheme != "https":
        raise NetworkSafetyError("invalid URL scheme (must be http:// or https://): " + url)

    if len(parsed.userinfo) > 0:
        raise NetworkSafetyError("userinfo rejected in URL (SSRF protection): " + url)

    host: str = nox.strings.lower(nox.strings.trim(parsed.host))
    if len(host) == 0:
        raise NetworkSafetyError("empty URL host rejected: " + url)
    if host != parsed.host and nox.strings.lower(parsed.host) != host:
        raise NetworkSafetyError("whitespace rejected in URL host: " + url)
    if nox.strings.contains(host, " ") or nox.strings.contains(host, "\t") or nox.strings.contains(host, "\\") or nox.strings.contains(host, "@"):
        raise NetworkSafetyError("unsafe characters in URL host: " + url)

    port: int = parsed.port
    if port <= 0 or port > 65535:
        raise NetworkSafetyError("port out of range 1..65535: " + str(port))

    origin: str = scheme + "://" + host + ":" + str(port)
    return ParsedUrl(scheme, host, port, parsed.path, origin)

def is_loopback_host(host: str) -> bool:
    h: str = nox.strings.lower(host)
    if h == "127.0.0.1" or h == "localhost" or h == "::1" or h == "[::1]":
        return True
    return False

def validate_network_target(url: str, policy: NetworkPolicy) -> ParsedUrl:
    if not policy.allow_network:
        raise NetworkNotAllowedError("network transport disabled by policy (pass allow_network=True to opt-in): " + url)

    parsed: ParsedUrl = parse_url(url)

    # 1. Loopback check: always permitted when allow_network is True
    if is_loopback_host(parsed.host):
        return parsed

    # 2. Remote host check: strictly requires matching authorized_target
    if len(policy.authorized_target) == 0:
        raise UnauthorizedTargetError("remote network target rejected (only loopback is allowed without explicit authorized_target): " + url)

    auth_parsed: ParsedUrl = parse_url(policy.authorized_target)
    if parsed.scheme != auth_parsed.scheme or parsed.host != auth_parsed.host or parsed.port != auth_parsed.port:
        raise UnauthorizedTargetError("target origin '" + parsed.origin + "' does not match authorized origin '" + auth_parsed.origin + "'")

    return parsed

def validate_redirect_target(current_url: str, location: str, policy: NetworkPolicy) -> ParsedUrl:
    if not policy.allow_redirects:
        raise UnauthorizedTargetError("HTTP redirect blocked by policy (redirects disabled by default): " + location)
    loc: str = nox.strings.trim(location)
    if len(loc) == 0:
        raise NetworkSafetyError("empty redirect Location header")
    if nox.strings.starts_with(loc, "//"):
        cur: ParsedUrl = parse_url(current_url)
        return validate_network_target(cur.scheme + ":" + loc, policy)
    if nox.strings.starts_with(loc, "/"):
        cur2: ParsedUrl = parse_url(current_url)
        return validate_network_target(cur2.origin + loc, policy)
    return validate_network_target(loc, policy)

class NetworkExecutionResult:
    responses: list[HttpResponse]
    duration_ms: int
    duration_ns: int
    status_code: int
    error_message: str
    is_timeout: bool
    is_success: bool

    def __init__(self: NetworkExecutionResult, responses: list[HttpResponse], duration_ms: int, status_code: int, error_message: str, is_timeout: bool, is_success: bool, duration_ns: int = 0) -> None:
        self.responses = responses
        self.duration_ms = duration_ms
        self.duration_ns = duration_ns
        self.status_code = status_code
        self.error_message = error_message
        self.is_timeout = is_timeout
        self.is_success = is_success

def execute_network_request(req: HttpRequest, base_url: str, policy: NetworkPolicy) -> NetworkExecutionResult:
    target_path: str = req.target
    if len(target_path) == 0 or target_path[0:1] != "/":
        target_path = "/" + target_path

    full_url: str = base_url + target_path
    parsed: ParsedUrl = validate_network_target(full_url, policy)
    apply_network_transport_options(policy)

    empty_res_list: list[HttpResponse] = []
    ns0: int = nox.time.monotonic_ns()
    try:
        accum_body: str = ""
        res_status: int = 0
        res_headers: dict[str, str] = {}
        with stream(req.method, full_url, req.headers, req.body, policy.timeout_ms) as s:
            res_status = s.status
            res_headers = s.headers
            chunk_size: int = 16384
            while len(accum_body) < policy.max_body_bytes:
                to_read: int = policy.max_body_bytes - len(accum_body)
                if to_read > chunk_size:
                    to_read = chunk_size
                chunk: str = s.read_chunk(to_read)
                if len(chunk) == 0:
                    break
                accum_body = accum_body + chunk

        dur_ns: int = nox.time.monotonic_ns() - ns0
        if dur_ns < 0:
            dur_ns = 0
        elapsed_ms: int = dur_ns // 1000000
        res: HttpResponse = HttpResponse(res_status, accum_body, res_headers)
        res_list: list[HttpResponse] = [res]
        return NetworkExecutionResult(res_list, elapsed_ms, res.status, "", False, True, dur_ns)
    except HttpTimeoutError as e:
        dur_ns: int = nox.time.monotonic_ns() - ns0
        if dur_ns < 0:
            dur_ns = 0
        return NetworkExecutionResult(empty_res_list, dur_ns // 1000000, 0, "request timed out after " + str(policy.timeout_ms) + "ms", True, False, dur_ns)
    except HttpCapabilityError as e:
        dur_ns: int = nox.time.monotonic_ns() - ns0
        if dur_ns < 0:
            dur_ns = 0
        return NetworkExecutionResult(empty_res_list, dur_ns // 1000000, 0, "network capability denied: " + str(e), False, False, dur_ns)
    except HttpError as e:
        dur_ns: int = nox.time.monotonic_ns() - ns0
        if dur_ns < 0:
            dur_ns = 0
        return NetworkExecutionResult(empty_res_list, dur_ns // 1000000, 0, "http transport error: " + str(e), False, False, dur_ns)
    except Exception as e:
        dur_ns: int = nox.time.monotonic_ns() - ns0
        if dur_ns < 0:
            dur_ns = 0
        return NetworkExecutionResult(empty_res_list, dur_ns // 1000000, 0, "unexpected network failure: " + str(e), False, False, dur_ns)

def run_network_contract_check(req: HttpRequest, base_url: str, policy: NetworkPolicy, expected_statuses: list[int], required_headers: list[str], expected_content_type: str, body_schema: SchemaDescriptor | None) -> ContractCheckResult:
    exec_res: NetworkExecutionResult = execute_network_request(req, base_url, policy)
    if not exec_res.is_success:
        errs: list[str] = [exec_res.error_message]
        warns: list[str] = []
        return ContractCheckResult(False, errs, warns, exec_res.status_code, exec_res.duration_ms)

    if len(exec_res.responses) > 0:
        actual_res: HttpResponse = exec_res.responses[0]
        return validate_response(actual_res, expected_statuses, required_headers, expected_content_type, body_schema, exec_res.duration_ms)

    errs: list[str] = ["missing response from transport"]
    warns: list[str] = []
    return ContractCheckResult(False, errs, warns, 0, exec_res.duration_ms)
