# Quartz Contract — Server-Sent Events (SSE) Stream Validator
# Spec-compliant EventSource parser according to WHATWG EventSource standards,
# supporting multiline data, retry intervals, ID persistence, and typed JSON schema validation.

import nox.strings
import nox.json
from nox.json import JsonValue
from contract.schema import SchemaDescriptor, validate_schema

class SseEvent:
    event: str
    data: str
    id: str
    retry: int

    def __init__(self: SseEvent, event: str, data: str, id: str, retry: int) -> None:
        self.event = event
        self.data = data
        self.id = id
        self.retry = retry

    def is_json(self: SseEvent) -> bool:
        trimmed: str = nox.strings.trim(self.data)
        if len(trimmed) == 0:
            return False
        first_c: str = trimmed[0]
        last_c: str = trimmed[len(trimmed) - 1]
        return (first_c == "{" and last_c == "}") or (first_c == "[" and last_c == "]")

def parse_sse_events(raw_body: str) -> list[SseEvent]:
    events: list[SseEvent] = []
    if len(raw_body) == 0:
        return events

    # 1. Normalize line endings: CRLF and solitary CR become LF
    c1: str = nox.strings.replace(raw_body, "\r\n", "\n")
    clean: str = nox.strings.replace(c1, "\r", "\n")

    # In WHATWG spec, events are only dispatched upon reaching an empty line (dispatch boundary).
    # If the stream does not end with an empty line (e.g. terminating "\n\n" or "\n\n..."),
    # trailing incomplete pending data must not be dispatched.
    ends_with_boundary: bool = nox.strings.ends_with(clean, "\n\n")

    blocks: list[str] = nox.strings.split(clean, "\n\n")
    # If clean doesn't end with "\n\n", the last item in blocks is an incomplete trailing fragment
    total_valid_blocks: int = len(blocks)
    if not ends_with_boundary:
        total_valid_blocks = len(blocks) - 1

    last_event_id: str = ""
    retry_ms: int = 0

    b_i: int = 0
    while b_i < total_valid_blocks:
        block: str = blocks[b_i]
        # Ignore purely empty whitespace blocks
        if len(block) > 0:
            event_name: str = "message"
            data_lines: list[str] = []
            data_seen: bool = False

            lines: list[str] = nox.strings.split(block, "\n")
            l_i: int = 0
            while l_i < len(lines):
                line: str = lines[l_i]
                # Ignore empty line or comments starting with ':'
                if len(line) > 0 and line[0] != ":":
                    field_name: str = line
                    field_value: str = ""

                    if nox.strings.contains(line, ":"):
                        parts: list[str] = nox.strings.splitn(line, ":", 2)
                        field_name = parts[0]
                        if len(parts) > 1:
                            raw_val: str = parts[1]
                            # Per SSE spec: If value starts with a single space U+0020, remove only that space
                            if len(raw_val) > 0 and raw_val[0] == " ":
                                if len(raw_val) > 1:
                                    subparts: list[str] = nox.strings.splitn(raw_val, " ", 2)
                                    if len(subparts) > 1:
                                        field_value = subparts[1]
                                else:
                                    field_value = ""
                            else:
                                field_value = raw_val

                    if field_name == "data":
                        data_lines.append(field_value)
                        data_seen = True
                    elif field_name == "event":
                        event_name = field_value
                    elif field_name == "id":
                        null_ch: str = chr(0)
                        if not nox.strings.contains(field_value, null_ch):
                            last_event_id = field_value
                    elif field_name == "retry":
                        try:
                            retry_ms = int(field_value)
                        except Exception as e:
                            pass
                l_i = l_i + 1

            # WHATWG Spec Rule: If no data field was seen in this block, DO NOT dispatch an event.
            # Setting retry: or id: alone updates state but must never dispatch an empty event.
            if data_seen:
                data_joined: str = ""
                d_i: int = 0
                while d_i < len(data_lines):
                    if d_i > 0:
                        data_joined = data_joined + "\n"
                    data_joined = data_joined + data_lines[d_i]
                    d_i = d_i + 1

                disp_type: str = event_name
                if len(disp_type) == 0:
                    disp_type = "message"
                events.append(SseEvent(disp_type, data_joined, last_event_id, retry_ms))

        b_i = b_i + 1

    return events

class SseEventExpectation:
    expected_event: str
    schema: SchemaDescriptor
    has_schema: bool
    require_id: bool

    def __init__(self: SseEventExpectation, expected_event: str, schema: SchemaDescriptor, has_schema: bool, require_id: bool) -> None:
        self.expected_event = expected_event
        self.schema = schema
        self.has_schema = has_schema
        self.require_id = require_id

class SseValidationResult:
    is_valid: bool
    total_events: int
    errors: list[str]

    def __init__(self: SseValidationResult, is_valid: bool, total_events: int, errors: list[str]) -> None:
        self.is_valid = is_valid
        self.total_events = total_events
        self.errors = errors

    def error_summary(self: SseValidationResult) -> str:
        if len(self.errors) == 0:
            return ""
        s: str = ""
        i: int = 0
        while i < len(self.errors):
            s = s + self.errors[i]
            if i + 1 < len(self.errors):
                s = s + "; "
            i = i + 1
        return s

def validate_sse_stream(raw_body: str, expectations: list[SseEventExpectation]) -> SseValidationResult:
    events: list[SseEvent] = parse_sse_events(raw_body)
    errs: list[str] = []

    if len(events) != len(expectations):
        errs.append("event count mismatch: expected " + str(len(expectations)) + " events, received " + str(len(events)))
        return SseValidationResult(False, len(events), errs)

    i: int = 0
    while i < len(events):
        ev: SseEvent = events[i]
        exp: SseEventExpectation = expectations[i]
        prefix: str = "event[" + str(i) + "] "

        # 1. Event name check
        if ev.event != exp.expected_event:
            errs.append(prefix + "name mismatch: expected '" + exp.expected_event + "', received '" + ev.event + "'")

        # 2. Event ID check
        if exp.require_id and len(ev.id) == 0:
            errs.append(prefix + "missing required id field")

        # 3. Schema validation on payload
        if exp.has_schema:
            try:
                json_node: JsonValue = nox.json.parse(ev.data)
                schema_errs: list[str] = validate_schema(exp.schema, json_node, "$")
                if len(schema_errs) > 0:
                    s_i: int = 0
                    while s_i < len(schema_errs):
                        errs.append(prefix + "schema violation: " + schema_errs[s_i])
                        s_i = s_i + 1
            except Exception as e:
                errs.append(prefix + "invalid json: " + str(e))

        i = i + 1

    return SseValidationResult(len(errs) == 0, len(events), errs)
