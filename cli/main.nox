def print_usage() -> None:
    print("Quartz Test Framework CLI (v" + quartz.version() + ")")
    print("Usage: quartz <command> [options]\n")
    print("Commands:")
    print("  version              Print version and framework details")
    print("  test [path]          Run test suites with optional path filter")
    print("                       Options: --tag <tag>, --exclude-tag <tag>, --pattern <glob>, --allow-static")
    print("  property [target]    Run property-based invariant checks")
    print("                       Options: --target <file.nox>, --config <cfg.json>, --seed <int>, --cases <int>")
    print("  fuzz [target]        Run mutation fuzzer on user or sample target")
    print("                       Options: --target <file.nox>, --config <cfg.json>, --seed <int>, --max-cases <int>")
    print("  replay <file>        Replay and reproduce a saved failure artifact JSON")
    print("                       Options: --target <file.nox>")
    print("  contract [spec]      Validate API contracts against handler target, OpenAPI spec, or live URL")
    print("                       Options: --target <file.nox>, --spec <openapi.json>, --url <url>, --base-url <origin>, --allow-network")
    print("  load [scenario]      Run bounded load test scenario against user target or authorized URL")
    print("                       Options: --target <file.nox>, --url <url>, --allow-network, --vus <int>, --duration <int>, --requests <int>")
    print("  report [dir]         Inspect test result artifacts and export summaries")
    print("  help                 Show this help message")

def parse_flag_str(flag_name: str, default_val: str) -> str:
    count: int = nox.os.arg_count()
    i: int = 1
    while i < count:
        a: str = nox.os.arg(i)
        if a == flag_name and (i + 1) < count:
            return nox.os.arg(i + 1)
        elif nox.strings.starts_with(a, flag_name + "="):
            return nox.strings.replace(a, flag_name + "=", "")
        i = i + 1
    return default_val

def parse_flag_int(flag_name: str, default_val: int) -> int:
    count: int = nox.os.arg_count()
    i: int = 1
    while i < count:
        a: str = nox.os.arg(i)
        if a == flag_name and (i + 1) < count:
            val_str: str = nox.os.arg(i + 1)
            try:
                return int(val_str)
            except Exception as e:
                return default_val
        elif nox.strings.starts_with(a, flag_name + "="):
            val_str2: str = nox.strings.replace(a, flag_name + "=", "")
            try:
                return int(val_str2)
            except Exception as e:
                return default_val
        i = i + 1
    return default_val

def cmd_version() -> None:
    print(quartz.framework_info())

def sample_list_invariant(xs: list[int]) -> bool:
    rev: list[int] = []
    i: int = len(xs)
    while i > 0:
        i = i - 1
        rev.append(xs[i])
    rev2: list[int] = []
    j: int = len(rev)
    while j > 0:
        j = j - 1
        rev2.append(rev[j])
    if len(xs) != len(rev2):
        return False
    k: int = 0
    while k < len(xs):
        if xs[k] != rev2[k]:
            return False
        k = k + 1
    return True

def build_cli_registry() -> PropertyRegistry:
    reg: PropertyRegistry = PropertyRegistry()
    reg.register_list_int("cli_property_check", ListIntGen(0, 15, IntGen(-100, 100, True)), sample_list_invariant)
    return reg

def has_flag(flag_name: str) -> bool:
    count: int = nox.os.arg_count()
    i: int = 1
    while i < count:
        a: str = nox.os.arg(i)
        if a == flag_name or a == flag_name + "=true" or a == flag_name + "=1":
            return True
        i = i + 1
    return False

def load_cli_config_doc() -> JsonValue | None:
    cfg_path: str = parse_flag_str("--config", "")
    if len(cfg_path) == 0:
        return None
    if not nox.fs.exists(cfg_path):
        print("Error: config file not found: " + cfg_path)
        nox.os.exit(2)
        return None
    try:
        raw: str = nox.fs.read_to_string(cfg_path)
        return nox.json.parse(raw)
    except Exception as e:
        print("Error parsing CLI config JSON (" + cfg_path + "): " + str(e))
        nox.os.exit(2)
        return None

def cfg_str(doc: JsonValue | None, key: str, fallback: str) -> str:
    if doc == None:
        return fallback
    try:
        if json_has_key(doc, key):
            return json_get_key(doc, key).s
    except Exception as e:
        pass
    return fallback

def cfg_int(doc: JsonValue | None, key: str, fallback: int) -> int:
    if doc == None:
        return fallback
    try:
        if json_has_key(doc, key):
            return int(json_get_key(doc, key).n)
    except Exception as e:
        pass
    return fallback

def cfg_bool(doc: JsonValue | None, key: str, fallback: bool) -> bool:
    if doc == None:
        return fallback
    try:
        if json_has_key(doc, key):
            return json_get_key(doc, key).b
    except Exception as e:
        pass
    return fallback

def execute_user_target_file(target_file: str, extra_args: list[str]) -> None:
    if not nox.fs.exists(target_file):
        print("Error: target file not found: " + target_file)
        nox.os.exit(2)
        return
    env_bin: str = find_env_binary()
    bins: list[str] = candidate_noxc_bins()
    b_i: int = 0
    while b_i < len(bins):
        cmd_u: Command = build_noxc_command(env_bin, bins[b_i])
        cmd_u.arg("run")
        cmd_u.arg(target_file)
        if len(extra_args) > 0:
            cmd_u.arg("--")
            ai: int = 0
            while ai < len(extra_args):
                cmd_u.arg(extra_args[ai])
                ai = ai + 1
        try:
            out_u: Output = cmd_u.run()
            if len(out_u.stdout) > 0:
                print(out_u.stdout)
            if out_u.success():
                return
            elif not is_binary_not_found(out_u.stderr, out_u.status):
                if len(out_u.stderr) > 0:
                    print(out_u.stderr)
                nox.os.exit(out_u.status)
                return
        except Exception as e:
            pass
        b_i = b_i + 1
    print("Error: Could not locate 'noxc' to run user target: " + target_file)
    nox.os.exit(1)

def resolve_target_flag_or_positional(cfg: JsonValue | None) -> str:
    t: str = parse_flag_str("--target", "")
    if len(t) == 0:
        t = parse_flag_str("--file", "")
    if len(t) == 0 and nox.os.arg_count() >= 3:
        pos: str = nox.os.arg(2)
        if (not nox.strings.starts_with(pos, "-")) and nox.strings.ends_with(pos, ".nox"):
            t = pos
    if len(t) == 0:
        t = cfg_str(cfg, "target", "")
    return t

def cmd_property() -> None:
    cfg_doc: JsonValue | None = load_cli_config_doc()
    seed: int = parse_flag_int("--seed", cfg_int(cfg_doc, "seed", 42))
    cases: int = parse_flag_int("--cases", cfg_int(cfg_doc, "cases", 100))
    format_opt: str = parse_flag_str("--format", cfg_str(cfg_doc, "format", "summary"))
    out_opt: str = parse_flag_str("--out", cfg_str(cfg_doc, "out", ""))
    target_file: str = resolve_target_flag_or_positional(cfg_doc)

    if len(target_file) > 0:
        if format_opt != "json":
            print("Running Quartz User Property Target: " + target_file)
        fwd: list[str] = ["--seed", str(seed), "--cases", str(cases), "--format", format_opt]
        if len(out_opt) > 0:
            fwd.append("--out")
            fwd.append(out_opt)
        execute_user_target_file(target_file, fwd)
        return

    if format_opt != "json":
        print("Running Quartz Property Invariant Check (built-in demo target; pass --target <file.nox> for custom targets)...")
        print("Config: seed=" + str(seed) + ", cases=" + str(cases))

    item_gen: IntGen = IntGen(-100, 100, True)
    gen: ListIntGen = ListIntGen(0, 15, item_gen)
    cfg: PropertyConfig = PropertyConfig(cases, 10, seed, 5000)
    res: PropertyResult = run_list_int_property("cli_property_check", cfg, gen, sample_list_invariant)

    if format_opt == "json":
        json_str: str = res.to_json()
        if len(out_opt) > 0:
            nox.fs.write_string(out_opt, json_str)
            print("Wrote property JSON report to: " + out_opt)
        else:
            print(json_str)
        if not res.is_passed():
            nox.os.exit(1)
        return

    print("Result Status: " + res.status)
    print("Cases Executed: " + str(res.cases_executed))
    if res.status == "PASS":
        print("Success: Property preserved across all cases.")
    else:
        print("Failure detected! Shrunk counterexample: " + res.shrunk_counterexample)
        nox.os.exit(1)

def cmd_fuzz() -> None:
    cfg_doc: JsonValue | None = load_cli_config_doc()
    seed: int = parse_flag_int("--seed", cfg_int(cfg_doc, "seed", 1337))
    max_cases: int = parse_flag_int("--max-cases", cfg_int(cfg_doc, "max_cases", 100))
    corpus_dir: str = parse_flag_str("--corpus-dir", cfg_str(cfg_doc, "corpus_dir", "fixtures/corpus"))
    target_file: str = resolve_target_flag_or_positional(cfg_doc)

    if len(target_file) > 0:
        print("Running Quartz User Fuzz Target: " + target_file)
        fwd: list[str] = ["--seed", str(seed), "--max-cases", str(max_cases), "--corpus-dir", corpus_dir]
        execute_user_target_file(target_file, fwd)
        return

    print("Running Quartz Mutation Fuzzer (built-in demo target; pass --target <file.nox> for custom targets)...")
    print("Config: seed=" + str(seed) + ", max_cases=" + str(max_cases))

    def sample_parser_target(data: str) -> None:
        if nox.strings.contains(data, "MAGIC_CRASH_999"):
            assert False, "crash triggered by target payload"

    cm: CorpusManager = CorpusManager("cli_fuzz_target", corpus_dir, default_corpus_config())
    initial_seeds: list[str] = ["hello world", "test input 123", "data: {\"val\": 42}"]
    summary: FuzzSummary = run_fuzz("cli_fuzz_target", sample_parser_target, initial_seeds, max_cases, seed, cm, 256)

    print("Fuzzing Completed in " + str(summary.duration_ms) + " ms")
    print("Cases Executed: " + str(summary.total_cases))
    print("Crashes Found: " + str(summary.crashes_found))

def cmd_load() -> None:
    cfg_doc: JsonValue | None = load_cli_config_doc()
    vus: int = parse_flag_int("--vus", cfg_int(cfg_doc, "vus", 2))
    dur: int = parse_flag_int("--duration", cfg_int(cfg_doc, "duration", 2))
    reqs: int = parse_flag_int("--requests", cfg_int(cfg_doc, "requests", 20))
    format_opt: str = parse_flag_str("--format", cfg_str(cfg_doc, "format", "summary"))
    out_opt: str = parse_flag_str("--out", cfg_str(cfg_doc, "out", ""))
    target_file: str = resolve_target_flag_or_positional(cfg_doc)

    if len(target_file) > 0:
        if format_opt != "json":
            print("Running Quartz User Load Target: " + target_file)
        fwd: list[str] = ["--vus", str(vus), "--duration", str(dur), "--requests", str(reqs), "--format", format_opt]
        if len(out_opt) > 0:
            fwd.append("--out")
            fwd.append(out_opt)
        execute_user_target_file(target_file, fwd)
        return

    target_url: str = parse_flag_str("--url", cfg_str(cfg_doc, "url", ""))
    allow_net: bool = has_flag("--allow-network") or cfg_bool(cfg_doc, "allow_network", False)
    auth_target: str = parse_flag_str("--authorized-target", cfg_str(cfg_doc, "authorized_target", ""))
    method_opt: str = nox.strings.upper(parse_flag_str("--method", cfg_str(cfg_doc, "method", "GET")))
    body_opt: str = parse_flag_str("--body", cfg_str(cfg_doc, "body", ""))

    workload: WorkloadConfig = closed_workload("cli_load_scenario", vus, dur, reqs)
    safety: SafetyLimits = default_safety_limits()
    thresholds: list[Threshold] = [
        Threshold("p95_latency_ms", "<=", 250.0),
        Threshold("error_rate", "<=", 0.05)
    ]

    summary: LoadTestSummary = LoadTestSummary("empty", LoadMetrics(), [], 0, False, True, "uninitialized", [])
    if len(target_url) > 0:
        policy: NetworkPolicy = authorized_network_policy(auth_target) if len(auth_target) > 0 else (loopback_network_policy() if allow_net else default_network_policy())
        try:
            parsed_u: ParsedUrl = validate_network_target(target_url, policy)
            if format_opt != "json":
                print("Running Quartz Network Load Test against: " + target_url)
                print("Config: vus=" + str(vus) + ", duration=" + str(dur) + "s, requests=" + str(reqs))
            req_net: HttpRequest = build_request(method_opt, parsed_u.path, body_opt, empty_headers())
            summary = run_network_load_test(workload, req_net, parsed_u.origin, policy, thresholds, safety)
        except NetworkSafetyError as ne:
            print("Error: Network load target blocked by safety policy: " + str(ne))
            nox.os.exit(2)
            return
    else:
        if format_opt != "json":
            print("Running Quartz Bounded Load Test (built-in task; pass --url <url> --allow-network or --target <file.nox> for custom workloads)...")
            print("Config: vus=" + str(vus) + ", duration=" + str(dur) + "s, requests=" + str(reqs))

        def dummy_task(case_idx: int) -> bool:
            return True

        summary = run_task_workload(workload, dummy_task, thresholds, safety)

    if format_opt == "json":
        json_str: str = summary.to_json()
        if len(out_opt) > 0:
            nox.fs.write_string(out_opt, json_str)
            print("Wrote load test JSON summary to: " + out_opt)
        else:
            print(json_str)
        if not summary.all_passed:
            nox.os.exit(1)
        return
    elif format_opt == "html":
        html_str: str = format_html_load_report("Quartz Load Scenario: " + workload.name, summary)
        if len(out_opt) > 0:
            write_html_report(out_opt, html_str)
            print("Wrote load test HTML report to: " + out_opt)
        else:
            print(html_str)
        if not summary.all_passed:
            nox.os.exit(1)
        return

    print("Completed Requests: " + str(summary.metrics.completed))
    print("Throughput: " + str(summary.metrics.throughput_rps(summary.total_duration_ms)) + " req/s")
    print("Mean Latency: " + str(summary.metrics.mean_latency_us()) + " us")
    print("p50 Latency: " + str(summary.metrics.p50()) + " ms (" + str(summary.metrics.p50_us()) + " us)")
    print("p95 Latency: " + str(summary.metrics.p95()) + " ms (" + str(summary.metrics.p95_us()) + " us)")
    print("Peak Active VUs: " + str(summary.metrics.peak_active_vus) + " | Peak Overlapping Executions: " + str(summary.metrics.peak_overlapping_executions))
    print("Thresholds Passed: " + str(summary.all_passed))
    if not summary.all_passed:
        nox.os.exit(1)

def cmd_replay() -> None:
    if nox.os.arg_count() < 3:
        print("Error: replay command requires a target failure artifact file path.")
        print("Usage: quartz replay <path/to/artifact.json>")
        nox.os.exit(2)
        return
    path: str = nox.os.arg(2)
    print("Loading failure artifact from: " + path)
    if not nox.fs.exists(path):
        print("Error: artifact file not found: " + path)
        nox.os.exit(2)
        return
    content: str = nox.fs.read_to_string(path)
    try:
        artifact: JsonValue = nox.json.parse(content)
        test_id_node: JsonValue = json_get_key(artifact, "test_id")
        seed_node: JsonValue = json_get_key(artifact, "seed")
        
        case_idx: int = 0
        if json_has_key(artifact, "failing_case_index"):
            case_node: JsonValue = json_get_key(artifact, "failing_case_index")
            case_idx = int(case_node.n)
        elif json_has_key(artifact, "failing_case"):
            case_node2: JsonValue = json_get_key(artifact, "failing_case")
            case_idx = int(case_node2.n)

        test_id: str = test_id_node.s
        seed_val: int = int(seed_node.n)

        print("Failure Artifact Replay:")
        print("  Test ID: " + test_id)
        print("  Seed: " + str(seed_val) + " | Case Index: " + str(case_idx))

        orig_str: str = ""
        if json_has_key(artifact, "original_counterexample"):
            orig_node: JsonValue = json_get_key(artifact, "original_counterexample")
            orig_str = orig_node.s
            print("  Original counterexample: " + orig_str)
        elif json_has_key(artifact, "original"):
            orig_node2: JsonValue = json_get_key(artifact, "original")
            orig_str = orig_node2.s
            print("  Original counterexample: " + orig_str)

        if json_has_key(artifact, "shrunk_counterexample"):
            sc_node: JsonValue = json_get_key(artifact, "shrunk_counterexample")
            print("  Shrunk counterexample: " + sc_node.s)
        elif json_has_key(artifact, "shrunk"):
            sc_node2: JsonValue = json_get_key(artifact, "shrunk")
            print("  Shrunk counterexample: " + sc_node2.s)

        if len(orig_str) == 0:
            print("Error: failure artifact missing 'original' or 'original_counterexample' field.")
            nox.os.exit(1)
            return

        # Support external user-project property replay via --target <file.nox> or artifact "target_file"
        target_file: str = parse_flag_str("--target", "")
        if len(target_file) == 0:
            target_file = parse_flag_str("--file", "")
        if len(target_file) == 0 and json_has_key(artifact, "target_file"):
            target_file = json_get_key(artifact, "target_file").s

        if len(target_file) > 0:
            if not nox.fs.exists(target_file):
                print("Error: replay target file not found: " + target_file)
                nox.os.exit(2)
                return
            env_bin: str = find_env_binary()
            bins: list[str] = candidate_noxc_bins()
            b_i: int = 0
            while b_i < len(bins):
                cmd_rep: Command = build_noxc_command(env_bin, bins[b_i])
                cmd_rep.arg("run")
                cmd_rep.arg(target_file)
                cmd_rep.arg("--")
                cmd_rep.arg("--replay")
                cmd_rep.arg(path)
                try:
                    out_rep: Output = cmd_rep.run()
                    if len(out_rep.stdout) > 0:
                        print(out_rep.stdout)
                    if out_rep.success():
                        return
                    elif not is_binary_not_found(out_rep.stderr, out_rep.status):
                        if len(out_rep.stderr) > 0:
                            print(out_rep.stderr)
                        nox.os.exit(out_rep.status)
                        return
                except Exception as e:
                    pass
                b_i = b_i + 1
            print("Error: Could not execute replay target file: " + target_file)
            nox.os.exit(1)
            return

        art_prng: str = ""
        if json_has_key(artifact, "prng_version"):
            art_prng = json_get_key(artifact, "prng_version").s
            print("  PRNG Version: " + art_prng)
        art_schema: str = ""
        if json_has_key(artifact, "generator_schema"):
            art_schema = json_get_key(artifact, "generator_schema").s
            if len(art_schema) > 0:
                print("  Generator Schema: " + art_schema)

        # Replay against the ORIGINAL registered generator + predicate and verify candidate == original_counterexample.
        registry: PropertyRegistry = build_cli_registry()
        v: ReplayVerification = registry.verify_replay(test_id, seed_val, case_idx, orig_str, art_prng, art_schema)
        if not v.found_in_registry:
            print("Error: test_id '" + test_id + "' is not registered in the CLI property registry (pass --target <file.nox> for custom project properties).")
            nox.os.exit(2)
            return
        if not v.prng_version_matches:
            print("Error: artifact prng_version '" + v.artifact_prng_version + "' does not match current PRNG version 'v" + str(PRNG_VERSION) + "'.")
            nox.os.exit(1)
            return
        if not v.generator_schema_matches:
            print("Error: artifact generator_schema '" + v.artifact_generator_schema + "' does not match registered generator schema '" + v.registered_generator_schema + "'.")
            nox.os.exit(1)
            return
        if not v.candidate_matches_artifact:
            print("Error: regenerated candidate '" + v.generated_candidate + "' does not match artifact original_counterexample '" + v.expected_counterexample + "'.")
            nox.os.exit(1)
            return
        if v.predicate_failed_again:
            print("  Regenerated candidate matches artifact: " + v.generated_candidate)
            print("  Replay executed: FAIL (original predicate violated again)")
            print("[REPLAY SUCCESS] Deterministic counterexample reproduction verified.")
        else:
            print("  Replay executed: PASS (original predicate now holds)")
            print("[REPLAY FAILED] Counterexample could not be reproduced from seed and case index.")
            nox.os.exit(1)
    except Exception as e:
        print("Error parsing failure artifact: " + str(e))
        nox.os.exit(1)

def cmd_contract() -> None:
    cfg_doc: JsonValue | None = load_cli_config_doc()
    target_file: str = parse_flag_str("--target", cfg_str(cfg_doc, "target", ""))
    spec_path: str = parse_flag_str("--spec", cfg_str(cfg_doc, "spec", ""))
    if len(spec_path) == 0 and nox.os.arg_count() >= 3:
        pos: str = nox.os.arg(2)
        if not nox.strings.starts_with(pos, "-"):
            if nox.strings.ends_with(pos, ".nox"):
                target_file = pos
            else:
                spec_path = pos

    if len(target_file) > 0:
        print("Running Quartz User Contract Target: " + target_file)
        execute_user_target_file(target_file, [])
        return

    base_url: str = parse_flag_str("--base-url", cfg_str(cfg_doc, "base_url", ""))
    live_url: str = parse_flag_str("--url", cfg_str(cfg_doc, "url", ""))
    allow_net: bool = has_flag("--allow-network") or cfg_bool(cfg_doc, "allow_network", False)
    auth_target: str = parse_flag_str("--authorized-target", cfg_str(cfg_doc, "authorized_target", ""))
    method_opt: str = nox.strings.upper(parse_flag_str("--method", cfg_str(cfg_doc, "method", "GET")))
    expected_status: int = parse_flag_int("--status", cfg_int(cfg_doc, "status", 200))

    if len(live_url) > 0:
        policy: NetworkPolicy = authorized_network_policy(auth_target) if len(auth_target) > 0 else (loopback_network_policy() if allow_net else default_network_policy())
        try:
            parsed_u: ParsedUrl = validate_network_target(live_url, policy)
            req_live: HttpRequest = build_request(method_opt, parsed_u.path, "", empty_headers())
            res_live: ContractCheckResult = run_network_contract_check(req_live, parsed_u.origin, policy, [expected_status], [], "", None)
            print("Contract URL: " + live_url)
            print("Contract Valid: " + str(res_live.is_valid))
            print("Status: " + str(res_live.status_code) + " in " + str(res_live.duration_ms) + " ms")
            if not res_live.is_valid:
                print("Contract check failed: " + res_live.error_summary())
                nox.os.exit(1)
            return
        except NetworkSafetyError as ne:
            print("Error: Contract URL blocked by safety policy: " + str(ne))
            nox.os.exit(2)
            return

    if len(spec_path) > 0:
        print("Loading contract specification: " + spec_path)
        if not nox.fs.exists(spec_path):
            print("Error: specification file not found: " + spec_path)
            nox.os.exit(2)
            return
        content: str = nox.fs.read_to_string(spec_path)
        try:
            doc: ParsedOpenApiDoc = parse_openapi_json(content)
            print("Successfully parsed OpenAPI: " + doc.title + " (v" + doc.version + ")")
            print("Extracted operations: " + str(len(doc.operations)))
            i: int = 0
            while i < len(doc.operations):
                op: ParsedOperation = doc.operations[i]
                print("  [" + op.method + "] " + op.path + " (Operation ID: " + op.operation_id + ")")
                i = i + 1

            if len(base_url) > 0:
                policy2: NetworkPolicy = authorized_network_policy(auth_target) if len(auth_target) > 0 else (loopback_network_policy() if allow_net else default_network_policy())
                try:
                    _p_base: ParsedUrl = validate_network_target(base_url, policy2)
                except NetworkSafetyError as ne2:
                    print("Error: Contract base URL blocked by safety policy: " + str(ne2))
                    nox.os.exit(2)
                    return

                verified: int = 0
                failed_ops: int = 0
                oi: int = 0
                while oi < len(doc.operations):
                    op2: ParsedOperation = doc.operations[oi]
                    if not nox.strings.contains(op2.path, "{"):
                        exp_codes: list[int] = []
                        exp_ct: str = ""
                        exp_schema: SchemaDescriptor | None = None
                        ri: int = 0
                        while ri < len(op2.responses):
                            rsp: ParsedResponseSpec = op2.responses[ri]
                            exp_codes.append(rsp.status_code)
                            if len(exp_ct) == 0 and len(rsp.content_type) > 0:
                                exp_ct = rsp.content_type
                            if exp_schema == None and rsp.schema != None:
                                exp_schema = rsp.schema
                            ri = ri + 1
                        if len(exp_codes) == 0:
                            exp_codes.append(200)
                        op_req: HttpRequest = build_request(op2.method, op2.path, "", empty_headers())
                        op_res: ContractCheckResult = run_network_contract_check(op_req, base_url, policy2, exp_codes, [], exp_ct, exp_schema)
                        verified = verified + 1
                        if not op_res.is_valid:
                            failed_ops = failed_ops + 1
                            print("  FAIL [" + op2.method + "] " + op2.path + ": " + op_res.error_summary())
                        else:
                            print("  PASS [" + op2.method + "] " + op2.path + " (" + str(op_res.status_code) + ")")
                    oi = oi + 1
                print("Verified live OpenAPI operations: " + str(verified) + ", failed: " + str(failed_ops))
                if failed_ops > 0:
                    nox.os.exit(1)
        except Exception as e:
            print("Failed to parse OpenAPI contract: " + str(e))
            nox.os.exit(1)
        return

    print("Running in-process API contract check against built-in demo endpoint (pass --spec, --url, or --target for user targets)...")
    sample_schema: SchemaDescriptor = schema_object([
        PropertyRule("healthy", schema_boolean()),
        PropertyRule("version", schema_string())
    ], ["healthy", "version"])

    def demo_handler(req: HttpRequest) -> HttpResponse:
        h: dict[str, str] = {"Content-Type": "application/json"}
        return HttpResponse(200, "{\"healthy\": true, \"version\": \"" + quartz.version() + "\"}", h)

    req: HttpRequest = build_request("GET", "/health", "", empty_headers())
    tc: ContractTestCase = ContractTestCase("demo_health_check", req, [200], ["Content-Type"], "application/json", sample_schema)
    check: ContractCheckResult = tc.run_on_handler(demo_handler)
    print("Contract Valid: " + str(check.is_valid))
    print("Status: " + str(check.status_code) + " in " + str(check.duration_ms) + " ms")
    if check.is_valid:
        print("Contract verified successfully.")
    else:
        print("Contract check failed: " + check.error_summary())
        nox.os.exit(1)

def find_env_binary() -> str:
    env_candidates: list[str] = [
        "/usr/bin/env",
        "/bin/env",
        "C:\\Program Files\\Git\\usr\\bin\\env.exe",
        "C:/Program Files/Git/usr/bin/env.exe"
    ]
    i: int = 0
    while i < len(env_candidates):
        if nox.fs.exists(env_candidates[i]):
            return env_candidates[i]
        i = i + 1
    return ""

def to_msys_path_list(win_path: str) -> str:
    if not nox.strings.contains(win_path, ";"):
        return win_path
    parts: list[str] = nox.strings.split(win_path, ";")
    converted: list[str] = []
    i: int = 0
    while i < len(parts):
        p: str = nox.strings.trim(parts[i])
        if len(p) > 0:
            p = nox.strings.replace(p, "\\", "/")
            if len(p) >= 2 and p[1:2] == ":":
                drive: str = nox.strings.lower(p[0:1])
                p = "/" + drive + p[2:len(p)]
            converted.append(p)
        i = i + 1
    return nox.strings.join(converted, ":")

def attach_parent_env(cmd: Command, is_msys_env: bool) -> None:
    path_val: str = ""
    try:
        path_val = nox.os.getenv("PATH")
    except Exception as e:
        path_val = ""
    if len(path_val) == 0:
        try:
            path_val = nox.os.getenv("Path")
        except Exception as e2:
            path_val = ""
    if len(path_val) > 0:
        if is_msys_env:
            cmd.arg("PATH=" + to_msys_path_list(path_val))
        else:
            cmd.arg("PATH=" + path_val)

    env_keys: list[str] = ["HOME", "USERPROFILE", "TEMP", "TMP", "TMPDIR", "SystemRoot", "SYSTEMROOT", "LOCALAPPDATA", "APPDATA", "PATHEXT"]
    i: int = 0
    while i < len(env_keys):
        k: str = env_keys[i]
        try:
            v: str = nox.os.getenv(k)
            if len(v) > 0:
                cmd.arg(k + "=" + v)
        except Exception as e:
            pass
        i = i + 1

def build_noxc_command(env_bin: str, noxc_bin: str) -> Command:
    if len(env_bin) > 0:
        cmd: Command = Command(env_bin)
        is_msys: bool = nox.strings.contains(env_bin, "Git") or nox.strings.contains(env_bin, ".exe")
        attach_parent_env(cmd, is_msys)
        cmd.arg(noxc_bin)
        return cmd
    return Command(noxc_bin)

def is_binary_not_found(err: str, status: int) -> bool:
    if status == 127:
        return True
    if len(err) == 0:
        return True
    return nox.strings.contains(err, "FileNotFound") or nox.strings.contains(err, "not found") or nox.strings.contains(err, "No such file")

def candidate_noxc_bins() -> list[str]:
    candidate_bins: list[str] = []
    try:
        user_prof: str = nox.os.getenv("USERPROFILE")
        candidate_bins.append(user_prof + "\\.nox-lang\\bin\\noxc.exe")
        candidate_bins.append(user_prof + "/.nox-lang/bin/noxc.exe")
    except Exception as e:
        pass

    try:
        home_dir: str = nox.os.getenv("HOME")
        candidate_bins.append(home_dir + "/.nox-lang/bin/noxc")
    except Exception as e:
        pass

    candidate_bins.append("/home/runner/.nox-lang/bin/noxc")
    candidate_bins.append("/Users/runner/.nox-lang/bin/noxc")
    candidate_bins.append("/root/.nox-lang/bin/noxc")
    candidate_bins.append("/usr/local/bin/noxc")
    candidate_bins.append("/usr/bin/noxc")
    candidate_bins.append("noxc.exe")
    candidate_bins.append("noxc")
    return candidate_bins

def collect_tag_targets(target_path: str, file_pattern: str = "") -> list[str]:
    targets: list[str] = []
    if nox.fs.is_file(target_path):
        if nox.strings.ends_with(target_path, ".nox"):
            if len(file_pattern) == 0 or nox.fnmatch.fnmatch(nox.path.basename(target_path), file_pattern) or nox.fnmatch.fnmatch(target_path, file_pattern):
                targets.append(target_path)
        return targets
    if nox.fs.is_dir(target_path):
        matched: list[str] = nox.glob.glob("**/*_test.nox", target_path, True)
        if len(matched) == 0:
            matched = nox.glob.glob("**/*.nox", target_path, True)
        i: int = 0
        while i < len(matched):
            rel: str = matched[i]
            if nox.strings.ends_with(rel, ".nox"):
                full_p: str = nox.path.join(target_path, rel)
                if len(file_pattern) == 0 or nox.fnmatch.fnmatch(nox.path.basename(rel), file_pattern) or nox.fnmatch.fnmatch(rel, file_pattern) or nox.fnmatch.fnmatch(full_p, file_pattern):
                    targets.append(full_p)
            i = i + 1
    return targets

def cmd_test() -> None:
    target_path: str = "quartz.nox"
    if nox.os.arg_count() >= 3 and not nox.strings.starts_with(nox.os.arg(2), "-"):
        target_path = nox.os.arg(2)

    tag_filter: str = parse_flag_str("--tag", "")
    exclude_tag: str = parse_flag_str("--exclude-tag", "")
    file_pattern: str = parse_flag_str("--pattern", "")

    print("Executing Quartz test runner on: " + target_path)
    if len(tag_filter) > 0:
        print("Tag filter active: include [" + tag_filter + "]")
    if len(exclude_tag) > 0:
        print("Tag filter active: exclude [" + exclude_tag + "]")
    if len(file_pattern) > 0:
        print("Glob filter active: [" + file_pattern + "]")
    try:
        candidate_bins: list[str] = candidate_noxc_bins()
        use_tag_mode: bool = len(tag_filter) > 0 or len(exclude_tag) > 0 or len(file_pattern) > 0
        tag_files: list[str] = []
        if use_tag_mode:
            tag_files = collect_tag_targets(target_path, file_pattern)
            if len(tag_files) == 0:
                print("Error: No .nox test files found matching filters at: " + target_path)
                nox.os.exit(2)
                return

        # Step 1: Static type check verification
        check_target: str = target_path
        if use_tag_mode and len(tag_files) > 0:
            check_target = tag_files[0]

        chk_passed: bool = False
        chk_not_found: bool = True
        err_msg: str = ""
        working_bin: str = ""

        c_i: int = 0
        while c_i < len(candidate_bins):
            bin_name: str = candidate_bins[c_i]
            check_cmd: Command = Command(bin_name)
            check_cmd.arg("check")
            check_cmd.arg(check_target)
            try:
                out_chk: Output = check_cmd.run()
                if out_chk.success():
                    chk_passed = True
                    chk_not_found = False
                    working_bin = bin_name
                    break
                elif not is_binary_not_found(out_chk.stderr, out_chk.status):
                    # Real type error from compiler
                    chk_not_found = False
                    err_msg = out_chk.stderr
                    break
            except Exception as e:
                pass
            c_i = c_i + 1

        if chk_passed:
            print("Type check passed: " + target_path)
        elif not chk_not_found:
            print("Type check failed for " + target_path + ":")
            print(err_msg)
            nox.os.exit(1)
            return
        else:
            print("Error: Could not locate a working 'noxc' compiler binary to verify " + target_path)
            nox.os.exit(1)
            return

        # Step 2: Dynamic test execution with parent environment forwarded via env_bin
        env_bin: str = find_env_binary()
        if use_tag_mode:
            f_idx: int = 0
            while f_idx < len(tag_files):
                tf: str = tag_files[f_idx]
                cmd_t: Command = build_noxc_command(env_bin, working_bin)
                cmd_t.arg("run")
                cmd_t.arg(tf)
                cmd_t.arg("--")
                if len(tag_filter) > 0:
                    cmd_t.arg("--tag")
                    cmd_t.arg(tag_filter)
                if len(exclude_tag) > 0:
                    cmd_t.arg("--exclude-tag")
                    cmd_t.arg(exclude_tag)
                out_t: Output = cmd_t.run()
                if len(out_t.stdout) > 0:
                    print(out_t.stdout)
                if not out_t.success():
                    if len(out_t.stderr) > 0:
                        print(out_t.stderr)
                    nox.os.exit(1)
                    return
                f_idx = f_idx + 1
            print("All test suites executed successfully.")
            return

        cmd_run: Command = build_noxc_command(env_bin, working_bin)
        cmd_run.arg("test")
        cmd_run.arg(target_path)
        out_run: Output = cmd_run.run()
        if out_run.success():
            if len(out_run.stdout) > 0:
                print(out_run.stdout)
            print("All test suites executed successfully.")
            return
        elif not is_binary_not_found(out_run.stderr, out_run.status):
            if len(out_run.stdout) > 0:
                print(out_run.stdout)
            if len(out_run.stderr) > 0:
                print(out_run.stderr)
            nox.os.exit(1)
            return

        allow_static: bool = (parse_flag_str("--allow-static-only", "") == "true") or (parse_flag_str("--allow-static", "") == "true")
        if allow_static:
            print("Note: Child process environment lacks backend compiler PATH; static check verified successfully.")
            print("To run the test executable directly, execute 'noxc test " + target_path + "' in the host shell.")
        else:
            print("Error: Dynamic test execution failed or backend compiler environment unavailable. Use --allow-static to permit static type checking only.")
            nox.os.exit(1)
    except Exception as e:
        print("Note: Process execution encountered: " + str(e))
        nox.os.exit(1)

def cmd_report() -> None:
    report_dir: str = "artifacts"
    if nox.os.arg_count() >= 3 and not nox.strings.starts_with(nox.os.arg(2), "-"):
        report_dir = nox.os.arg(2)

    format_opt: str = parse_flag_str("--format", "summary")
    out_opt: str = parse_flag_str("--out", "")

    if not nox.fs.exists(report_dir):
        if format_opt == "json":
            empty_json: str = "{\"artifacts_dir\":\"" + escape_json(report_dir) + "\",\"exists\":false,\"total_files\":0,\"json_count\":0,\"jsonl_count\":0,\"xml_count\":0}"
            print(empty_json)
        else:
            print("=== Quartz Test Artifacts & Report Summary ===")
            print("Directory: " + report_dir)
            print("Directory does not exist or has not generated artifacts yet.")
        return

    files: list[str] = nox.fs.read_dir(report_dir)
    total_files: int = len(files)
    json_count: int = 0
    jsonl_count: int = 0
    xml_count: int = 0
    i: int = 0
    while i < total_files:
        fn: str = files[i]
        if nox.strings.ends_with(fn, ".jsonl"):
            jsonl_count = jsonl_count + 1
        elif nox.strings.ends_with(fn, ".json"):
            json_count = json_count + 1
        elif nox.strings.ends_with(fn, ".xml"):
            xml_count = xml_count + 1
        i = i + 1

    if format_opt == "json":
        rep_json: str = "{\"artifacts_dir\":\"" + escape_json(report_dir) + "\",\"exists\":true,\"total_files\":" + str(total_files) + ",\"json_count\":" + str(json_count) + ",\"jsonl_count\":" + str(jsonl_count) + ",\"xml_count\":" + str(xml_count) + "}"
        if len(out_opt) > 0:
            nox.fs.write_string(out_opt, rep_json)
            print("Wrote report JSON summary to: " + out_opt)
        else:
            print(rep_json)
        return
    elif format_opt == "html":
        summ: RunSummary = RunSummary()
        summ.total = total_files
        summ.passed = json_count + jsonl_count + xml_count
        rep_html: str = format_html_test_report("Quartz Test Artifacts Summary (" + report_dir + ")", summ, "report-inspection", "noxc", "default")
        if len(out_opt) > 0:
            write_html_report(out_opt, rep_html)
            print("Wrote report HTML summary to: " + out_opt)
        else:
            print(rep_html)
        return

    print("=== Quartz Test Artifacts & Report Summary ===")
    print("Directory: " + report_dir)
    print("Total Artifact Files: " + str(total_files))
    print("JSON Summaries: " + str(json_count))
    print("Streaming JSONL Logs: " + str(jsonl_count))
    print("JUnit XML Reports: " + str(xml_count))
    print("Inspection complete.")

def main_cli() -> None:
    count: int = nox.os.arg_count()
    if count <= 1:
        print_usage()
        nox.os.exit(0)

    subcmd: str = nox.os.arg(1)
    if subcmd == "version" or subcmd == "--version" or subcmd == "-v":
        cmd_version()
    elif subcmd == "help" or subcmd == "--help" or subcmd == "-h":
        print_usage()
    elif subcmd == "property":
        cmd_property()
    elif subcmd == "fuzz":
        cmd_fuzz()
    elif subcmd == "load":
        cmd_load()
    elif subcmd == "replay":
        cmd_replay()
    elif subcmd == "contract":
        cmd_contract()
    elif subcmd == "test":
        cmd_test()
    elif subcmd == "report":
        cmd_report()
    else:
        print("Unknown command: '" + subcmd + "'. Run 'quartz help' for available commands.")
        nox.os.exit(2)

main_cli()
