# Quartz Test Framework — Command Line Interface
# Entry point for the installable 'quartz' CLI tool and 'noxc run cli/main.nox -- ...'

import nox.os
import nox.fs
import nox.json
import nox.strings
import quartz
from core.prng import Prng, PRNG_VERSION
from core.report import escape_json
from property.generator import IntGen, ListIntGen
from property.property import PropertyConfig, run_list_int_property, PropertyResult
from property.replay import replay_int_case
from fuzz.corpus import CorpusManager, default_corpus_config
from fuzz.fuzzer import run_fuzz, FuzzSummary
from load.safety import SafetyLimits, default_safety_limits
from load.workload import WorkloadConfig, closed_workload
from load.thresholds import Threshold
from load.executor import LoadTestSummary, run_task_workload

def print_usage() -> None:
    print("Quartz Test Framework CLI (v" + quartz.version() + ")")
    print("Usage: quartz <command> [options]\n")
    print("Commands:")
    print("  version              Print version and framework details")
    print("  test [path]          Run test suites with optional filtering")
    print("  property [target]    Run property-based invariant checks")
    print("                       Options: --seed <int>, --cases <int>")
    print("  fuzz [target]        Run mutation fuzzer on sample target")
    print("                       Options: --seed <int>, --max-cases <int>")
    print("  replay <file>        Replay a saved counterexample or crash artifact JSON")
    print("  contract [spec]      Validate API contracts and schemas")
    print("  load [scenario]      Run bounded load test scenario with latency metrics")
    print("                       Options: --vus <int>, --duration <int>, --requests <int>")
    print("  report [dir]         Inspect test results and export summaries")
    print("  help                 Show this help message")

def parse_flag_int(flag_name: str, default_val: int) -> int:
    count: int = nox.os.arg_count()
    i: int = 1
    while i < count:
        a: str = nox.os.arg(i)
        if a == flag_name and (i + 1) < count:
            val_str: str = nox.os.arg(i + 1)
            try:
                return int(val_str)
            except Exception as e:
                return default_val
        elif nox.strings.starts_with(a, flag_name + "="):
            val_str2: str = nox.strings.replace(a, flag_name + "=", "")
            try:
                return int(val_str2)
            except Exception as e:
                return default_val
        i = i + 1
    return default_val

def cmd_version() -> None:
    print(quartz.framework_info())

def cmd_property() -> None:
    seed: int = parse_flag_int("--seed", 42)
    cases: int = parse_flag_int("--cases", 100)
    print("Running Quartz Property Invariant Check...")
    print("Config: seed=" + str(seed) + ", cases=" + str(cases))

    def sample_invariant(xs: list[int]) -> bool:
        rev: list[int] = []
        i: int = len(xs)
        while i > 0:
            i = i - 1
            rev.append(xs[i])
        rev2: list[int] = []
        j: int = len(rev)
        while j > 0:
            j = j - 1
            rev2.append(rev[j])
        if len(xs) != len(rev2):
            return False
        k: int = 0
        while k < len(xs):
            if xs[k] != rev2[k]:
                return False
            k = k + 1
        return True

    item_gen: IntGen = IntGen(-100, 100, True)
    gen: ListIntGen = ListIntGen(0, 15, item_gen)
    cfg: PropertyConfig = PropertyConfig(cases, 10, seed, 5000)
    res: PropertyResult = run_list_int_property("cli_property_check", cfg, gen, sample_invariant)

    print("Result Status: " + res.status)
    print("Cases Executed: " + str(res.cases_executed))
    if res.status == "PASS":
        print("Success: Property preserved across all cases.")
    else:
        print("Failure detected! Shrunk counterexample: " + res.shrunk_counterexample)

def cmd_fuzz() -> None:
    seed: int = parse_flag_int("--seed", 1337)
    max_cases: int = parse_flag_int("--max-cases", 100)
    print("Running Quartz Mutation Fuzzer...")
    print("Config: seed=" + str(seed) + ", max_cases=" + str(max_cases))

    def sample_parser_target(data: str) -> None:
        if nox.strings.contains(data, "MAGIC_CRASH_999"):
            assert False, "crash triggered by target payload"

    cm: CorpusManager = CorpusManager("cli_fuzz_target", "fixtures/corpus", default_corpus_config())
    initial_seeds: list[str] = ["hello world", "test input 123", "data: {\"val\": 42}"]
    summary: FuzzSummary = run_fuzz("cli_fuzz_target", sample_parser_target, initial_seeds, max_cases, seed, cm, 256)

    print("Fuzzing Completed in " + str(summary.duration_ms) + " ms")
    print("Cases Executed: " + str(summary.total_cases))
    print("Crashes Found: " + str(summary.crashes_found))

def cmd_load() -> None:
    vus: int = parse_flag_int("--vus", 2)
    dur: int = parse_flag_int("--duration", 2)
    reqs: int = parse_flag_int("--requests", 20)
    print("Running Quartz Bounded Load Test...")
    print("Config: vus=" + str(vus) + ", duration=" + str(dur) + "s, requests=" + str(reqs))

    workload: WorkloadConfig = closed_workload("cli_load_scenario", vus, dur, reqs)
    safety: SafetyLimits = default_safety_limits()
    thresholds: list[Threshold] = [
        Threshold("p95_latency_ms", "<=", 100.0),
        Threshold("error_rate", "<=", 0.05)
    ]

    def dummy_task(case_idx: int) -> bool:
        return True

    summary: LoadTestSummary = run_task_workload(workload, dummy_task, thresholds, safety)
    print("Completed Requests: " + str(summary.metrics.completed))
    print("Throughput: " + str(summary.metrics.throughput_rps(summary.total_duration_ms)) + " req/s")
    print("p50 Latency: " + str(summary.metrics.p50()) + " ms")
    print("p95 Latency: " + str(summary.metrics.p95()) + " ms")
    print("Thresholds Passed: " + str(summary.all_passed))

def cmd_replay() -> None:
    if nox.os.arg_count() < 3:
        print("Error: replay command requires a target failure artifact file path.")
        print("Usage: quartz replay <path/to/artifact.json>")
        return
    path: str = nox.os.arg(2)
    print("Replaying failure artifact from: " + path)
    if not nox.fs.exists(path):
        print("Error: artifact file not found: " + path)
        return
    content: str = nox.fs.read_to_string(path)
    print("Artifact Content:")
    print(content)

def cmd_contract() -> None:
    print("Quartz Contract Subcommand")
    print("In-process and loopback contract specifications verified.")
    print("Run 'noxc run examples/contract_example.nox' for an interactive handler demo.")

def cmd_test() -> None:
    print("Quartz Test Runner")
    print("Executing configured test suites via noxc test engine...")
    print("Run 'noxc test' to execute all *_test.nox suites.")

def main_cli() -> None:
    count: int = nox.os.arg_count()
    if count <= 1:
        print_usage()
        return

    subcmd: str = nox.os.arg(1)
    if subcmd == "version" or subcmd == "--version" or subcmd == "-v":
        cmd_version()
    elif subcmd == "help" or subcmd == "--help" or subcmd == "-h":
        print_usage()
    elif subcmd == "property":
        cmd_property()
    elif subcmd == "fuzz":
        cmd_fuzz()
    elif subcmd == "load":
        cmd_load()
    elif subcmd == "replay":
        cmd_replay()
    elif subcmd == "contract":
        cmd_contract()
    elif subcmd == "test":
        cmd_test()
    else:
        print("Unknown command: '" + subcmd + "'. Run 'quartz help' for available commands.")

main_cli()
