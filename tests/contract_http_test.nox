# Quartz Contract — Authorized Network Transport & Safety Test Suite
import nox.http
from nox.http import HttpRequest
from core.assert import assert_true, assert_false, assert_eq_int, assert_eq_str, assert_contains_str
from contract.http_network import NetworkPolicy, default_network_policy, loopback_network_policy, authorized_network_policy
from contract.http_network import parse_url, ParsedUrl, is_loopback_host, classify_ip_safety, validate_resolved_ips, resolve_and_pin_ip, validate_network_target, validate_redirect_target
from contract.http_network import NetworkSafetyError, NetworkNotAllowedError, UnauthorizedTargetError
from contract.http_network import execute_network_request, NetworkExecutionResult, run_network_contract_check
from contract.http import build_request, empty_headers
from contract.types import ContractCheckResult

def test_url_parser() -> None:
    # 1. Standard HTTP with explicit port and path
    p1: ParsedUrl = parse_url("http://127.0.0.1:8080/api/v1/users")
    assert_eq_str(p1.scheme, "http", "scheme http")
    assert_eq_str(p1.host, "127.0.0.1", "host 127.0.0.1")
    assert_eq_int(p1.port, 8080, "port 8080")
    assert_eq_str(p1.path, "/api/v1/users", "path parsed")
    assert_eq_str(p1.origin, "http://127.0.0.1:8080", "origin parsed")

    # 2. HTTPS default port 443 without explicit port
    p2: ParsedUrl = parse_url("https://api.mycorp.internal/status")
    assert_eq_str(p2.scheme, "https", "scheme https")
    assert_eq_str(p2.host, "api.mycorp.internal", "host parsed")
    assert_eq_int(p2.port, 443, "default https port 443")
    assert_eq_str(p2.path, "/status", "path parsed")

    # 3. IPv6 bracketed loopback
    p3: ParsedUrl = parse_url("http://[::1]:9090/metrics")
    assert_eq_str(p3.scheme, "http", "scheme http")
    assert_eq_str(p3.host, "[::1]", "host [::1]")
    assert_eq_int(p3.port, 9090, "port 9090")

    # 4. Invalid scheme rejection
    threw_scheme: bool = False
    try:
        parse_url("ftp://127.0.0.1/file")
    except NetworkSafetyError as e:
        threw_scheme = True
    assert_true(threw_scheme, "ftp scheme must raise NetworkSafetyError")

def test_loopback_host_detector() -> None:
    assert_true(is_loopback_host("127.0.0.1"), "127.0.0.1 is loopback")
    assert_true(is_loopback_host("localhost"), "localhost is loopback")
    assert_true(is_loopback_host("::1"), "::1 is loopback")
    assert_true(is_loopback_host("[::1]"), "[::1] is loopback")
    assert_false(is_loopback_host("example.com"), "example.com is not loopback")
    assert_false(is_loopback_host("192.168.1.1"), "LAN IP is not loopback")
    assert_false(is_loopback_host("10.0.0.1"), "LAN IP is not loopback")

def test_default_network_disabled_safety_gate() -> None:
    # Default policy has allow_network = False
    policy: NetworkPolicy = default_network_policy()
    assert_false(policy.allow_network, "default policy has network strictly disabled")

    threw_not_allowed: bool = False
    try:
        validate_network_target("http://127.0.0.1:8080/test", policy)
    except NetworkNotAllowedError as e:
        threw_not_allowed = True
    assert_true(threw_not_allowed, "loopback request rejected when network disabled")

def test_remote_host_rejection_without_authorization() -> None:
    # Loopback policy has allow_network = True, but NO authorized_target
    policy: NetworkPolicy = loopback_network_policy()
    assert_true(policy.allow_network, "loopback policy allows network")

    # Permitted loopback target
    p_ok: ParsedUrl = validate_network_target("http://127.0.0.1:8000/health", policy)
    assert_eq_str(p_ok.host, "127.0.0.1", "loopback target validated")

    # Rejected remote target
    threw_unauthorized: bool = False
    try:
        validate_network_target("https://api.external.com/v1", policy)
    except UnauthorizedTargetError as e:
        threw_unauthorized = True
    assert_true(threw_unauthorized, "remote target must raise UnauthorizedTargetError without explicit authorization")

def test_authorized_remote_target_matching() -> None:
    auth_origin: str = "https://service.corp.internal:8443"
    policy: NetworkPolicy = authorized_network_policy(auth_origin)

    # 1. Matching target passes
    p_ok: ParsedUrl = validate_network_target("https://service.corp.internal:8443/orders", policy)
    assert_eq_str(p_ok.path, "/orders", "authorized remote path allowed")

    # 2. Scheme mismatch rejected
    threw_scheme: bool = False
    try:
        validate_network_target("http://service.corp.internal:8443/orders", policy)
    except UnauthorizedTargetError as e:
        threw_scheme = True
    assert_true(threw_scheme, "scheme mismatch must be rejected")

    # 3. Port mismatch rejected
    threw_port: bool = False
    try:
        validate_network_target("https://service.corp.internal:9999/orders", policy)
    except UnauthorizedTargetError as e:
        threw_port = True
    assert_true(threw_port, "port mismatch must be rejected")

    # 4. Host mismatch / phishing / spoof rejected
    threw_host: bool = False
    try:
        validate_network_target("https://evil-attacker.com:8443/orders", policy)
    except UnauthorizedTargetError as e:
        threw_host = True
    assert_true(threw_host, "evil host must be rejected")

def test_unreachable_transport_error_handling() -> None:
    # Request to a non-existent port on loopback with short timeout
    policy: NetworkPolicy = loopback_network_policy(100)
    req: HttpRequest = build_request("GET", "/unreachable", "", empty_headers())

    exec_res: NetworkExecutionResult = execute_network_request(req, "http://127.0.0.1:59999", policy)
    assert_false(exec_res.is_success, "unreachable server must report is_success=False")
    assert_true(len(exec_res.error_message) > 0, "error message populated on connection failure")

    # Contract check should gracefully return invalid result without throwing uncaught exceptions
    check: ContractCheckResult = run_network_contract_check(req, "http://127.0.0.1:59999", policy, [200], [], "", None)
    assert_false(check.is_valid, "contract check on failed connection must be invalid")
    assert_true(check.has_errors(), "contract check records error")

def test_ssrf_url_and_redirect_security() -> None:
    policy: NetworkPolicy = loopback_network_policy()

    # 1. Userinfo SSRF bypass pattern must be strictly rejected
    ssrf_urls: list[str] = [
        "http://localhost:123@remote.example/admin",
        "http://user:pass@127.0.0.1:8080/internal",
        "http://@localhost:8080/empty-user",
        "https://localhost\\@remote.example/",
        "http://127.0.0.1:notaport/bad",
        "http://127.0.0.1:0/zero-port",
        "http://127.0.0.1:70000/overflow-port",
        "http://[::1/unterminated",
        "http:///missing-host"
    ]
    ui: int = 0
    while ui < len(ssrf_urls):
        threw: bool = False
        try:
            validate_network_target(ssrf_urls[ui], policy)
        except NetworkSafetyError as e:
            threw = True
        assert_true(threw, "unsafe/SSRF URL must raise NetworkSafetyError: " + ssrf_urls[ui])
        ui = ui + 1

    # 2. Redirects disabled by default
    threw_redir_default: bool = False
    try:
        validate_redirect_target("http://127.0.0.1:8080/start", "http://127.0.0.1:8080/next", policy)
    except UnauthorizedTargetError as e:
        threw_redir_default = True
    assert_true(threw_redir_default, "redirects blocked by default")

    # 3. Redirect opt-in permits same-origin relative/loopback but still blocks unauthorized external targets
    redir_policy: NetworkPolicy = NetworkPolicy(True, "", 2000, 1048576, False, False, 0, 90000, True)
    ok_rel: ParsedUrl = validate_redirect_target("http://127.0.0.1:8080/a", "/b", redir_policy)
    assert_eq_str(ok_rel.host, "127.0.0.1", "same-origin relative redirect allowed when enabled")
    assert_eq_str(ok_rel.path, "/b", "relative redirect preserves path")

    threw_redir_ssrf: bool = False
    try:
        validate_redirect_target("http://127.0.0.1:8080/a", "http://169.254.169.254/latest/meta-data", redir_policy)
    except UnauthorizedTargetError as e:
        threw_redir_ssrf = True
    assert_true(threw_redir_ssrf, "redirect to unauthorized metadata IP rejected even when redirects enabled")

def test_nox_ip_ssrf_and_dns_pinning() -> None:
    # 1. IPv4-mapped IPv6 and NAT64 loopback detection + malformed octal/shorthand rejection
    assert_true(is_loopback_host("::ffff:127.0.0.1"), "::ffff:127.0.0.1 detected as loopback")
    assert_true(is_loopback_host("[::ffff:127.0.0.1]"), "[::ffff:127.0.0.1] detected as loopback")
    assert_true(is_loopback_host("64:ff9b::127.0.0.1"), "NAT64 loopback detected as loopback")
    assert_false(is_loopback_host("0177.0.0.1"), "octal IPv4 rejected as loopback")
    assert_false(is_loopback_host("127.1"), "shorthand IPv4 rejected as loopback")
    assert_false(is_loopback_host("::ffff:169.254.169.254"), "IPv4-mapped metadata not loopback")

    # 2. RFC 6890/4291 classification
    assert_eq_str(classify_ip_safety("169.254.169.254"), "metadata", "AWS/cloud metadata classified")
    assert_eq_str(classify_ip_safety("::ffff:169.254.169.254"), "metadata", "IPv4-mapped metadata classified")
    assert_eq_str(classify_ip_safety("10.0.0.1"), "private", "RFC1918 classified")
    assert_eq_str(classify_ip_safety("100.64.0.1"), "cgnat", "CGNAT RFC6598 classified")
    assert_eq_str(classify_ip_safety("93.184.216.34"), "global", "public IP classified global")

    # 3. Metadata IP blocked even before remote target matching
    meta_policy: NetworkPolicy = authorized_network_policy("http://169.254.169.254:80")
    threw_meta: bool = False
    try:
        validate_network_target("http://169.254.169.254/latest/meta-data", meta_policy)
    except UnauthorizedTargetError as _me:
        threw_meta = True
    assert_true(threw_meta, "metadata IP literal must be blocked")

    # 4. DNS rebinding / pinning negative tests
    rebinding_cases: list[str] = ["127.0.0.1", "169.254.169.254", "10.0.0.5", "::ffff:127.0.0.1"]
    ri: int = 0
    while ri < len(rebinding_cases):
        threw_rebind: bool = False
        try:
            validate_resolved_ips("api.example.com", [rebinding_cases[ri]], False)
        except UnauthorizedTargetError as _re:
            threw_rebind = True
        assert_true(threw_rebind, "DNS rebinding to non-global IP blocked: " + rebinding_cases[ri])
        ri = ri + 1

    # Localhost resolving to public IP rejected
    threw_lb_rebind: bool = False
    try:
        validate_resolved_ips("localhost", ["93.184.216.34"], True)
    except UnauthorizedTargetError as _lbe:
        threw_lb_rebind = True
    assert_true(threw_lb_rebind, "localhost resolving to non-loopback rejected")

    # Valid global DNS resolution returns canonical IP to pin
    pinned: str = validate_resolved_ips("api.example.com", ["93.184.216.34"], False)
    assert_eq_str(pinned, "93.184.216.34", "valid global IP pinned")

    # Localhost live DNS resolution pins to loopback IP
    lb_policy: NetworkPolicy = loopback_network_policy(1000)
    lb_pinned: str = resolve_and_pin_ip("localhost", lb_policy)
    assert_true(is_loopback_host(lb_pinned), "localhost pins to loopback IP")

    # 5. HTTPS -> HTTP downgrade redirect blocked when allow_downgrade=False
    auth_redir: NetworkPolicy = NetworkPolicy(True, "http://service.corp.internal:8443", 2000, 1048576, False, False, 0, 90000, True, True, "", False, False, False)
    threw_downgrade: bool = False
    try:
        validate_redirect_target("https://service.corp.internal:8443/login", "http://service.corp.internal:8443/plain", auth_redir)
    except UnauthorizedTargetError as _de:
        threw_downgrade = True
    assert_true(threw_downgrade, "HTTPS -> HTTP downgrade redirect blocked by default")

    # 6. Non-existent ca_file and use_safehttp fail cleanly on unreachable/untrusted endpoint
    ca_policy: NetworkPolicy = NetworkPolicy(True, "", 200, 1048576, False, False, 0, 90000, False, True, "/nonexistent/quartz-test-ca.pem", False, False, False)
    ca_res: NetworkExecutionResult = execute_network_request(build_request("GET", "/tls", "", empty_headers()), "https://127.0.0.1:59999", ca_policy)
    assert_false(ca_res.is_success, "unreadable/unreachable TLS request with ca_file must fail closed")

    safe_policy: NetworkPolicy = NetworkPolicy(True, "", 150, 1048576, False, False, 0, 90000, False, True, "", True, False, False)
    safe_res: NetworkExecutionResult = execute_network_request(build_request("GET", "/ping", "", empty_headers()), "http://127.0.0.1:59998", safe_policy)
    assert_false(safe_res.is_success, "use_safehttp request to closed loopback port fails cleanly")

def run_all_contract_http_tests() -> None:
    test_url_parser()
    test_loopback_host_detector()
    test_default_network_disabled_safety_gate()
    test_remote_host_rejection_without_authorization()
    test_authorized_remote_target_matching()
    test_unreachable_transport_error_handling()
    test_ssrf_url_and_redirect_security()
    test_nox_ip_ssrf_and_dns_pinning()
    print("quartz contract http test: ALL PASS")

run_all_contract_http_tests()
