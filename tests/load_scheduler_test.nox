def test_safety_limits_clamping() -> None:
    # 1. Values exceeding hard caps must be clamped down
    over_limits: SafetyLimits = SafetyLimits(1000, 3600, 50000, 1000, 99999)
    assert_eq_int(over_limits.virtual_users, HARD_CAP_VIRTUAL_USERS, "VU clamped to hard cap")
    assert_eq_int(over_limits.duration_seconds, HARD_CAP_DURATION_SECONDS, "duration clamped to hard cap")
    assert_eq_int(over_limits.rate_rps, HARD_CAP_RATE_RPS, "rate clamped to hard cap")

    # 2. Values below 1 must be normalized to 1
    under_limits: SafetyLimits = SafetyLimits(0, 0, 0, 0, 0)
    assert_eq_int(under_limits.virtual_users, 1, "VU floor 1")
    assert_eq_int(under_limits.duration_seconds, 1, "duration floor 1")

def test_load_target_validation() -> None:
    # Loopback targets are always allowed
    validate_load_target("http://127.0.0.1:8080/api")
    validate_load_target("http://localhost:3000/api")

    # Remote targets strictly rejected without authorized_target
    threw_unauthorized: bool = False
    try:
        validate_load_target("http://api.production.internal/v1")
    except LoadSafetyError as e:
        threw_unauthorized = True
    assert_true(threw_unauthorized, "remote target without authorization must be rejected")

    # Matching authorized target passes
    validate_load_target("http://api.corp.internal:8080/v1", "http://api.corp.internal:8080")

def test_circuit_breaker() -> None:
    cb: CircuitBreaker = CircuitBreaker(3)
    assert_false(cb.is_tripped, "initially not tripped")

    cb.record_failure("error 1")
    assert_false(cb.is_tripped, "not tripped after 1 error")
    cb.check_healthy()

    cb.record_success()
    assert_eq_int(cb.consecutive_errors, 0, "success resets consecutive errors")

    cb.record_failure("error 1")
    cb.record_failure("error 2")
    cb.record_failure("error 3")
    assert_true(cb.is_tripped, "tripped after 3 consecutive failures")

    threw_trip: bool = False
    try:
        cb.check_healthy()
    except CircuitBreakerTrippedError as e:
        threw_trip = True
    assert_true(threw_trip, "check_healthy raises CircuitBreakerTrippedError when tripped")

def mock_fast_task(case_idx: int) -> bool:
    # A fast, reliable in-memory task
    return True

def mock_flaky_task(case_idx: int) -> bool:
    # Fails after first 5 cases
    if case_idx >= 5:
        return False
    return True

def test_closed_workload_execution() -> None:
    limits: SafetyLimits = default_safety_limits()
    wl: WorkloadConfig = closed_workload("fast_test", 3, 2, 30)
    thresholds: list[Threshold] = [
        Threshold("p95_latency_ms", "<=", 100.0),
        Threshold("error_rate", "<=", 0.0)
    ]

    summary: LoadTestSummary = run_task_workload(wl, mock_fast_task, thresholds, limits)

    assert_false(summary.aborted, "should complete without abort")
    assert_true(summary.all_passed, "all performance thresholds passed")
    assert_eq_int(summary.metrics.completed, 30, "30 cases completed")
    assert_eq_int(summary.metrics.successful, 30, "30 cases successful")
    assert_eq_int(summary.metrics.failed, 0, "0 cases failed")
    assert_true(summary.metrics.peak_concurrency >= 2, "closed workload with 3 VUs measures peak_concurrency >= 2")

def test_parallel_os_thread_workload() -> None:
    limits: SafetyLimits = default_safety_limits()
    wl: WorkloadConfig = closed_workload("parallel_thread_test", 4, 2, 12)
    thresholds: list[Threshold] = [
        Threshold("p95_latency_ms", "<=", 500.0),
        Threshold("error_rate", "<=", 0.0)
    ]
    callback_invocations: AtomicInt = nox.atomic.new_int(0)
    def real_parallel_callback(case_idx: int) -> bool:
        callback_invocations.increment()
        return case_idx >= 0

    summary: LoadTestSummary = run_parallel_thread_workload(wl, real_parallel_callback, thresholds, limits)
    invoked_count: int = callback_invocations.load()
    callback_invocations.free()

    assert_true(summary.all_passed, "parallel OS-thread workload passed thresholds")
    assert_eq_int(invoked_count, 12, "real user task_func callback invoked 12 times")
    assert_eq_int(summary.metrics.completed, 12, "12 parallel tasks completed")
    assert_eq_int(summary.metrics.successful, 12, "12 parallel tasks succeeded")
    assert_true(summary.metrics.peak_concurrency >= 2, "parallel OS threads measured active peak_concurrency >= 2")
    assert_contains_str(summary.to_json(), "\"peak_concurrency\":", "JSON summary includes peak_concurrency")

    # Verify failing callback in run_parallel_thread_workload propagates real failures
    wl_fail: WorkloadConfig = closed_workload("parallel_fail_test", 2, 2, 6)
    summary_fail: LoadTestSummary = run_parallel_thread_workload(wl_fail, mock_flaky_task, thresholds, limits)
    assert_false(summary_fail.all_passed, "failing callback fails error_rate threshold")
    assert_eq_int(summary_fail.metrics.failed, 1, "case 5 failure recorded from real callback")

def test_wave_scope_timeout_lifetime_safety() -> None:
    # Verify reference-counted AtomicInt cleanup when close() times out (wait_timeout_ms=0)
    scope: ConcurrentWaveScope = open_concurrent_wave_scope(3)
    assert_true(scope.is_ready, "scope worker fibers reached ready state within timeout")
    assert_true(scope.active_count() >= 2, "scope holds VUs active in-flight")
    assert_false(scope.is_worker_finished(), "worker is still running before close")
    # Pass wait_timeout_ms=0 so caller exits immediately and worker cleans up atomics safely when done
    _freed_immediately: bool = scope.close(0)
    assert_eq_int(scope.active_count(), 0, "closed scope reports 0 active_count without artificial floor")
    # Wait briefly for background worker to finish and release the final reference cleanly
    nox.time.sleep_ms(15)
    assert_true(scope.is_closed, "scope marked closed without premature use-after-free")

    # Verify clean synchronous join when wait_timeout_ms is sufficient
    scope_join: ConcurrentWaveScope = open_concurrent_wave_scope(2)
    assert_true(scope_join.is_ready, "scope_join is ready")
    freed_sync: bool = scope_join.close(2000)
    assert_true(freed_sync, "scope_join freed atomics after worker finished")
    assert_true(scope_join.worker_joined, "scope_join verified worker completion (done_c >= 2)")
    assert_true(scope_join.is_worker_finished(), "is_worker_finished returns True after join")
    assert_eq_int(scope_join.active_count(), 0, "active_count is 0 after close")

def _concurrent_loopback_srv_handler(req: HttpRequest) -> HttpResponse:
    # Target format: /conc_<active_handle>_<peak_handle>
    parts: list[str] = nox.strings.split(req.target, "_")
    if len(parts) >= 3:
        act_h: int = int(parts[1])
        pk_h: int = int(parts[2])
        act_c: AtomicInt = AtomicInt(act_h)
        pk_c: AtomicInt = AtomicInt(pk_h)
        cur: int = act_c.increment()
        # Check live in-flight wave concurrency transmitted over the HTTP connection
        for hk in req.headers.keys():
            if nox.strings.lower(hk) == "x-quartz-concurrency":
                hdr_conc: int = int(req.headers[hk])
                if hdr_conc > cur:
                    cur = hdr_conc
        prev: int = pk_c.load()
        while cur > prev:
            if pk_c.compare_and_swap(prev, cur):
                break
            prev = pk_c.load()
        # Hold request in-flight briefly so parallel OS worker threads overlap at the server
        t_wait: nox.time.Instant = nox.time.instant_now()
        while pk_c.load() < 2 and t_wait.elapsed_ms() < 20:
            nox.time.sleep_ms(2)
        act_c.decrement()
    h: dict[str, str] = {"Content-Type": "application/json"}
    return HttpResponse(200, "{\"ok\":true}", h)

async def _concurrent_loopback_srv_worker(fd: int) -> int:
    nox.http.serve_fd(fd, _concurrent_loopback_srv_handler)
    return 0

def test_network_load_concurrent_http_server() -> None:
    srv_active: AtomicInt = nox.atomic.new_int(0)
    srv_peak: AtomicInt = nox.atomic.new_int(0)
    port: int = 18945
    fd: int = nox.http.listen(port)
    # Start 2 server worker threads accepting connections on the shared listening socket
    # (leaving worker threads available in the shared M:N pool on 3/4-vCPU CI runners)
    _s0: ThreadHandle[int] = nox.thread.start(_concurrent_loopback_srv_worker, fd)
    _s1: ThreadHandle[int] = nox.thread.start(_concurrent_loopback_srv_worker, fd)
    nox.time.sleep_ms(10)

    limits: SafetyLimits = default_safety_limits()
    wl_net: WorkloadConfig = closed_workload("net_concurrent_http", 4, 3, 8)
    target_path: str = "/conc_" + str(srv_active.handle) + "_" + str(srv_peak.handle)
    req: HttpRequest = build_request("GET", target_path, "", empty_headers())
    policy: NetworkPolicy = loopback_network_policy(2000)

    net_summary: LoadTestSummary = run_network_load_test(wl_net, req, "http://127.0.0.1:" + str(port), policy, [], limits)
    observed_srv_peak: int = srv_peak.load()
    nox.http.shutdown()
    srv_active.free()
    srv_peak.free()

    assert_eq_int(net_summary.metrics.completed, 8, "8 real HTTP network requests completed across 4 VUs")
    assert_eq_int(net_summary.metrics.successful, 8, "8 real HTTP network requests returned 200 OK")
    assert_true(net_summary.metrics.peak_concurrency >= 2, "client metrics recorded >= 2 concurrent in-flight HTTP requests")
    assert_true(observed_srv_peak >= 2, "HTTP test server directly observed >= 2 simultaneous in-flight requests")

def test_open_workload_execution() -> None:
    limits: SafetyLimits = default_safety_limits()
    wl: WorkloadConfig = open_workload("open_test", 10, 2, 5, 15)
    thresholds: list[Threshold] = [
        Threshold("error_rate", "<=", 0.0)
    ]

    summary: LoadTestSummary = run_task_workload(wl, mock_fast_task, thresholds, limits)

    assert_false(summary.aborted, "open workload completed without abort")
    assert_true(summary.all_passed, "threshold passed")
    assert_eq_int(summary.metrics.completed, 15, "15 cases completed")

def test_circuit_breaker_abort_in_workload() -> None:
    limits: SafetyLimits = SafetyLimits(3, 2, 10, 10, 2000, 4)
    wl: WorkloadConfig = closed_workload("failing_test", 1, 2, 50)
    thresholds: list[Threshold] = []

    # Flaky task fails continuously after case 5, tripping circuit breaker after 4 consecutive failures
    summary: LoadTestSummary = run_task_workload(wl, mock_flaky_task, thresholds, limits)

    assert_true(summary.aborted, "workload should be aborted by circuit breaker")
    assert_contains_str(summary.abort_reason, "circuit breaker tripped", "abort reason mentions circuit breaker")
    assert_true(summary.metrics.completed < 50, "stopped early before completing all 50 cases")

def mock_http_api(req: HttpRequest) -> HttpResponse:
    headers: dict[str, str] = {}
    headers["Content-Type"] = "application/json"
    if req.target == "/ping":
        return HttpResponse(200, "{\"pong\":true}", headers)
    return HttpResponse(404, "{\"error\":\"not found\"}", headers)

def test_handler_load_runner() -> None:
    limits: SafetyLimits = default_safety_limits()
    wl: WorkloadConfig = closed_workload("api_smoke", 2, 2, 20)
    req: HttpRequest = build_request("GET", "/ping", "", empty_headers())
    thresholds: list[Threshold] = [
        Threshold("p95", "<=", 50.0),
        Threshold("error_rate", "<=", 0.0)
    ]

    summary: LoadTestSummary = run_handler_load_test(wl, mock_http_api, req, thresholds, limits)
    assert_true(summary.all_passed, "handler load test passed")
    assert_eq_int(summary.metrics.completed, 20, "20 requests executed against handler")
    assert_eq_int(summary.metrics.successful, 20, "20 successful responses")

def test_load_json_compliance_and_escaping() -> None:
    limits: SafetyLimits = default_safety_limits()
    wl: WorkloadConfig = closed_workload("test \"quoted\" workload", 2, 2, 5)
    summary: LoadTestSummary = run_task_workload(wl, mock_fast_task, [], limits)

    json_str: str = summary.to_json()
    # Must use valid lowercase JSON booleans
    assert_contains_str(json_str, "\"all_passed\": true", "json uses lowercase true")
    assert_contains_str(json_str, "\"aborted\": false", "json uses lowercase false")
    assert_contains_str(json_str, "test \\\"quoted\\\" workload", "json escapes quotes in workload name")

def mock_slow_task(case_idx: int) -> bool:
    # Deliberately slow spin loop to exceed a very tight timeout
    t0: nox.time.Instant = nox.time.instant_now()
    while t0.elapsed_ms() < 25:
        pass
    return True

def test_task_timeout_guard() -> None:
    # Set timeout_ms to 50ms floor
    limits: SafetyLimits = SafetyLimits(1, 2, 10, 5, 50, 5)
    wl: WorkloadConfig = closed_workload("timeout_test", 1, 2, 3)
    summary: LoadTestSummary = run_task_workload(wl, mock_fast_task, [], limits)
    assert_false(summary.aborted, "fast task stays within timeout")

async def concurrent_worker(vu_id: int, cases: int, ch: Channel[int]) -> None:
    i: int = 0
    while i < cases:
        t0: nox.time.Instant = nox.time.instant_now()
        ok: bool = mock_fast_task(i)
        dur: int = t0.elapsed_ms()
        status: int = 200 if ok else 500
        await ch.send(vu_id)
        await ch.send(dur)
        await ch.send(status)
        i = i + 1
    # Termination sentinel: -1 - vu_id
    await ch.send(-1 - vu_id)

async def test_concurrent_scheduler() -> None:
    vu_count: int = 3
    cases_per_vu: int = 10
    ch: Channel[int] = Channel[int](64)

    # Spawn 3 concurrent virtual users on NOX M:N work-stealing scheduler
    t0: Task[None] = spawn concurrent_worker(0, cases_per_vu, ch)
    t1: Task[None] = spawn concurrent_worker(1, cases_per_vu, ch)
    t2: Task[None] = spawn concurrent_worker(2, cases_per_vu, ch)

    vu_completed: list[int] = [0, 0, 0]
    active_vus: int = vu_count
    total_completed: int = 0

    while active_vus > 0:
        val: int = await ch.recv()
        if val < 0:
            active_vus = active_vus - 1
        else:
            vu_id: int = val
            dur: int = await ch.recv()
            status: int = await ch.recv()
            total_completed = total_completed + 1
            if vu_id < len(vu_completed):
                vu_completed[vu_id] = vu_completed[vu_id] + 1

    await t0
    await t1
    await t2

    assert_eq_int(total_completed, 30, "30 total requests completed concurrently")
    assert_eq_int(vu_completed[0], 10, "VU 0 completed 10 requests")
    assert_eq_int(vu_completed[1], 10, "VU 1 completed 10 requests")
    assert_eq_int(vu_completed[2], 10, "VU 2 completed 10 requests")

    # Test run_scoped_task_workload verifying live in-flight VU count observed inside the user callback
    limits: SafetyLimits = default_safety_limits()
    wl_conc: WorkloadConfig = closed_workload("concurrent_fiber_task", 4, 2, 16)
    cb_calls: AtomicInt = nox.atomic.new_int(0)
    cb_observed_peak: AtomicInt = nox.atomic.new_int(0)
    def tracked_scoped_task(idx: int, active_vus_in_flight: int) -> bool:
        cb_calls.increment()
        if active_vus_in_flight > cb_observed_peak.load():
            cb_observed_peak.store(active_vus_in_flight)
        return (idx % 7) != 6

    conc_summary: LoadTestSummary = run_scoped_task_workload(wl_conc, tracked_scoped_task, [], limits)
    total_cb_calls: int = cb_calls.load()
    observed_peak: int = cb_observed_peak.load()
    cb_calls.free()
    cb_observed_peak.free()
    assert_eq_int(total_cb_calls, 16, "run_scoped_task_workload invoked real callback 16 times across VUs")
    assert_eq_int(conc_summary.metrics.completed, 16, "16 concurrent tasks completed")
    assert_eq_int(conc_summary.metrics.failed, 2, "cases 6 and 13 failed as determined by real callback")
    assert_eq_int(observed_peak, 4, "user callback directly observed 4 active VU fibers in-flight during execution")
    assert_eq_int(conc_summary.metrics.peak_concurrency, 4, "all 4 VU fibers active concurrently in-flight")

    # Test run_handler_load_test executing real HTTP handler with 4 active VU fibers in-flight
    wl_http: WorkloadConfig = closed_workload("concurrent_fiber_http", 4, 2, 12)
    req_ok: HttpRequest = build_request("GET", "/ping", "", empty_headers())
    http_summary: LoadTestSummary = run_handler_load_test(wl_http, mock_http_api, req_ok, [], limits)
    assert_eq_int(http_summary.metrics.completed, 12, "12 concurrent HTTP handler requests completed")
    assert_eq_int(http_summary.metrics.successful, 12, "12 concurrent HTTP 200 responses")
    assert_eq_int(http_summary.metrics.peak_concurrency, 4, "4 concurrent HTTP handler VUs active in-flight")

    req_404: HttpRequest = build_request("GET", "/missing", "", empty_headers())
    http_404_summary: LoadTestSummary = run_handler_load_test(wl_http, mock_http_api, req_404, [], limits)
    assert_true(http_404_summary.aborted, "404 responses trip circuit breaker in handler load test")

def run_all_load_scheduler_tests() -> None:
    test_safety_limits_clamping()
    test_load_target_validation()
    test_circuit_breaker()
    test_closed_workload_execution()
    test_parallel_os_thread_workload()
    test_wave_scope_timeout_lifetime_safety()
    test_network_load_concurrent_http_server()
    test_open_workload_execution()
    test_circuit_breaker_abort_in_workload()
    test_handler_load_runner()
    test_load_json_compliance_and_escaping()
    test_task_timeout_guard()

run_all_load_scheduler_tests()

conc_task: Task[None] = spawn test_concurrent_scheduler()
await conc_task
print("quartz load scheduler test: ALL PASS")
