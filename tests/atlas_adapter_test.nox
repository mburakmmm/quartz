# Quartz Tests — Atlas Ecosystem Adapter & Tabular Invariant Tests
from core.suite import TestSuite
from core.prng import Prng
from adapters.atlas import AtlasTable, parse_csv, sort_table, verify_sort_idempotence, verify_csv_roundtrip, groupby_count, verify_groupby_contract, verify_groupby_conservation, inner_join_tables, verify_inner_join_contract, verify_inner_join_conservation, mutate_csv, verify_sort_contract, AtlasEngine, reference_atlas_engine, run_atlas_engine_contract

def broken_groupby(table: AtlasTable, group_col: str) -> AtlasTable:
    # Returns duplicated group rows: A:2, A:2 style corruption
    return AtlasTable([group_col, "count"], [["North", "3"], ["North", "3"], ["South", "2"]])

def broken_join(left: AtlasTable, right: AtlasTable, left_key: str, right_key: str) -> AtlasTable:
    good: AtlasTable = inner_join_tables(left, right, left_key, right_key)
    # Corrupt a NON-key cell while keeping row count and keys intact
    bad_rows: list[list[str]] = []
    i: int = 0
    while i < good.row_count():
        r: list[str] = []
        c: int = 0
        while c < len(good.rows[i]):
            r.append(good.rows[i][c])
            c = c + 1
        if i == 0:
            r[1] = "CORRUPTED"
        bad_rows.append(r)
        i = i + 1
    return AtlasTable(good.headers, bad_rows)

def run_contract_hardening_tests(suite: TestSuite) -> None:
    # GroupBy duplicate groups must be rejected
    src: AtlasTable = AtlasTable(["g", "v"], [["A", "1"], ["A", "2"], ["B", "3"], ["B", "4"]])
    dup_grouped: AtlasTable = AtlasTable(["g", "count"], [["A", "2"], ["A", "2"]])
    suite.check_false("groupby_rejects_duplicate_groups", verify_groupby_contract(src, "g", dup_grouped))
    ok_grouped: AtlasTable = AtlasTable(["g", "count"], [["A", "2"], ["B", "2"]])
    suite.check_true("groupby_accepts_unique_groups", verify_groupby_contract(src, "g", ok_grouped))

    # Join: corrupted non-key cell must be caught
    left: AtlasTable = AtlasTable(["id", "name"], [["1", "Ann"], ["2", "Bob"]])
    right: AtlasTable = AtlasTable(["rid", "city"], [["1", "Rome"], ["2", "Oslo"]])
    good_join: AtlasTable = inner_join_tables(left, right, "id", "rid")
    suite.check_true("join_accepts_correct_result", verify_inner_join_contract(left, right, "id", "rid", good_join))
    bad_join: AtlasTable = broken_join(left, right, "id", "rid")
    suite.check_false("join_rejects_corrupted_non_key_cell", verify_inner_join_contract(left, right, "id", "rid", bad_join))

    # Join: same-named key columns on both sides verified independently
    l2: AtlasTable = AtlasTable(["k", "a"], [["1", "x"], ["2", "y"]])
    r2: AtlasTable = AtlasTable(["k", "b"], [["1", "p"], ["2", "q"]])
    j2: AtlasTable = inner_join_tables(l2, r2, "k", "k")
    suite.check_true("join_same_named_key_ok", verify_inner_join_contract(l2, r2, "k", "k", j2))
    j2_bad_key: AtlasTable = AtlasTable(j2.headers, [["1", "x", "2", "p"], ["2", "y", "2", "q"]])
    suite.check_false("join_same_named_key_right_key_mismatch_rejected", verify_inner_join_contract(l2, r2, "k", "k", j2_bad_key))

    # Sort contract
    unsorted_t: AtlasTable = AtlasTable(["n"], [["3"], ["1"], ["2"]])
    sorted_ok: AtlasTable = AtlasTable(["n"], [["1"], ["2"], ["3"]])
    sorted_lossy: AtlasTable = AtlasTable(["n"], [["1"], ["2"], ["2"]])
    suite.check_true("sort_contract_accepts_correct", verify_sort_contract(unsorted_t, sorted_ok, "n", True, True))
    suite.check_false("sort_contract_rejects_lossy_permutation", verify_sort_contract(unsorted_t, sorted_lossy, "n", True, True))
    suite.check_false("sort_contract_rejects_unordered", verify_sort_contract(unsorted_t, unsorted_t, "n", True, True))

    # Pluggable engine: reference passes, broken engine is caught
    ref: AtlasEngine = reference_atlas_engine()
    ref_fail: list[str] = run_atlas_engine_contract(ref, left, "id", True, "name", right, "id", "rid")
    suite.check_eq_int("reference_engine_contract_clean", len(ref_fail), 0)
    bad_engine: AtlasEngine = AtlasEngine("broken", sort_table, broken_groupby, broken_join)
    bad_fail: list[str] = run_atlas_engine_contract(bad_engine, src, "g", False, "g", right, "g", "rid")
    suite.check_true("broken_engine_detected", len(bad_fail) >= 1)

def run_atlas_adapter_tests() -> None:
    suite: TestSuite = TestSuite("atlas_adapter_suite")

    # 1. Basic AtlasTable operations
    headers: list[str] = ["id", "name", "score"]
    rows: list[list[str]] = [
        ["1", "Alice", "95"],
        ["2", "Bob", "82"],
        ["3", "Charlie", "88"]
    ]
    table: AtlasTable = AtlasTable(headers, rows)
    suite.check_eq_int("table_row_count", table.row_count(), 3)
    suite.check_eq_int("table_col_count", table.col_count(), 3)
    suite.check_eq_str("table_get_cell", table.get_cell(1, "name"), "Bob")
    suite.check_eq_str("table_get_cell_score", table.get_cell(0, "score"), "95")

    # 2. CSV Serialization and Escaping
    complex_rows: list[list[str]] = [
        ["10", "Doe, Jane", "Notes with \"quotes\""],
        ["20", "Smith\nJohn", "Multi\nline\nvalue"],
        ["30", "Simple", "Plain"]
    ]
    c_table: AtlasTable = AtlasTable(["id", "user", "notes"], complex_rows)
    csv_out: str = c_table.to_csv()
    suite.check_true("csv_serialization_not_empty", len(csv_out) > 0)

    # 3. CSV Round-Trip Invariant
    rt_ok: bool = verify_csv_roundtrip(c_table)
    suite.check_true("csv_roundtrip_invariant_complex", rt_ok)

    # 4. CSV Round-Trip with alternate delimiter (semicolon)
    rt_semi_ok: bool = verify_csv_roundtrip(table, ";", "\"")
    suite.check_true("csv_roundtrip_semicolon", rt_semi_ok)

    # 5. Sort Idempotence Invariant
    unsorted_rows: list[list[str]] = [
        ["5", "Zara", "50"],
        ["1", "Alice", "95"],
        ["3", "Charlie", "88"],
        ["2", "Bob", "82"],
        ["4", "David", "70"]
    ]
    u_table: AtlasTable = AtlasTable(["id", "name", "score"], unsorted_rows)

    sort_name_ok: bool = verify_sort_idempotence(u_table, "name", False, True)
    suite.check_true("sort_idempotence_name_asc", sort_name_ok)

    sort_score_ok: bool = verify_sort_idempotence(u_table, "score", True, False)
    suite.check_true("sort_idempotence_score_desc", sort_score_ok)

    # Verify actual sorted order
    sorted_by_score: AtlasTable = sort_table(u_table, "score", True, False)
    suite.check_eq_str("highest_score_top", sorted_by_score.get_cell(0, "name"), "Alice")
    suite.check_eq_str("lowest_score_bottom", sorted_by_score.get_cell(4, "name"), "Zara")

    # 6. GroupBy Row Conservation & Contract Invariant
    sales_rows: list[list[str]] = [
        ["1", "North", "100"],
        ["2", "South", "200"],
        ["3", "North", "150"],
        ["4", "East", "50"],
        ["5", "South", "300"],
        ["6", "North", "120"]
    ]
    sales_table: AtlasTable = AtlasTable(["sale_id", "region", "amount"], sales_rows)
    groupby_ok: bool = verify_groupby_conservation(sales_table, "region")
    suite.check_true("groupby_conservation_sales", groupby_ok)

    # Verify true groupby contract on reference table
    ref_grouped: AtlasTable = groupby_count(sales_table, "region")
    suite.check_true("groupby_contract_valid", verify_groupby_contract(sales_table, "region", ref_grouped))

    # Verify corrupted groupby is caught and rejected by contract
    bad_grouped: AtlasTable = AtlasTable(["region", "count"], [["North", "999"], ["South", "1"]])
    suite.check_false("groupby_contract_catches_corruption", verify_groupby_contract(sales_table, "region", bad_grouped))

    # 7. Inner Join Conservation & Contract Invariant
    left_rows: list[list[str]] = [
        ["1", "Electronics"],
        ["2", "Books"],
        ["3", "Clothing"]
    ]
    right_rows: list[list[str]] = [
        ["101", "Laptop", "1"],
        ["102", "Phone", "1"],
        ["103", "Novel", "2"],
        ["104", "Shirt", "3"],
        ["105", "Pants", "3"]
    ]
    left_table: AtlasTable = AtlasTable(["cat_id", "cat_name"], left_rows)
    right_table: AtlasTable = AtlasTable(["item_id", "item_name", "cat_id"], right_rows)

    join_ok: bool = verify_inner_join_conservation(left_table, right_table, "cat_id", "cat_id")
    suite.check_true("inner_join_conservation", join_ok)

    # Verify true inner join contract on merged table
    joined_res: AtlasTable = inner_join_tables(left_table, right_table, "cat_id", "cat_id")
    suite.check_true("inner_join_contract_valid", verify_inner_join_contract(left_table, right_table, "cat_id", "cat_id", joined_res))
    suite.check_eq_int("inner_join_row_count_exact", joined_res.row_count(), 5)

    # Verify corrupted join table (wrong row count or mismatched keys) is rejected
    bad_join: AtlasTable = AtlasTable(joined_res.headers, [["1", "Electronics", "101", "Laptop", "999"]])
    suite.check_false("inner_join_contract_catches_corruption", verify_inner_join_contract(left_table, right_table, "cat_id", "cat_id", bad_join))

    # 8. CSV Edge-Case Parsing
    # Unclosed quote at EOF
    unclosed_csv: str = "id,name\n1,\"Alice in wonderland"
    unclosed_table: AtlasTable = parse_csv(unclosed_csv)
    suite.check_eq_int("unclosed_quote_row_count", unclosed_table.row_count(), 1)
    suite.check_eq_str("unclosed_quote_cell", unclosed_table.get_cell(0, "name"), "Alice in wonderland")

    # Mismatched column row (short row padded to rect)
    short_row_csv: str = "id,col_a,col_b\n1,val_a\n2,val_x,val_y\n"
    padded_table: AtlasTable = parse_csv(short_row_csv)
    suite.check_eq_int("padded_table_row_count", padded_table.row_count(), 2)
    suite.check_eq_str("padded_table_empty_cell", padded_table.get_cell(0, "col_b"), "")

    # Empty CSV string
    empty_table: AtlasTable = parse_csv("")
    suite.check_eq_int("empty_table_rows", empty_table.row_count(), 0)

    # 9. CSV Mutation Fuzzer
    prng: Prng = Prng(12345)
    orig_csv: str = "id,name,val\n1,foo,10\n2,bar,20\n"
    m_i: int = 0
    mutations_count: int = 0
    while m_i < 10:
        mutated: str = mutate_csv(orig_csv, prng)
        if len(mutated) > 0 and mutated != orig_csv:
            mutations_count = mutations_count + 1
        m_i = m_i + 1
    suite.check_true("csv_mutation_fuzzing_generated", mutations_count > 0)

    run_contract_hardening_tests(suite)

    print("Atlas Adapter Invariant Tests: " + str(suite.pass_count()) + "/" + str(suite.total_count()) + " passed.")
    if not suite.all_passed():
        print("ERROR: Some Atlas adapter tests failed!")
        assert False

run_atlas_adapter_tests()
