# Quartz Load — Metrics & Histogram Test Suite
from core.assert import assert_true, assert_false, assert_eq_int, assert_eq_float, assert_contains_str
from load.metrics import LoadMetrics, get_bucket_index, get_bucket_midpoint
from load.thresholds import Threshold, ThresholdResult, evaluate_threshold, evaluate_all_thresholds, all_thresholds_passed

def test_histogram_bucketing() -> None:
    # 0 to 100ms: 2ms buckets
    assert_eq_int(get_bucket_index(0), 0, "0ms is bucket 0")
    assert_eq_int(get_bucket_index(1), 0, "1ms is bucket 0")
    assert_eq_int(get_bucket_index(2), 1, "2ms is bucket 1")
    assert_eq_int(get_bucket_index(99), 49, "99ms is bucket 49")

    # 100 to 1000ms: 20ms buckets
    assert_eq_int(get_bucket_index(100), 50, "100ms is bucket 50")
    assert_eq_int(get_bucket_index(120), 51, "120ms is bucket 51")

    # 1000 to 5000ms: 100ms buckets
    assert_eq_int(get_bucket_index(1000), 95, "1000ms is bucket 95")

    # 5000 to 60000ms: 500ms buckets
    assert_eq_int(get_bucket_index(5000), 135, "5000ms is bucket 135")
    assert_eq_int(get_bucket_index(10000), 145, "10000ms is bucket 145")

    # >= 60000ms: overflow bucket
    assert_eq_int(get_bucket_index(60000), 245, "60000ms is bucket 245")
    assert_eq_int(get_bucket_index(99999), 245, "large ms is overflow bucket")

def test_percentile_calculations_and_monotonicity() -> None:
    m: LoadMetrics = LoadMetrics()

    # Record 100 synthetic responses with latencies from 1ms to 100ms
    lat: int = 1
    while lat <= 100:
        m.record_scheduled()
        m.record_result(200, lat, False, True)
        lat = lat + 1

    assert_eq_int(m.completed, 100, "100 completed")
    assert_eq_int(m.successful, 100, "100 successful")
    assert_eq_int(m.failed, 0, "0 failed")
    assert_eq_int(m.min_latency_ms, 1, "min latency 1ms")
    assert_eq_int(m.max_latency_ms, 100, "max latency 100ms")

    p50: int = m.p50()
    p90: int = m.p90()
    p95: int = m.p95()
    p99: int = m.p99()

    # Percentiles must be strictly monotonic: min <= p50 <= p90 <= p95 <= p99 <= max
    assert_true(m.min_latency_ms <= p50, "min <= p50")
    assert_true(p50 <= p90, "p50 <= p90")
    assert_true(p90 <= p95, "p90 <= p95")
    assert_true(p95 <= p99, "p95 <= p99")
    assert_true(p99 <= m.max_latency_ms, "p99 <= max")

    # p50 should be around 50ms (+- 5ms bucket resolution)
    diff_p50: int = p50 - 50
    if diff_p50 < 0:
        diff_p50 = -diff_p50
    assert_true(diff_p50 <= 5, "p50 close to 50ms")

    # Mean latency should be approx 50.5
    mean: float = m.mean_latency_ms()
    assert_eq_float(mean, 50.5, 0.5, 0.5, "mean latency approx 50.5ms")

    # Throughput calculation for 1000ms duration (100 reqs in 1s = 100 rps)
    rps: float = m.throughput_rps(1000)
    assert_eq_float(rps, 100.0, 0.1, 0.1, "100 req/s")

    # Error rate should be 0.0
    err_rate: float = m.error_rate()
    assert_eq_float(err_rate, 0.0, 0.001, 0.001, "0.0 error rate")

    # JSON export contains metrics
    json_str: str = m.to_json(1000)
    assert_contains_str(json_str, "\"completed\": 100", "json contains completed count")
    assert_contains_str(json_str, "\"p95_latency_ms\":", "json contains p95")

def test_threshold_evaluations() -> None:
    m: LoadMetrics = LoadMetrics()
    i: int = 0
    while i < 50:
        m.record_scheduled()
        m.record_result(200, 20, False, True)
        i = i + 1

    # Add 2 failed requests
    m.record_scheduled()
    m.record_result(500, 20, False, False)
    m.record_scheduled()
    m.record_result(500, 20, False, False)

    # 1. Passing threshold: p95 <= 50ms
    t_pass: Threshold = Threshold("p95", "<=", 50.0)
    res_pass: ThresholdResult = evaluate_threshold(t_pass, m, 1000)
    assert_true(res_pass.passed, "p95 <= 50ms passes")

    # 2. Failing threshold: p95 <= 10ms
    t_fail: Threshold = Threshold("p95", "<=", 10.0)
    res_fail: ThresholdResult = evaluate_threshold(t_fail, m, 1000)
    assert_false(res_fail.passed, "p95 <= 10ms fails")

    # 3. Error rate threshold: error_rate <= 0.10 (actual is 2 / 52 = 0.038)
    t_err: Threshold = Threshold("error_rate", "<=", 0.10)
    res_err: ThresholdResult = evaluate_threshold(t_err, m, 1000)
    assert_true(res_err.passed, "error rate <= 0.10 passes")

    # 4. Edge case: Zero successful requests MUST fail latency threshold
    m_empty: LoadMetrics = LoadMetrics()
    t_edge: Threshold = Threshold("p95", "<=", 500.0)
    res_edge: ThresholdResult = evaluate_threshold(t_edge, m_empty, 1000)
    assert_false(res_edge.passed, "zero successful requests cannot pass latency threshold")
    assert_contains_str(res_edge.message, "0 successful requests", "informative edge case failure message")

def test_high_latency_overflow() -> None:
    m: LoadMetrics = LoadMetrics()
    # 1. Mixed latencies between 5,000ms and 60,000ms must retain bucket resolution
    i: int = 0
    while i < 5:
        m.record_scheduled()
        m.record_result(200, 6000, False, True)
        i = i + 1

    j: int = 0
    while j < 5:
        m.record_scheduled()
        m.record_result(200, 12000, False, True)
        j = j + 1

    # p50 should be in bucket 137 (~6250ms), p95 should be in bucket 149 (~12250ms)
    assert_true(m.p50() >= 6000 and m.p50() <= 6500, "p50 resolves to ~6250ms without jumping to max")
    assert_true(m.p95() >= 12000 and m.p95() <= 12500, "p95 resolves to ~12250ms")

    # 2. Extreme overflow above 60,000ms (e.g. 70,000ms)
    m_ext: LoadMetrics = LoadMetrics()
    k: int = 0
    while k < 5:
        m_ext.record_scheduled()
        m_ext.record_result(200, 70000, False, True)
        k = k + 1

    assert_eq_int(m_ext.overflow_count, 5, "5 extreme overflow requests recorded")
    assert_eq_int(m_ext.p95(), 70000, "p95 accurately reports 70000ms on extreme overflow")
    assert_eq_int(m_ext.p50(), 70000, "p50 accurately reports 70000ms on extreme overflow")

    json_str: str = m_ext.to_json(1000)
    assert_contains_str(json_str, "\"overflow_count\": 5", "json includes overflow_count")

def run_all_load_metrics_tests() -> None:
    test_histogram_bucketing()
    test_percentile_calculations_and_monotonicity()
    test_threshold_evaluations()
    test_high_latency_overflow()
    print("quartz load metrics test: ALL PASS")

run_all_load_metrics_tests()
