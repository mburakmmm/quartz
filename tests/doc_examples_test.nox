def test_recipe_1_unit_and_fixtures() -> None:
    # Basic assertions
    assert_eq_int(2 + 2, 4, "addition works")
    assert_eq_str("hello " + "world", "hello world", "string concatenation")
    assert_true(len("nox") == 3, "string length")
    assert_eq_float(3.14159, 3.14150, 0.001, 0.001, "float within tolerance")

    # Fixture lifecycle
    fixture: Fixture = Fixture("db_connection", SCOPE_CASE)
    fixture.setup()
    try:
        assert_true(fixture.is_active, "database query verified")
    finally:
        fixture.teardown()
    assert_true(not fixture.is_active, "fixture inactive after teardown")

def test_recipe_2_property_and_shrinking() -> None:
    gen: IntGen = IntGen(-1000, 1000, True)
    config: PropertyConfig = PropertyConfig(100, 5, 42, 5000)

    def prop_commutative(x: int) -> bool:
        return (x * 2) == (2 * x)

    res: PropertyResult = run_int_property("int_commutative", config, gen, prop_commutative)
    assert_true(res.status == "PASS", "property passed")

    # Shrink test
    def prop_under_50(x: int) -> bool:
        return x < 50

    shrunk: ShrinkResultInt = shrink_int(100, prop_under_50, 50)
    assert_eq_int(shrunk.value, 50, "minimal counterexample is 50")

def test_recipe_3_fuzzing() -> None:
    def parse_csv(data: str) -> None:
        if "TRIGGER_BUG" in data:
            raise Exception("Deliberate parser crash")

    corpus: CorpusManager = CorpusManager("doc_csv_target", "corpus", default_corpus_config())
    summary: FuzzSummary = run_fuzz(
        "doc_csv_target",
        parse_csv,
        ["name,age\nalice,30\n"],
        50,
        42,
        corpus,
        1024
    )
    assert_eq_int(summary.crashes_found, 0, "no crashes in benign seed fuzzing")
    assert_eq_int(summary.total_cases, 50, "50 fuzz cases executed")

def test_recipe_4_http_contract() -> None:
    def my_api_handler(req: HttpRequest) -> HttpResponse:
        headers: dict[str, str] = {"Content-Type": "application/json"}
        return HttpResponse(200, "{\"id\": 101, \"username\": \"admin\"}", headers)

    fields: list[PropertyRule] = [
        PropertyRule("id", schema_integer(1, 999999, True, True)),
        PropertyRule("username", schema_string(3, 50))
    ]
    expected_schema: SchemaDescriptor = schema_object(fields, ["id", "username"], True)

    req: HttpRequest = build_request("GET", "/users/101", "", empty_headers())
    tc: ContractTestCase = ContractTestCase(
        "users_api_check",
        req,
        [200],
        ["Content-Type"],
        "application/json",
        expected_schema
    )

    result: ContractCheckResult = tc.run_on_handler(my_api_handler)
    assert_true(result.is_valid, "contract check is valid")
    assert_eq_int(result.status_code, 200, "status code 200")

def test_recipe_5_load_testing() -> None:
    workload: WorkloadConfig = closed_workload("api_benchmark", 3, 2, 30)
    thresholds: list[Threshold] = [
        Threshold("p95", "<=", 50.0),
        Threshold("error_rate", "<=", 0.0)
    ]

    def my_api_handler(req: HttpRequest) -> HttpResponse:
        headers: dict[str, str] = {"Content-Type": "application/json"}
        return HttpResponse(200, "{\"status\": \"ok\"}", headers)

    summary: LoadTestSummary = run_handler_load_test(
        workload,
        my_api_handler,
        build_request("GET", "/ping", "", empty_headers()),
        thresholds,
        default_safety_limits()
    )

    assert_true(summary.all_passed, "all load thresholds passed")
    assert_eq_int(summary.metrics.completed, 30, "30 requests completed")

def test_recipe_6_nyx_and_aether_adapters() -> None:
    # Nyx adapter
    router_nyx: Router = Router()
    def health_handler(ctx: Context) -> HttpResponse:
        return HttpResponse(200, "{\"status\":\"ok\"}", {})
    router_nyx.get("/health", health_handler)

    nyx_adapter: NyxAdapter = create_nyx_adapter(router_nyx)
    res_nyx: HttpResponse = nyx_adapter.dispatch(build_request("GET", "/health", "", empty_headers()))
    assert_eq_int(res_nyx.status, 200, "nyx status 200")

    # Aether adapter
    router_ae: Router = Router()
    def secure_handler(ctx: Context) -> HttpResponse:
        return HttpResponse(200, "{\"secret\":42}", {})
    router_ae.get("/secure", secure_handler)

    ae_adapter: AetherAdapter = create_aether_adapter(router_ae)

    def auth_middleware(req: HttpRequest) -> HttpResponse | None:
        if "Authorization" not in req.headers:
            return HttpResponse(401, "{\"error\":\"unauthorized\"}", {})
        return None

    ae_adapter.use_before(auth_middleware)
    res_ae: HttpResponse = ae_adapter.dispatch(build_request("GET", "/secure", "", empty_headers()))
    assert_eq_int(res_ae.status, 401, "aether unauthorized status 401")

def test_recipe_7_sse_streaming_contract() -> None:
    user_schema: SchemaDescriptor = schema_object([
        PropertyRule("user_id", schema_integer(1, 1000, True, True)),
        PropertyRule("email", schema_string(3, 50))
    ], ["user_id", "email"])

    raw_stream: str = "event: user_created\nid: 1\ndata: {\"user_id\": 42, \"email\": \"alice@example.com\"}\n\nevent: ping\ndata: {}\n\n"

    expectations: list[SseEventExpectation] = [
        SseEventExpectation("user_created", user_schema, True, True),
        SseEventExpectation("ping", schema_object([], []), True, False)
    ]

    val_result: SseValidationResult = validate_sse_stream(raw_stream, expectations)
    assert_true(val_result.is_valid, "recipe 7 sse contract valid")

def test_recipe_8_jsonl_live_logging() -> None:
    test_path: str = "artifacts/doc_live_telemetry.jsonl"
    if nox.fs.exists(test_path):
        nox.fs.remove_file(test_path)

    reporter: JsonlStreamReporter = JsonlStreamReporter(test_path)
    reporter.emit_case_start("api_suite", "test_user_profile")
    reporter.emit_metric_tick("workload_api", 100, 2500.0, 2, 6)
    reporter.emit_case_result("api_suite", "test_user_profile", "PASS", 4, "ok")
    assert_true(reporter.events_emitted == 3, "recipe 8 emitted 3 events")

    if nox.fs.exists(test_path):
        nox.fs.remove_file(test_path)

def test_recipe_9_websocket_contract() -> None:
    # 1. Handshake verification
    req: HttpRequest = mock_ws_client_handshake("/chat", "dGhlIHNhbXBsZSBub25jZQ==", "chat.v1")
    handshake_res: WsValidationResult = validate_ws_handshake_request(req, "chat.v1")
    assert_true(handshake_res.is_valid, "recipe 9 handshake request passes")

    # 2. Conversation validation
    msg_schema: SchemaDescriptor = schema_object([
        PropertyRule("text", schema_string(1, 100))
    ], ["text"])

    script: list[WsStepExpectation] = [
        ws_expect_text("client", "hello"),
        ws_expect_json("server", msg_schema),
        ws_expect_ping("server"),
        ws_expect_pong("client")
    ]

    dialogue: list[WsMessage] = [
        WsMessage(WS_TEXT, "hello", 5),
        WsMessage(WS_TEXT, "{\"text\":\"welcome!\"}", 12),
        WsMessage(WS_PING, "", 20),
        WsMessage(WS_PONG, "", 22)
    ]

    conv_res: WsValidationResult = validate_ws_conversation(dialogue, script)
    assert_true(conv_res.is_valid, "recipe 9 conversation script passes")

def test_recipe_10_html_reports() -> None:
    summary: RunSummary = RunSummary()
    summary.record(TestResult("t1", "test_ping", STATUS_PASS, 4, "", None))
    summary.record(TestResult("t2", "test_pong", STATUS_PASS, 3, "", None))

    html_out: str = format_html_test_report("Recipe 10 Summary", summary, "run-rec10", "noxc", "llvm")
    assert_true(len(html_out) > 100, "recipe 10 html report formatted")

def test_recipe_11_staged_workloads() -> None:
    stages: list[LoadStage] = [
        LoadStage(2, 1),
        LoadStage(4, 1),
        LoadStage(1, 1)
    ]
    cfg: StagedWorkloadConfig = StagedWorkloadConfig("recipe_11_stages", stages, 10, 50, 10)
    safety: SafetyLimits = default_safety_limits()
    thresholds: list[Threshold] = [Threshold("error_rate", "<=", 0.0)]

    def sample_task(idx: int) -> bool:
        return True

    summary: StagedLoadSummary = run_staged_task_workload(cfg, sample_task, thresholds, safety)
    assert_true(summary.all_stages_passed, "recipe 11 staged workload passes")
    assert_eq_int(summary.total_stages, 3, "recipe 11 stage count")

def test_recipe_12_generator_combinators() -> None:
    prng: Prng = Prng(42)
    options: list[WeightedStringOption] = [
        WeightedStringOption(75, "GET"),
        WeightedStringOption(25, "POST")
    ]
    gen_w: WeightedChoiceStringGen = WeightedChoiceStringGen(options)
    val: str = gen_w.generate(prng)
    assert_true(val == "GET" or val == "POST", "recipe 12 weighted string choice")

    def is_even(n: int) -> bool:
        return (n % 2 == 0)

    even_gen: FilteredIntGen = FilteredIntGen(IntGen(1, 100, False), is_even)
    even_val: int = even_gen.generate(prng)
    assert_true(even_val % 2 == 0, "recipe 12 filtered even generator")

def test_recipe_13_mock_playback() -> None:
    exchanges: list[MockExchange] = [
        MockExchange("GET", "/api/v1/ping", {}, "", 200, {"Content-Type": "application/json"}, "{\"pong\": true}")
    ]
    handler: MockPlaybackHandler = create_mock_handler(exchanges)
    res: HttpResponse = handler.handle(HttpRequest("GET", "/api/v1/ping", "", {}))
    assert_eq_int(res.status, 200, "recipe 13 mock playback status")
    assert_contains_str(res.body, "pong", "recipe 13 mock playback body")

def test_recipe_14_regression_comparator() -> None:
    baseline: RunSummary = RunSummary()
    baseline.record(TestResult("t1", "t1", STATUS_PASS, 10, "", None))

    current: RunSummary = RunSummary()
    current.record(TestResult("t1", "t1", STATUS_PASS, 12, "", None))

    comp: RunComparison = compare_runs(baseline, current)
    assert_false(comp.has_regressions, "recipe 14 no regressions")
    assert_eq_int(comp.total_duration_delta_ms, 2, "recipe 14 duration delta")

def run_all_doc_examples_tests() -> None:
    test_recipe_1_unit_and_fixtures()
    test_recipe_2_property_and_shrinking()
    test_recipe_3_fuzzing()
    test_recipe_4_http_contract()
    test_recipe_5_load_testing()
    test_recipe_6_nyx_and_aether_adapters()
    test_recipe_7_sse_streaming_contract()
    test_recipe_8_jsonl_live_logging()
    test_recipe_9_websocket_contract()
    test_recipe_10_html_reports()
    test_recipe_11_staged_workloads()
    test_recipe_12_generator_combinators()
    test_recipe_13_mock_playback()
    test_recipe_14_regression_comparator()
    print("quartz doc examples test: ALL PASS")

run_all_doc_examples_tests()
