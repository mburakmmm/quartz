# Quartz Property Testing Example — Data Structure Invariants
from property.generator import IntGen, ListIntGen
from property.property import PropertyConfig, run_list_int_property, PropertyResult
import core.assert

print("=== Quartz Property-Based Testing Example ===")

# Invariant 1: Reversing a list twice yields the original list
def prop_reverse_twice(xs: list[int]) -> bool:
    rev: list[int] = []
    i: int = len(xs)
    while i > 0:
        i = i - 1
        rev.append(xs[i])

    rev2: list[int] = []
    j: int = len(rev)
    while j > 0:
        j = j - 1
        rev2.append(rev[j])

    if len(xs) != len(rev2):
        return False
    k: int = 0
    while k < len(xs):
        if xs[k] != rev2[k]:
            return False
        k = k + 1
    return True

item_gen: IntGen = IntGen(-100, 100, True)
gen: ListIntGen = ListIntGen(0, 20, item_gen)
config: PropertyConfig = PropertyConfig(200, 10, 42, 5000)
res: PropertyResult = run_list_int_property("reverse_twice_invariant", config, gen, prop_reverse_twice)

print("Test Name: " + res.test_id)
print("Status: " + res.status)
print("Cases Executed: " + str(res.cases_executed))
print("Discards: " + str(res.discards))
print("Seed: " + str(res.seed))

if res.status == "PASS":
    print("All " + str(res.cases_executed) + " randomized cases preserved the invariant!")
else:
    print("Invariant violated! Shrunk counterexample: " + res.shrunk_counterexample)

print("=== Example completed successfully ===")
