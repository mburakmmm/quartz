# Quartz Adapters — Feather ORM & Persistence Ecosystem Adapter
# Bridges Feather entity CRUD invariants, transaction rollback, and ephemeral fixtures with Quartz.
# Quartz Core never depends on this adapter.

import nox.strings
from nox.db import DbConnection, Row
from nox.orm import Table, select

class FeatherField:
    name: str
    value: str
    is_null: bool

    def __init__(self: FeatherField, name: str, value: str, is_null: bool = False) -> None:
        self.name = name
        self.value = value
        self.is_null = is_null

class FeatherRecord:
    id: str
    fields: list[FeatherField]

    def __init__(self: FeatherRecord, id: str) -> None:
        self.id = id
        self.fields = []

    def set(self: FeatherRecord, name: str, value: str) -> None:
        i: int = 0
        while i < len(self.fields):
            if self.fields[i].name == name:
                self.fields[i].value = value
                self.fields[i].is_null = False
                return
            i = i + 1
        new_f: list[FeatherField] = self.fields
        new_f.append(FeatherField(name, value, False))
        self.fields = new_f

    def set_null(self: FeatherRecord, name: str) -> None:
        i: int = 0
        while i < len(self.fields):
            if self.fields[i].name == name:
                self.fields[i].value = ""
                self.fields[i].is_null = True
                return
            i = i + 1
        new_f: list[FeatherField] = self.fields
        new_f.append(FeatherField(name, "", True))
        self.fields = new_f

    def is_null(self: FeatherRecord, name: str) -> bool:
        i: int = 0
        while i < len(self.fields):
            if self.fields[i].name == name:
                return self.fields[i].is_null
            i = i + 1
        return False

    def get(self: FeatherRecord, name: str) -> str:
        i: int = 0
        while i < len(self.fields):
            if self.fields[i].name == name:
                return self.fields[i].value
            i = i + 1
        return ""

    def has(self: FeatherRecord, name: str) -> bool:
        i: int = 0
        while i < len(self.fields):
            if self.fields[i].name == name:
                return True
            i = i + 1
        return False

    def clone(self: FeatherRecord) -> FeatherRecord:
        rec: FeatherRecord = FeatherRecord(self.id)
        i: int = 0
        while i < len(self.fields):
            f: FeatherField = self.fields[i]
            if f.is_null:
                rec.set_null(f.name)
            else:
                rec.set(f.name, f.value)
            i = i + 1
        return rec

    def equals(self: FeatherRecord, other: FeatherRecord) -> bool:
        if self.id != other.id:
            return False
        if len(self.fields) != len(other.fields):
            return False
        i: int = 0
        while i < len(self.fields):
            f: FeatherField = self.fields[i]
            if not other.has(f.name):
                return False
            if other.is_null(f.name) != f.is_null:
                return False
            if (not f.is_null) and other.get(f.name) != f.value:
                return False
            i = i + 1
        return True

class FeatherRepository:
    table_name: str
    records: list[FeatherRecord]
    reject_restore: bool

    def __init__(self: FeatherRepository, table_name: str) -> None:
        self.table_name = table_name
        self.records = []
        self.reject_restore = False

    def insert(self: FeatherRepository, record: FeatherRecord) -> bool:
        # Fails if ID already exists (primary key uniqueness)
        if self.find_by_id(record.id) != None:
            return False
        new_recs: list[FeatherRecord] = self.records
        new_recs.append(record.clone())
        self.records = new_recs
        return True

    def find_by_id(self: FeatherRepository, id: str) -> FeatherRecord | None:
        i: int = 0
        while i < len(self.records):
            if self.records[i].id == id:
                return self.records[i].clone()
            i = i + 1
        return None

    def update(self: FeatherRepository, record: FeatherRecord) -> bool:
        i: int = 0
        while i < len(self.records):
            if self.records[i].id == record.id:
                self.records[i] = record.clone()
                return True
            i = i + 1
        return False

    def upsert(self: FeatherRepository, record: FeatherRecord) -> bool:
        if self.update(record):
            return True
        return self.insert(record)

    def delete(self: FeatherRepository, id: str) -> bool:
        i: int = 0
        found_idx: int = -1
        while i < len(self.records):
            if self.records[i].id == id:
                found_idx = i
                break
            i = i + 1
        if found_idx < 0:
            return False
        new_recs: list[FeatherRecord] = []
        j: int = 0
        while j < len(self.records):
            if j != found_idx:
                new_recs.append(self.records[j])
            j = j + 1
        self.records = new_recs
        return True

    def count(self: FeatherRepository) -> int:
        return len(self.records)

    def all(self: FeatherRepository) -> list[FeatherRecord]:
        out: list[FeatherRecord] = []
        i: int = 0
        while i < len(self.records):
            out.append(self.records[i].clone())
            i = i + 1
        return out

    def clear(self: FeatherRepository) -> None:
        self.records = []

    def create_snapshot(self: FeatherRepository) -> list[FeatherRecord]:
        snap: list[FeatherRecord] = []
        i: int = 0
        while i < len(self.records):
            snap.append(self.records[i].clone())
            i = i + 1
        return snap

    def restore_snapshot(self: FeatherRepository, snapshot: list[FeatherRecord]) -> None:
        if self.reject_restore:
            return
        restored: list[FeatherRecord] = []
        i: int = 0
        while i < len(snapshot):
            restored.append(snapshot[i].clone())
            i = i + 1
        self.records = restored

def verify_crud_lifecycle(
    repo: FeatherRepository,
    initial_record: FeatherRecord,
    update_field: str,
    updated_val: str
) -> bool:
    # Invariant: C-R-U-D sequence preserves consistency and returns to initial count
    initial_count: int = repo.count()

    # 1. Create
    if not repo.insert(initial_record):
        return False
    if repo.count() != initial_count + 1:
        return False

    # 2. Read
    fetched: FeatherRecord | None = repo.find_by_id(initial_record.id)
    if fetched == None:
        return False
    f_rec: FeatherRecord = fetched
    if not f_rec.equals(initial_record):
        return False

    # 3. Update
    f_rec.set(update_field, updated_val)
    if not repo.update(f_rec):
        return False

    fetched_updated: FeatherRecord | None = repo.find_by_id(initial_record.id)
    if fetched_updated == None:
        return False
    fu_rec: FeatherRecord = fetched_updated
    if fu_rec.get(update_field) != updated_val:
        return False

    # 4. Delete
    if not repo.delete(initial_record.id):
        return False
    if repo.find_by_id(initial_record.id) != None:
        return False
    if repo.count() != initial_count:
        return False

    return True

def verify_idempotent_upsert(repo: FeatherRepository, record: FeatherRecord) -> bool:
    # Calling upsert twice leaves state bit-for-bit identical without duplicating records
    repo.upsert(record)
    c1: int = repo.count()
    first_copy: FeatherRecord | None = repo.find_by_id(record.id)
    if first_copy == None:
        return False

    # Second upsert
    repo.upsert(record)
    c2: int = repo.count()
    if c1 != c2:
        return False

    second_copy: FeatherRecord | None = repo.find_by_id(record.id)
    if second_copy == None:
        return False

    f_copy: FeatherRecord = first_copy
    s_copy: FeatherRecord = second_copy
    return f_copy.equals(s_copy)

TX_COMMITTED: str = "COMMITTED"
TX_ABORTED: str = "ABORTED"
TX_ROLLED_BACK_ON_ERROR: str = "ROLLED_BACK_ON_ERROR"
TX_ROLLBACK_FAILED: str = "ROLLBACK_FAILED"

class TxResult:
    outcome: str
    error_message: str

    def __init__(self: TxResult, outcome: str, error_message: str) -> None:
        self.outcome = outcome
        self.error_message = error_message

    def is_committed(self: TxResult) -> bool:
        return self.outcome == TX_COMMITTED

    def is_rollback_failed(self: TxResult) -> bool:
        return self.outcome == TX_ROLLBACK_FAILED

def snapshot_matches(repo: FeatherRepository, snap: list[FeatherRecord]) -> bool:
    if repo.count() != len(snap):
        return False
    i: int = 0
    while i < len(snap):
        expected: FeatherRecord = snap[i]
        cur: FeatherRecord | None = repo.find_by_id(expected.id)
        if cur == None:
            return False
        c_rec: FeatherRecord = cur
        if not c_rec.equals(expected):
            return False
        i = i + 1
    return True

# Runs mutation_fn as a transaction and reports a precise outcome:
#   COMMITTED            mutation succeeded and commit requested (state kept)
#   ABORTED              mutation succeeded, commit not requested -> restored
#   ROLLED_BACK_ON_ERROR mutation raised -> restored
#   ROLLBACK_FAILED      state could not be restored to the pre-transaction snapshot
def run_transaction(repo: FeatherRepository, mutation_fn: (FeatherRepository) -> None, commit: bool) -> TxResult:
    pre_snap: list[FeatherRecord] = repo.create_snapshot()
    err: str = ""
    threw: bool = False
    try:
        mutation_fn(repo)
    except Exception as e:
        threw = True
        err = str(e)

    if threw:
        repo.restore_snapshot(pre_snap)
        if snapshot_matches(repo, pre_snap):
            return TxResult(TX_ROLLED_BACK_ON_ERROR, err)
        return TxResult(TX_ROLLBACK_FAILED, err)

    if commit:
        return TxResult(TX_COMMITTED, "")

    repo.restore_snapshot(pre_snap)
    if snapshot_matches(repo, pre_snap):
        return TxResult(TX_ABORTED, "")
    return TxResult(TX_ROLLBACK_FAILED, "")

def verify_transaction_rollback(
    repo: FeatherRepository,
    mutation_fn: (FeatherRepository) -> None,
    should_abort: bool
) -> bool:
    # Backwards-compatible boolean wrapper: True unless the rollback itself failed.
    res: TxResult = run_transaction(repo, mutation_fn, not should_abort)
    return not res.is_rollback_failed()

class FeatherFixture:
    repo: FeatherRepository
    snapshot: list[FeatherRecord]
    is_active: bool

    def __init__(self: FeatherFixture, repo: FeatherRepository) -> None:
        self.repo = repo
        self.snapshot = []
        self.is_active = False

    def setup(self: FeatherFixture) -> None:
        self.snapshot = self.repo.create_snapshot()
        self.is_active = True

    def teardown(self: FeatherFixture) -> None:
        self.repo.restore_snapshot(self.snapshot)
        self.is_active = False

    def __enter__(self: FeatherFixture) -> FeatherFixture:
        self.setup()
        return self

    def __exit__(self: FeatherFixture) -> None:
        self.teardown()

    def run_isolated(self: FeatherFixture, fn: () -> None) -> None:
        self.setup()
        try:
            fn()
        finally:
            self.teardown()

# ── Standard Library DB / ORM Connectors (`nox.db.Row`, `nox.db.DbConnection`, `nox.orm.Table`) ──

# Structural SQL connection protocol satisfied by `nox.sqlite.Connection`,
# `nox.postgres.Connection`, `nox.mysql.Connection`, and `InMemorySqlConnection`.
protocol SqlConnection:
    def execute(self: SqlConnection, sql: str) -> int:
        pass

    def query(self: SqlConnection, sql: str) -> list[Row]:
        pass

    def close(self: SqlConnection) -> None:
        pass

# Converts a `nox.db.Row` into a `FeatherRecord`, using `pk_col` as the record ID
# and preserving SQL NULL vs empty-string ("") cells via `set_null`.
def row_to_feather_record(row: Row, pk_col: str) -> FeatherRecord:
    pk_val: str = ""
    n: int = row.column_count()
    i: int = 0
    while i < n:
        if row.column_name(i) == pk_col:
            if not row.is_null(i):
                pk_val = row.get_str(i)
            break
        i = i + 1

    rec: FeatherRecord = FeatherRecord(pk_val)
    j: int = 0
    while j < n:
        cname: str = row.column_name(j)
        if row.is_null(j):
            rec.set_null(cname)
        else:
            rec.set(cname, row.get_str(j))
        j = j + 1
    return rec

# Converts `list[nox.db.Row]` query output into `list[FeatherRecord]`.
def rows_to_feather_records(rows: list[Row], pk_col: str) -> list[FeatherRecord]:
    out: list[FeatherRecord] = []
    i: int = 0
    while i < len(rows):
        out.append(row_to_feather_record(rows[i], pk_col))
        i = i + 1
    return out

# Checks whether two `list[FeatherRecord]` snapshots are identical regardless of row order.
def records_equal(a: list[FeatherRecord], b: list[FeatherRecord]) -> bool:
    if len(a) != len(b):
        return False
    i: int = 0
    while i < len(a):
        rec_a: FeatherRecord = a[i]
        matched: bool = False
        j: int = 0
        while j < len(b):
            if b[j].id == rec_a.id and b[j].equals(rec_a):
                matched = True
                break
            j = j + 1
        if not matched:
            return False
        i = i + 1
    return True

# Runs a real SQL transaction (`BEGIN TRANSACTION` / `COMMIT` / `ROLLBACK`) against any
# `SqlConnection` (`nox.sqlite.Connection`, `nox.postgres.Connection`, `nox.mysql.Connection`, etc.)
# and verifies post-rollback state against pre-transaction rows queried via `SELECT * FROM <table>`.
def run_sql_transaction(
    conn: SqlConnection,
    table_name: str,
    pk_col: str,
    mutation_fn: () -> None,
    commit: bool
) -> TxResult:
    select_sql: str = "SELECT * FROM " + table_name
    pre_snap: list[FeatherRecord] = rows_to_feather_records(conn.query(select_sql), pk_col)
    conn.execute("BEGIN TRANSACTION")
    err: str = ""
    threw: bool = False
    try:
        mutation_fn()
    except Exception as e:
        threw = True
        err = str(e)

    if threw:
        try:
            conn.execute("ROLLBACK")
        except Exception as rb_err:
            return TxResult(TX_ROLLBACK_FAILED, err + " (rollback failed: " + str(rb_err) + ")")
        post_err_snap: list[FeatherRecord] = rows_to_feather_records(conn.query(select_sql), pk_col)
        if records_equal(pre_snap, post_err_snap):
            return TxResult(TX_ROLLED_BACK_ON_ERROR, err)
        return TxResult(TX_ROLLBACK_FAILED, err)

    if commit:
        try:
            conn.execute("COMMIT")
        except Exception as cm_err:
            # Recovery rollback: ensure the open transaction is closed and pre-tx state is restored
            try:
                conn.execute("ROLLBACK")
            except Exception as cm_rb_err:
                return TxResult(TX_ROLLBACK_FAILED, "commit failed: " + str(cm_err) + " (recovery rollback failed: " + str(cm_rb_err) + ")")
            post_cm_snap: list[FeatherRecord] = rows_to_feather_records(conn.query(select_sql), pk_col)
            if records_equal(pre_snap, post_cm_snap):
                return TxResult(TX_ROLLED_BACK_ON_ERROR, "commit failed (rolled back): " + str(cm_err))
            return TxResult(TX_ROLLBACK_FAILED, "commit failed and state not restored: " + str(cm_err))
        return TxResult(TX_COMMITTED, "")

    try:
        conn.execute("ROLLBACK")
    except Exception as ab_err:
        return TxResult(TX_ROLLBACK_FAILED, "rollback failed: " + str(ab_err))
    post_abort_snap: list[FeatherRecord] = rows_to_feather_records(conn.query(select_sql), pk_col)
    if records_equal(pre_snap, post_abort_snap):
        return TxResult(TX_ABORTED, "")
    return TxResult(TX_ROLLBACK_FAILED, "state mismatch after SQL ROLLBACK")

# Runs a real SQL transaction against a full `nox.db.DbConnection` + `nox.orm.Table` schema,
# querying pre/post state via `nox.orm.select(conn, table, "", [])`.
def run_orm_transaction(
    conn: DbConnection,
    table: Table,
    pk_col: str,
    mutation_fn: () -> None,
    commit: bool
) -> TxResult:
    pre_snap: list[FeatherRecord] = rows_to_feather_records(select(conn, table, "", []), pk_col)
    conn.execute("BEGIN TRANSACTION")
    err: str = ""
    threw: bool = False
    try:
        mutation_fn()
    except Exception as e:
        threw = True
        err = str(e)

    if threw:
        try:
            conn.execute("ROLLBACK")
        except Exception as rb_err:
            return TxResult(TX_ROLLBACK_FAILED, err + " (rollback failed: " + str(rb_err) + ")")
        post_err_snap: list[FeatherRecord] = rows_to_feather_records(select(conn, table, "", []), pk_col)
        if records_equal(pre_snap, post_err_snap):
            return TxResult(TX_ROLLED_BACK_ON_ERROR, err)
        return TxResult(TX_ROLLBACK_FAILED, err)

    if commit:
        try:
            conn.execute("COMMIT")
        except Exception as cm_err:
            # Recovery rollback: ensure the open transaction is closed and pre-tx state is restored
            try:
                conn.execute("ROLLBACK")
            except Exception as cm_rb_err:
                return TxResult(TX_ROLLBACK_FAILED, "commit failed: " + str(cm_err) + " (recovery rollback failed: " + str(cm_rb_err) + ")")
            post_cm_snap: list[FeatherRecord] = rows_to_feather_records(select(conn, table, "", []), pk_col)
            if records_equal(pre_snap, post_cm_snap):
                return TxResult(TX_ROLLED_BACK_ON_ERROR, "commit failed (rolled back): " + str(cm_err))
            return TxResult(TX_ROLLBACK_FAILED, "commit failed and state not restored: " + str(cm_err))
        return TxResult(TX_COMMITTED, "")

    try:
        conn.execute("ROLLBACK")
    except Exception as ab_err:
        return TxResult(TX_ROLLBACK_FAILED, "rollback failed: " + str(ab_err))
    post_abort_snap: list[FeatherRecord] = rows_to_feather_records(select(conn, table, "", []), pk_col)
    if records_equal(pre_snap, post_abort_snap):
        return TxResult(TX_ABORTED, "")
    return TxResult(TX_ROLLBACK_FAILED, "state mismatch after SQL ROLLBACK")

# Portable in-process `SqlConnection` implementation that executes `BEGIN TRANSACTION`, `COMMIT`,
# `ROLLBACK`, `INSERT INTO <table> VALUES (a, b)`, `DELETE FROM <table>`, and `SELECT * FROM <table>`,
# producing genuine `nox.db.Row` lists for deterministic multi-platform CI testing.
class InMemorySqlConnection:
    columns: list[str]
    rows: list[list[str]]
    null_masks: list[list[bool]]
    tx_backup: list[list[str]]
    tx_null_backup: list[list[bool]]
    in_tx: bool
    simulate_broken_rollback: bool
    simulate_commit_error: bool

    def __init__(self: InMemorySqlConnection, columns: list[str]) -> None:
        self.columns = columns
        self.rows = []
        self.null_masks = []
        self.tx_backup = []
        self.tx_null_backup = []
        self.in_tx = False
        self.simulate_broken_rollback = False
        self.simulate_commit_error = False

    def _clone_rows(self: InMemorySqlConnection, src: list[list[str]]) -> list[list[str]]:
        out: list[list[str]] = []
        i: int = 0
        while i < len(src):
            r: list[str] = []
            j: int = 0
            while j < len(src[i]):
                r.append(src[i][j])
                j = j + 1
            out.append(r)
            i = i + 1
        return out

    def _clone_nulls(self: InMemorySqlConnection, src: list[list[bool]]) -> list[list[bool]]:
        out: list[list[bool]] = []
        i: int = 0
        while i < len(src):
            r: list[bool] = []
            j: int = 0
            while j < len(src[i]):
                r.append(src[i][j])
                j = j + 1
            out.append(r)
            i = i + 1
        return out

    def insert_row(self: InMemorySqlConnection, values: list[str]) -> int:
        nulls: list[bool] = []
        i: int = 0
        while i < len(values):
            nulls.append(False)
            i = i + 1
        return self.insert_row_with_nulls(values, nulls)

    def insert_row_with_nulls(self: InMemorySqlConnection, values: list[str], nulls: list[bool]) -> int:
        new_rows: list[list[str]] = self.rows
        new_rows.append(values)
        self.rows = new_rows
        new_nulls: list[list[bool]] = self.null_masks
        new_nulls.append(nulls)
        self.null_masks = new_nulls
        return 1

    def execute(self: InMemorySqlConnection, sql: str) -> int:
        s: str = nox.strings.trim(sql)
        if s == "BEGIN" or s == "BEGIN TRANSACTION":
            self.tx_backup = self._clone_rows(self.rows)
            self.tx_null_backup = self._clone_nulls(self.null_masks)
            self.in_tx = True
            return 0
        if s == "COMMIT":
            if self.simulate_commit_error:
                raise ValueError("simulated deferred constraint failure on COMMIT")
            self.tx_backup = []
            self.tx_null_backup = []
            self.in_tx = False
            return 0
        if s == "ROLLBACK":
            if not self.simulate_broken_rollback and self.in_tx:
                self.rows = self._clone_rows(self.tx_backup)
                self.null_masks = self._clone_nulls(self.tx_null_backup)
            self.tx_backup = []
            self.tx_null_backup = []
            self.in_tx = False
            return 0
        if nox.strings.starts_with(s, "DELETE FROM"):
            cnt: int = len(self.rows)
            self.rows = []
            self.null_masks = []
            return cnt
        if nox.strings.starts_with(s, "INSERT INTO"):
            lp: int = nox.strings.index_of(s, "(")
            rp: int = nox.strings.index_of(s, ")")
            if lp >= 0 and rp > lp:
                inner: str = s[lp + 1:rp]
                parts: list[str] = nox.strings.split(inner, ",")
                cleaned: list[str] = []
                nulls_row: list[bool] = []
                pi: int = 0
                while pi < len(parts):
                    v: str = nox.strings.trim(parts[pi])
                    if v == "NULL" or v == "null":
                        cleaned.append("")
                        nulls_row.append(True)
                    elif len(v) >= 2 and v[0:1] == "'" and v[len(v) - 1:len(v)] == "'":
                        v = v[1:len(v) - 1]
                        cleaned.append(v)
                        nulls_row.append(False)
                    else:
                        cleaned.append(v)
                        nulls_row.append(False)
                    pi = pi + 1
                return self.insert_row_with_nulls(cleaned, nulls_row)
        return 0

    def query(self: InMemorySqlConnection, sql: str) -> list[Row]:
        out: list[Row] = []
        i: int = 0
        while i < len(self.rows):
            vals: list[str] = self.rows[i]
            nulls: list[bool] = []
            if i < len(self.null_masks) and len(self.null_masks[i]) == len(vals):
                nulls = self.null_masks[i]
            else:
                c: int = 0
                while c < len(vals):
                    nulls.append(False)
                    c = c + 1
            out.append(Row(vals, nulls, self.columns))
            i = i + 1
        return out

    def close(self: InMemorySqlConnection) -> None:
        self.in_tx = False
