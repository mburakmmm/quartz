# Quartz Adapters — Atlas Tabular & DataFrame Ecosystem Adapter
# Bridges Atlas tabular data structures, CSV serialization, and invariants with Quartz.
# Quartz Core never depends on this adapter.

import nox.strings
import nox.csv
from nox.db import Row
from core.prng import Prng

class AtlasTable:
    headers: list[str]
    rows: list[list[str]]
    null_mask: list[list[bool]]

    def __init__(self: AtlasTable, headers: list[str], rows: list[list[str]]) -> None:
        self.headers = headers
        self.rows = rows
        self.null_mask = []

    def row_count(self: AtlasTable) -> int:
        return len(self.rows)

    def col_count(self: AtlasTable) -> int:
        return len(self.headers)

    def col_index(self: AtlasTable, col_name: str) -> int:
        i: int = 0
        while i < len(self.headers):
            if self.headers[i] == col_name:
                return i
            i = i + 1
        return -1

    def is_null_pos(self: AtlasTable, row_idx: int, col_idx: int) -> bool:
        if row_idx < 0 or row_idx >= len(self.null_mask):
            return False
        nrow: list[bool] = self.null_mask[row_idx]
        if col_idx < 0 or col_idx >= len(nrow):
            return False
        return nrow[col_idx]

    def is_null_cell(self: AtlasTable, row_idx: int, col_name: str) -> bool:
        idx: int = self.col_index(col_name)
        return self.is_null_pos(row_idx, idx)

    def get_cell(self: AtlasTable, row_idx: int, col_name: str) -> str:
        idx: int = self.col_index(col_name)
        if idx < 0 or row_idx < 0 or row_idx >= len(self.rows):
            return ""
        row: list[str] = self.rows[row_idx]
        if idx >= len(row):
            return ""
        return row[idx]

    def to_csv(self: AtlasTable, delimiter: str = ",", quote_char: str = "\"") -> str:
        res: str = ""
        # Write headers
        h_idx: int = 0
        while h_idx < len(self.headers):
            if h_idx > 0:
                res = res + delimiter
            res = res + escape_csv_field(self.headers[h_idx], delimiter, quote_char)
            h_idx = h_idx + 1
        res = res + "\n"

        # Write rows
        r_idx: int = 0
        while r_idx < len(self.rows):
            row: list[str] = self.rows[r_idx]
            c_idx: int = 0
            while c_idx < len(row):
                if c_idx > 0:
                    res = res + delimiter
                res = res + escape_csv_field(row[c_idx], delimiter, quote_char)
                c_idx = c_idx + 1
            res = res + "\n"
            r_idx = r_idx + 1
        return res

def escape_csv_field(field: str, delimiter: str, quote_char: str) -> str:
    needs_quotes: bool = False
    if nox.strings.contains(field, delimiter) or nox.strings.contains(field, quote_char) or nox.strings.contains(field, "\n") or nox.strings.contains(field, "\r"):
        needs_quotes = True

    if not needs_quotes:
        return field

    escaped: str = nox.strings.replace(field, quote_char, quote_char + quote_char)
    return quote_char + escaped + quote_char

def parse_csv(raw_csv: str, delimiter: str = ",", quote_char: str = "\"") -> AtlasTable:
    # State machine parser supporting quotes, delimiters, newlines, and double-quote escapes
    rows: list[list[str]] = []
    current_row: list[str] = []
    current_field: str = ""
    in_quotes: bool = False
    i: int = 0
    n: int = len(raw_csv)

    while i < n:
        ch: str = raw_csv[i:i+1]
        if in_quotes:
            if ch == quote_char:
                # Check for escaped quote (double quote)
                if (i + 1) < n and raw_csv[i+1:i+2] == quote_char:
                    current_field = current_field + quote_char
                    i = i + 1  # Skip second quote
                else:
                    in_quotes = False
            else:
                current_field = current_field + ch
        else:
            if ch == quote_char:
                in_quotes = True
            elif ch == delimiter:
                current_row.append(current_field)
                current_field = ""
            elif ch == "\r":
                # Check for CRLF
                if (i + 1) < n and raw_csv[i+1:i+2] == "\n":
                    i = i + 1
                current_row.append(current_field)
                current_field = ""
                if len(current_row) > 0:
                    rows.append(current_row)
                current_row = []
            elif ch == "\n":
                current_row.append(current_field)
                current_field = ""
                if len(current_row) > 0:
                    rows.append(current_row)
                current_row = []
            else:
                current_field = current_field + ch
        i = i + 1

    # End of text — handle trailing fields or unclosed quote gracefully
    if len(current_field) > 0 or len(current_row) > 0:
        current_row.append(current_field)
        rows.append(current_row)

    if len(rows) == 0:
        return AtlasTable([], [])

    headers: list[str] = rows[0]
    expected_cols: int = len(headers)
    data_rows: list[list[str]] = []
    r: int = 1
    while r < len(rows):
        d_row: list[str] = rows[r]
        # Pad short rows with empty strings to guarantee rectangular integrity
        while len(d_row) < expected_cols:
            d_row.append("")
        data_rows.append(d_row)
        r = r + 1

    return AtlasTable(headers, data_rows)

def sort_table(table: AtlasTable, sort_col: str, is_numeric: bool = False, ascending: bool = True) -> AtlasTable:
    idx: int = table.col_index(sort_col)
    if idx < 0:
        return table

    # Copy rows
    sorted_rows: list[list[str]] = []
    i: int = 0
    while i < len(table.rows):
        sorted_rows.append(table.rows[i])
        i = i + 1

    # Insertion sort
    p: int = 1
    while p < len(sorted_rows):
        key_row: list[str] = sorted_rows[p]
        key_val: str = key_row[idx]
        q: int = p - 1
        while q >= 0:
            cmp_row: list[str] = sorted_rows[q]
            cmp_val: str = cmp_row[idx]
            should_swap: bool = False
            if is_numeric:
                try:
                    k_num: int = int(key_val)
                    c_num: int = int(cmp_val)
                    if ascending:
                        should_swap = (k_num < c_num)
                    else:
                        should_swap = (k_num > c_num)
                except Exception as e:
                    if ascending:
                        should_swap = (key_val < cmp_val)
                    else:
                        should_swap = (key_val > cmp_val)
            else:
                if ascending:
                    should_swap = (key_val < cmp_val)
                else:
                    should_swap = (key_val > cmp_val)

            if should_swap:
                sorted_rows[q + 1] = sorted_rows[q]
                q = q - 1
            else:
                break
        sorted_rows[q + 1] = key_row
        p = p + 1

    return AtlasTable(table.headers, sorted_rows)

def verify_sort_idempotence(table: AtlasTable, sort_col: str, is_numeric: bool = False, ascending: bool = True) -> bool:
    t1: AtlasTable = sort_table(table, sort_col, is_numeric, ascending)
    t2: AtlasTable = sort_table(t1, sort_col, is_numeric, ascending)

    if t1.row_count() != t2.row_count():
        return False

    r: int = 0
    while r < t1.row_count():
        c: int = 0
        while c < t1.col_count():
            h: str = t1.headers[c]
            if t1.get_cell(r, h) != t2.get_cell(r, h):
                return False
            c = c + 1
        r = r + 1
    return True

def verify_csv_roundtrip(table: AtlasTable, delimiter: str = ",", quote_char: str = "\"") -> bool:
    csv_text: str = table.to_csv(delimiter, quote_char)
    rt_table: AtlasTable = parse_csv(csv_text, delimiter, quote_char)

    if rt_table.row_count() != table.row_count() or rt_table.col_count() != table.col_count():
        return False

    # Check headers
    h: int = 0
    while h < len(table.headers):
        if rt_table.headers[h] != table.headers[h]:
            return False
        h = h + 1

    # Check all cells
    r: int = 0
    while r < table.row_count():
        c: int = 0
        while c < table.col_count():
            col_name: str = table.headers[c]
            if rt_table.get_cell(r, col_name) != table.get_cell(r, col_name):
                return False
            c = c + 1
        r = r + 1

    return True

def groupby_count(table: AtlasTable, group_col: str, count_col: str = "count") -> AtlasTable:
    idx: int = table.col_index(group_col)
    if idx < 0:
        return AtlasTable([group_col, count_col], [])

    keys: list[str] = []
    counts: list[int] = []

    r: int = 0
    while r < table.row_count():
        k_val: str = table.get_cell(r, group_col)
        found: bool = False
        k: int = 0
        while k < len(keys):
            if keys[k] == k_val:
                counts[k] = counts[k] + 1
                found = True
                break
            k = k + 1
        if not found:
            keys.append(k_val)
            counts.append(1)
        r = r + 1

    out_rows: list[list[str]] = []
    i: int = 0
    while i < len(keys):
        out_rows.append([keys[i], str(counts[i])])
        i = i + 1

    return AtlasTable([group_col, count_col], out_rows)

def verify_groupby_contract(
    input_table: AtlasTable,
    group_col: str,
    grouped_table: AtlasTable,
    count_col: str = "count"
) -> bool:
    # Ground-truth verification of an externally produced GroupBy table
    gt_keys: list[str] = []
    gt_counts: list[int] = []

    r: int = 0
    while r < input_table.row_count():
        k_val: str = input_table.get_cell(r, group_col)
        found: bool = False
        k: int = 0
        while k < len(gt_keys):
            if gt_keys[k] == k_val:
                gt_counts[k] = gt_counts[k] + 1
                found = True
                break
            k = k + 1
        if not found:
            gt_keys.append(k_val)
            gt_counts.append(1)
        r = r + 1

    if grouped_table.row_count() != len(gt_keys):
        return False

    # Output group keys must be unique (A:2, A:2 is a corrupted result even if counts add up)
    seen_keys: list[str] = []
    u: int = 0
    while u < grouped_table.row_count():
        uk: str = grouped_table.get_cell(u, group_col)
        s: int = 0
        while s < len(seen_keys):
            if seen_keys[s] == uk:
                return False
            s = s + 1
        seen_keys.append(uk)
        u = u + 1
    # Check each row in grouped_table matches exact ground truth
    total_in_grouped: int = 0
    g: int = 0
    while g < grouped_table.row_count():
        group_key: str = grouped_table.get_cell(g, group_col)
        count_str: str = grouped_table.get_cell(g, count_col)
        actual_cnt: int = 0
        try:
            actual_cnt = int(count_str)
        except Exception as e:
            return False

        # Find in ground truth
        matched_gt: bool = False
        m: int = 0
        while m < len(gt_keys):
            if gt_keys[m] == group_key:
                if gt_counts[m] != actual_cnt:
                    return False
                matched_gt = True
                break
            m = m + 1

        if not matched_gt:
            return False

        total_in_grouped = total_in_grouped + actual_cnt
        g = g + 1

    return total_in_grouped == input_table.row_count()

def verify_groupby_conservation(table: AtlasTable, group_col: str) -> bool:
    ref_grouped: AtlasTable = groupby_count(table, group_col)
    return verify_groupby_contract(table, group_col, ref_grouped)

def inner_join_tables(left: AtlasTable, right: AtlasTable, left_key: str, right_key: str) -> AtlasTable:
    l_idx: int = left.col_index(left_key)
    r_idx: int = right.col_index(right_key)
    if l_idx < 0 or r_idx < 0:
        return AtlasTable([], [])

    # Compose output headers
    out_headers: list[str] = []
    h1: int = 0
    while h1 < len(left.headers):
        out_headers.append(left.headers[h1])
        h1 = h1 + 1

    h2: int = 0
    while h2 < len(right.headers):
        r_head: str = right.headers[h2]
        if left.col_index(r_head) >= 0:
            out_headers.append("right_" + r_head)
        else:
            out_headers.append(r_head)
        h2 = h2 + 1

    out_rows: list[list[str]] = []
    out_nulls: list[list[bool]] = []
    i: int = 0
    while i < left.row_count():
        # Standard SQL INNER JOIN semantics: NULL join keys never match (NULL != NULL and NULL != "")
        if not left.is_null_pos(i, l_idx):
            l_val: str = left.get_cell(i, left_key)
            j: int = 0
            while j < right.row_count():
                if not right.is_null_pos(j, r_idx):
                    r_val: str = right.get_cell(j, right_key)
                    if l_val == r_val:
                        # Merge row and preserve null_mask across both tables
                        merged: list[str] = []
                        merged_null: list[bool] = []
                        c1: int = 0
                        while c1 < left.col_count():
                            merged.append(left.get_cell(i, left.headers[c1]))
                            merged_null.append(left.is_null_pos(i, c1))
                            c1 = c1 + 1
                        c2: int = 0
                        while c2 < right.col_count():
                            merged.append(right.get_cell(j, right.headers[c2]))
                            merged_null.append(right.is_null_pos(j, c2))
                            c2 = c2 + 1
                        out_rows.append(merged)
                        out_nulls.append(merged_null)
                j = j + 1
        i = i + 1

    joined_out: AtlasTable = AtlasTable(out_headers, out_rows)
    joined_out.null_mask = out_nulls
    return joined_out

# Length-prefixed canonical row encoding — immune to delimiter / control-character collisions
# and preserving NULL vs empty-string ("") distinction ("N;" vs "V0:;").
def row_signature_with_nulls(row: list[str], nulls: list[bool]) -> str:
    s: str = str(len(row)) + "#"
    i: int = 0
    while i < len(row):
        if i < len(nulls) and nulls[i]:
            s = s + "N;"
        else:
            cell: str = row[i]
            s = s + "V" + str(len(cell)) + ":" + cell + ";"
        i = i + 1
    return s

def row_signature(row: list[str]) -> str:
    return row_signature_with_nulls(row, [])

def table_row_signature(table: AtlasTable, row_idx: int) -> str:
    if row_idx < 0 or row_idx >= len(table.rows):
        return "0#"
    nulls: list[bool] = []
    if row_idx < len(table.null_mask):
        nulls = table.null_mask[row_idx]
    return row_signature_with_nulls(table.rows[row_idx], nulls)

def verify_inner_join_contract(
    left: AtlasTable,
    right: AtlasTable,
    left_key: str,
    right_key: str,
    joined_table: AtlasTable
) -> bool:
    # Ground truth verification of inner join results
    l_idx: int = left.col_index(left_key)
    r_idx: int = right.col_index(right_key)
    if l_idx < 0 or r_idx < 0:
        return False

    # 1. Compute exact expected count: sum(count_left(k) * count_right(k)) for non-NULL keys
    expected_matches: int = 0
    i: int = 0
    while i < left.row_count():
        if not left.is_null_pos(i, l_idx):
            l_val: str = left.get_cell(i, left_key)
            j: int = 0
            while j < right.row_count():
                if (not right.is_null_pos(j, r_idx)) and l_val == right.get_cell(j, right_key):
                    expected_matches = expected_matches + 1
                j = j + 1
        i = i + 1

    if joined_table.row_count() != expected_matches:
        return False

    # 2. Column layout must be left columns followed by right columns (positional, so
    #    same-named left/right key columns are verified independently of header naming)
    expected_cols: int = left.col_count() + right.col_count()
    if joined_table.col_count() != expected_cols:
        return False

    left_key_pos: int = l_idx
    right_key_pos: int = left.col_count() + r_idx

    # 3. Build the ground-truth multiset of full-row length-prefixed signatures (ALL cells + null flags, positional)
    expected_sigs: list[str] = []
    ei: int = 0
    while ei < left.row_count():
        if not left.is_null_pos(ei, l_idx):
            ej: int = 0
            while ej < right.row_count():
                if (not right.is_null_pos(ej, r_idx)) and left.get_cell(ei, left_key) == right.get_cell(ej, right_key):
                    combined_expected: list[str] = []
                    combined_nulls: list[bool] = []
                    lc: int = 0
                    while lc < len(left.rows[ei]):
                        combined_expected.append(left.rows[ei][lc])
                        combined_nulls.append(left.is_null_pos(ei, lc))
                        lc = lc + 1
                    rc: int = 0
                    while rc < len(right.rows[ej]):
                        combined_expected.append(right.rows[ej][rc])
                        combined_nulls.append(right.is_null_pos(ej, rc))
                        rc = rc + 1
                    expected_sigs.append(row_signature_with_nulls(combined_expected, combined_nulls))
                ej = ej + 1
        ei = ei + 1

    used: list[bool] = []
    ui: int = 0
    while ui < len(expected_sigs):
        used.append(False)
        ui = ui + 1

    row_i: int = 0
    while row_i < joined_table.row_count():
        jrow: list[str] = joined_table.rows[row_i]
        if len(jrow) != expected_cols:
            return False
        # Key columns on both sides of the joined row must match each other
        if jrow[left_key_pos] != jrow[right_key_pos]:
            return False
        sig: str = table_row_signature(joined_table, row_i)
        found_match: bool = False
        mi: int = 0
        while mi < len(expected_sigs):
            if not used[mi] and expected_sigs[mi] == sig:
                used[mi] = True
                found_match = True
                break
            mi = mi + 1
        if not found_match:
            return False
        row_i = row_i + 1

    return True

def verify_inner_join_conservation(left: AtlasTable, right: AtlasTable, left_key: str, right_key: str) -> bool:
    joined: AtlasTable = inner_join_tables(left, right, left_key, right_key)
    return verify_inner_join_contract(left, right, left_key, right_key, joined)

def mutate_csv(raw_csv: str, prng: Prng) -> str:
    # Deterministic structure-aware CSV mutations for parser fuzzing
    mode: int = prng.choose_index(5)
    if mode == 0:
        # Delimiter substitution
        delims: list[str] = [";", "\t", "|", ":", "!"]
        d_idx: int = prng.choose_index(len(delims))
        return nox.strings.replace(raw_csv, ",", delims[d_idx])
    elif mode == 1:
        # Unclosed quote injection
        pos: int = prng.choose_index(len(raw_csv) + 1)
        return raw_csv[0:pos] + "\"" + raw_csv[pos:]
    elif mode == 2:
        # Malformed line breaks
        return nox.strings.replace(raw_csv, "\n", "\r")
    elif mode == 3:
        # Stray null byte injection
        pos3: int = prng.choose_index(len(raw_csv) + 1)
        return raw_csv[0:pos3] + "\x00" + raw_csv[pos3:]
    else:
        # Truncate midway
        if len(raw_csv) > 4:
            cutoff: int = prng.choose_index(len(raw_csv) - 2) + 1
            return raw_csv[0:cutoff]
        return raw_csv + ",\n"

def verify_sort_contract(input_table: AtlasTable, sorted_table: AtlasTable, sort_col: str, is_numeric: bool = False, ascending: bool = True) -> bool:
    # Output must be (1) same shape, (2) ordered by sort_col, (3) a permutation of the input rows (all cells)
    if sorted_table.row_count() != input_table.row_count() or sorted_table.col_count() != input_table.col_count():
        return False
    if input_table.col_index(sort_col) < 0:
        return False

    # Ordered check
    r: int = 0
    while r + 1 < sorted_table.row_count():
        a: str = sorted_table.get_cell(r, sort_col)
        b: str = sorted_table.get_cell(r + 1, sort_col)
        in_order: bool = True
        if is_numeric:
            try:
                an: int = int(a)
                bn: int = int(b)
                if ascending:
                    in_order = an <= bn
                else:
                    in_order = an >= bn
            except Exception as e:
                return False
        else:
            if ascending:
                in_order = a <= b
            else:
                in_order = a >= b
        if not in_order:
            return False
        r = r + 1

    # Permutation check (multiset of full rows + NULL flags)
    used: list[bool] = []
    u: int = 0
    while u < input_table.row_count():
        used.append(False)
        u = u + 1
    s: int = 0
    while s < sorted_table.row_count():
        sig: str = table_row_signature(sorted_table, s)
        matched: bool = False
        k: int = 0
        while k < input_table.row_count():
            if not used[k] and table_row_signature(input_table, k) == sig:
                used[k] = True
                matched = True
                break
            k = k + 1
        if not matched:
            return False
        s = s + 1
    return True

# Pluggable engine: a real Atlas implementation supplies these callbacks; Quartz verifies the
# results against independent ground truth. reference_atlas_engine() is the in-repo reference.
class AtlasEngine:
    name: str
    sort_fn: (AtlasTable, str, bool, bool) -> AtlasTable
    groupby_fn: (AtlasTable, str) -> AtlasTable
    join_fn: (AtlasTable, AtlasTable, str, str) -> AtlasTable

    def __init__(
        self: AtlasEngine,
        name: str,
        sort_fn: (AtlasTable, str, bool, bool) -> AtlasTable,
        groupby_fn: (AtlasTable, str) -> AtlasTable,
        join_fn: (AtlasTable, AtlasTable, str, str) -> AtlasTable
    ) -> None:
        self.name = name
        self.sort_fn = sort_fn
        self.groupby_fn = groupby_fn
        self.join_fn = join_fn

def reference_groupby(table: AtlasTable, group_col: str) -> AtlasTable:
    return groupby_count(table, group_col)

def reference_atlas_engine() -> AtlasEngine:
    return AtlasEngine("reference", sort_table, reference_groupby, inner_join_tables)

# Runs the engine against ground-truth contracts. Returns a list of failure descriptions (empty = all hold).
def run_atlas_engine_contract(
    engine: AtlasEngine,
    table: AtlasTable,
    sort_col: str,
    sort_numeric: bool,
    group_col: str,
    other: AtlasTable,
    left_key: str,
    right_key: str
) -> list[str]:
    failures: list[str] = []
    try:
        sorted_t: AtlasTable = engine.sort_fn(table, sort_col, sort_numeric, True)
        if not verify_sort_contract(table, sorted_t, sort_col, sort_numeric, True):
            failures.append(engine.name + ": sort contract violated")
    except Exception as e:
        failures.append(engine.name + ": sort raised " + str(e))
    try:
        grouped_t: AtlasTable = engine.groupby_fn(table, group_col)
        if not verify_groupby_contract(table, group_col, grouped_t):
            failures.append(engine.name + ": groupby contract violated")
    except Exception as e2:
        failures.append(engine.name + ": groupby raised " + str(e2))
    try:
        joined_t: AtlasTable = engine.join_fn(table, other, left_key, right_key)
        if not verify_inner_join_contract(table, other, left_key, right_key, joined_t):
            failures.append(engine.name + ": join contract violated")
    except Exception as e3:
        failures.append(engine.name + ": join raised " + str(e3))
    return failures

# ── Standard Library Tabular / DB Connectors (nox.csv & nox.db.Row) ──

# Parses CSV via NOX standard library `nox.csv.parse` into an AtlasTable.
def from_nox_csv(raw_csv: str) -> AtlasTable:
    parsed: list[list[str]] = nox.csv.parse(raw_csv)
    if len(parsed) == 0:
        return AtlasTable([], [])
    headers: list[str] = parsed[0]
    expected_cols: int = len(headers)
    data_rows: list[list[str]] = []
    r: int = 1
    while r < len(parsed):
        row: list[str] = parsed[r]
        while len(row) < expected_cols:
            row.append("")
        data_rows.append(row)
        r = r + 1
    return AtlasTable(headers, data_rows)

# Serializes an AtlasTable via NOX standard library `nox.csv.dump`.
def to_nox_csv(table: AtlasTable) -> str:
    all_rows: list[list[str]] = [table.headers]
    i: int = 0
    while i < len(table.rows):
        all_rows.append(table.rows[i])
        i = i + 1
    return nox.csv.dump(all_rows)

# Builds an AtlasTable from `nox.csv.parse_dicts` or external `list[dict[str, str]]` records.
def from_dict_records(headers: list[str], records: list[dict[str, str]]) -> AtlasTable:
    rows: list[list[str]] = []
    r: int = 0
    while r < len(records):
        rec: dict[str, str] = records[r]
        row: list[str] = []
        c: int = 0
        while c < len(headers):
            h: str = headers[c]
            if rec.contains(h):
                row.append(rec[h])
            else:
                row.append("")
            c = c + 1
        rows.append(row)
        r = r + 1
    return AtlasTable(headers, rows)

# Builds an AtlasTable directly from `nox.db.Row` query results (`conn.query(...)` or `nox.orm.select(...)`),
# preserving SQL NULL vs empty-string ("") cells via `null_mask`.
def from_db_rows(rows: list[Row]) -> AtlasTable:
    if len(rows) == 0:
        return AtlasTable([], [])
    headers: list[str] = []
    first_row: Row = rows[0]
    c: int = 0
    while c < first_row.column_count():
        headers.append(first_row.column_name(c))
        c = c + 1

    data_rows: list[list[str]] = []
    null_rows: list[list[bool]] = []
    r: int = 0
    while r < len(rows):
        db_row: Row = rows[r]
        vals: list[str] = []
        nulls: list[bool] = []
        vc: int = 0
        while vc < db_row.column_count():
            if db_row.is_null(vc):
                vals.append("")
                nulls.append(True)
            else:
                vals.append(db_row.get_str(vc))
                nulls.append(False)
            vc = vc + 1
        while len(vals) < len(headers):
            vals.append("")
            nulls.append(True)
        data_rows.append(vals)
        null_rows.append(nulls)
        r = r + 1
    out_t: AtlasTable = AtlasTable(headers, data_rows)
    out_t.null_mask = null_rows
    return out_t
