# Quartz Adapters — Atlas Tabular & DataFrame Ecosystem Adapter
# Bridges Atlas tabular data structures, CSV serialization, and invariants with Quartz.
# Quartz Core never depends on this adapter.

import nox.strings
from core.prng import Prng

class AtlasTable:
    headers: list[str]
    rows: list[list[str]]

    def __init__(self: AtlasTable, headers: list[str], rows: list[list[str]]) -> None:
        self.headers = headers
        self.rows = rows

    def row_count(self: AtlasTable) -> int:
        return len(self.rows)

    def col_count(self: AtlasTable) -> int:
        return len(self.headers)

    def col_index(self: AtlasTable, col_name: str) -> int:
        i: int = 0
        while i < len(self.headers):
            if self.headers[i] == col_name:
                return i
            i = i + 1
        return -1

    def get_cell(self: AtlasTable, row_idx: int, col_name: str) -> str:
        idx: int = self.col_index(col_name)
        if idx < 0 or row_idx < 0 or row_idx >= len(self.rows):
            return ""
        row: list[str] = self.rows[row_idx]
        if idx >= len(row):
            return ""
        return row[idx]

    def to_csv(self: AtlasTable, delimiter: str = ",", quote_char: str = "\"") -> str:
        res: str = ""
        # Write headers
        h_idx: int = 0
        while h_idx < len(self.headers):
            if h_idx > 0:
                res = res + delimiter
            res = res + escape_csv_field(self.headers[h_idx], delimiter, quote_char)
            h_idx = h_idx + 1
        res = res + "\n"

        # Write rows
        r_idx: int = 0
        while r_idx < len(self.rows):
            row: list[str] = self.rows[r_idx]
            c_idx: int = 0
            while c_idx < len(row):
                if c_idx > 0:
                    res = res + delimiter
                res = res + escape_csv_field(row[c_idx], delimiter, quote_char)
                c_idx = c_idx + 1
            res = res + "\n"
            r_idx = r_idx + 1
        return res

def escape_csv_field(field: str, delimiter: str, quote_char: str) -> str:
    needs_quotes: bool = False
    if nox.strings.contains(field, delimiter) or nox.strings.contains(field, quote_char) or nox.strings.contains(field, "\n") or nox.strings.contains(field, "\r"):
        needs_quotes = True

    if not needs_quotes:
        return field

    escaped: str = nox.strings.replace(field, quote_char, quote_char + quote_char)
    return quote_char + escaped + quote_char

def parse_csv(raw_csv: str, delimiter: str = ",", quote_char: str = "\"") -> AtlasTable:
    # State machine parser supporting quotes, delimiters, newlines, and double-quote escapes
    rows: list[list[str]] = []
    current_row: list[str] = []
    current_field: str = ""
    in_quotes: bool = False
    i: int = 0
    n: int = len(raw_csv)

    while i < n:
        ch: str = raw_csv[i:i+1]
        if in_quotes:
            if ch == quote_char:
                # Check for escaped quote (double quote)
                if (i + 1) < n and raw_csv[i+1:i+2] == quote_char:
                    current_field = current_field + quote_char
                    i = i + 1  # Skip second quote
                else:
                    in_quotes = False
            else:
                current_field = current_field + ch
        else:
            if ch == quote_char:
                in_quotes = True
            elif ch == delimiter:
                current_row.append(current_field)
                current_field = ""
            elif ch == "\r":
                # Check for CRLF
                if (i + 1) < n and raw_csv[i+1:i+2] == "\n":
                    i = i + 1
                current_row.append(current_field)
                current_field = ""
                if len(current_row) > 0:
                    rows.append(current_row)
                current_row = []
            elif ch == "\n":
                current_row.append(current_field)
                current_field = ""
                if len(current_row) > 0:
                    rows.append(current_row)
                current_row = []
            else:
                current_field = current_field + ch
        i = i + 1

    # End of text
    if len(current_field) > 0 or len(current_row) > 0:
        current_row.append(current_field)
        rows.append(current_row)

    if len(rows) == 0:
        return AtlasTable([], [])

    headers: list[str] = rows[0]
    data_rows: list[list[str]] = []
    r: int = 1
    while r < len(rows):
        data_rows.append(rows[r])
        r = r + 1

    return AtlasTable(headers, data_rows)

def sort_table(table: AtlasTable, sort_col: str, is_numeric: bool = False, ascending: bool = True) -> AtlasTable:
    idx: int = table.col_index(sort_col)
    if idx < 0:
        return table

    # Copy rows
    sorted_rows: list[list[str]] = []
    i: int = 0
    while i < len(table.rows):
        sorted_rows.append(table.rows[i])
        i = i + 1

    # Insertion sort
    p: int = 1
    while p < len(sorted_rows):
        key_row: list[str] = sorted_rows[p]
        key_val: str = key_row[idx]
        q: int = p - 1
        while q >= 0:
            cmp_row: list[str] = sorted_rows[q]
            cmp_val: str = cmp_row[idx]
            should_swap: bool = False
            if is_numeric:
                try:
                    k_num: int = int(key_val)
                    c_num: int = int(cmp_val)
                    if ascending:
                        should_swap = (k_num < c_num)
                    else:
                        should_swap = (k_num > c_num)
                except Exception as e:
                    if ascending:
                        should_swap = (key_val < cmp_val)
                    else:
                        should_swap = (key_val > cmp_val)
            else:
                if ascending:
                    should_swap = (key_val < cmp_val)
                else:
                    should_swap = (key_val > cmp_val)

            if should_swap:
                sorted_rows[q + 1] = sorted_rows[q]
                q = q - 1
            else:
                break
        sorted_rows[q + 1] = key_row
        p = p + 1

    return AtlasTable(table.headers, sorted_rows)

def verify_sort_idempotence(table: AtlasTable, sort_col: str, is_numeric: bool = False, ascending: bool = True) -> bool:
    t1: AtlasTable = sort_table(table, sort_col, is_numeric, ascending)
    t2: AtlasTable = sort_table(t1, sort_col, is_numeric, ascending)

    if t1.row_count() != t2.row_count():
        return False

    r: int = 0
    while r < t1.row_count():
        c: int = 0
        while c < t1.col_count():
            h: str = t1.headers[c]
            if t1.get_cell(r, h) != t2.get_cell(r, h):
                return False
            c = c + 1
        r = r + 1
    return True

def verify_csv_roundtrip(table: AtlasTable, delimiter: str = ",", quote_char: str = "\"") -> bool:
    csv_text: str = table.to_csv(delimiter, quote_char)
    rt_table: AtlasTable = parse_csv(csv_text, delimiter, quote_char)

    if rt_table.row_count() != table.row_count() or rt_table.col_count() != table.col_count():
        return False

    # Check headers
    h: int = 0
    while h < len(table.headers):
        if rt_table.headers[h] != table.headers[h]:
            return False
        h = h + 1

    # Check all cells
    r: int = 0
    while r < table.row_count():
        c: int = 0
        while c < table.col_count():
            col_name: str = table.headers[c]
            if rt_table.get_cell(r, col_name) != table.get_cell(r, col_name):
                return False
            c = c + 1
        r = r + 1

    return True

def verify_groupby_conservation(table: AtlasTable, group_col: str) -> bool:
    idx: int = table.col_index(group_col)
    if idx < 0:
        return False

    group_counts: list[int] = []
    group_keys: list[str] = []

    r: int = 0
    while r < table.row_count():
        key: str = table.get_cell(r, group_col)
        found: bool = False
        k: int = 0
        while k < len(group_keys):
            if group_keys[k] == key:
                group_counts[k] = group_counts[k] + 1
                found = True
                break
            k = k + 1
        if not found:
            group_keys.append(key)
            group_counts.append(1)
        r = r + 1

    total_grouped: int = 0
    g: int = 0
    while g < len(group_counts):
        total_grouped = total_grouped + group_counts[g]
        g = g + 1

    return total_grouped == table.row_count()

def verify_inner_join_conservation(left: AtlasTable, right: AtlasTable, left_key: str, right_key: str) -> bool:
    l_idx: int = left.col_index(left_key)
    r_idx: int = right.col_index(right_key)
    if l_idx < 0 or r_idx < 0:
        return False

    matches: int = 0
    i: int = 0
    while i < left.row_count():
        l_val: str = left.get_cell(i, left_key)
        j: int = 0
        while j < right.row_count():
            r_val: str = right.get_cell(j, right_key)
            if l_val == r_val:
                matches = matches + 1
            j = j + 1
        i = i + 1

    max_possible: int = left.row_count() * right.row_count()
    return matches >= 0 and matches <= max_possible

def mutate_csv(raw_csv: str, prng: Prng) -> str:
    # Deterministic structure-aware CSV mutations for parser fuzzing
    mode: int = prng.choose_index(5)
    if mode == 0:
        # Delimiter substitution
        delims: list[str] = [";", "\t", "|", ":", "!"]
        d_idx: int = prng.choose_index(len(delims))
        return nox.strings.replace(raw_csv, ",", delims[d_idx])
    elif mode == 1:
        # Unclosed quote injection
        pos: int = prng.choose_index(len(raw_csv) + 1)
        return raw_csv[0:pos] + "\"" + raw_csv[pos:]
    elif mode == 2:
        # Malformed line breaks
        return nox.strings.replace(raw_csv, "\n", "\r")
    elif mode == 3:
        # Stray null byte injection
        pos3: int = prng.choose_index(len(raw_csv) + 1)
        return raw_csv[0:pos3] + "\x00" + raw_csv[pos3:]
    else:
        # Truncate midway
        if len(raw_csv) > 4:
            cutoff: int = prng.choose_index(len(raw_csv) - 2) + 1
            return raw_csv[0:cutoff]
        return raw_csv + ",\n"
