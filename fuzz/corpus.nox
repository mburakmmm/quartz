import nox.fs
import nox.path
import nox.crypto
import nox.json
import nox.strings
from nox.json import JsonValue
from nox.path import PathError
from core.prng import hash_str_fnv
from core.report import escape_json, redact_secrets
from fuzz.harness import FuzzOutcome

def int_to_hex_8(n: int) -> str:
    digits: str = "0123456789abcdef"
    res: str = ""
    i: int = 0
    u: int = n & 4294967295
    while i < 8:
        shift: int = (7 - i) * 4
        nibble: int = (u >> shift) & 15
        res = res + digits[nibble:nibble + 1]
        i = i + 1
    return res

def ensure_dir(path: str) -> None:
    if not nox.fs.exists(path):
        nox.fs.create_dir_all(path)

def ensure_path_recursive(full_path: str) -> None:
    if not nox.fs.exists(full_path):
        nox.fs.create_dir_all(full_path)

def sanitize_corpus_target(target_name: str) -> str:
    if len(target_name) == 0 or nox.strings.contains(target_name, "..") or nox.strings.contains(target_name, "/") or nox.strings.contains(target_name, "\\"):
        raise AssertionError("SecurityError: corpus target name contains invalid path traversal characters: " + target_name)
    return target_name

def content_digest_id(content: str) -> str:
    full_hex: str = nox.crypto.blake3(content)
    return full_hex[0:16]

def sort_strings(xs: list[str]) -> list[str]:
    i: int = 1
    while i < len(xs):
        key: str = xs[i]
        j: int = i - 1
        while j >= 0 and xs[j] > key:
            xs[j + 1] = xs[j]
            j = j - 1
        xs[j + 1] = key
        i = i + 1
    return xs

class CorpusConfig:
    max_files: int
    max_total_bytes: int
    max_input_len: int

    def __init__(self: CorpusConfig, max_files: int, max_bytes: int, max_input_len: int) -> None:
        self.max_files = max_files
        self.max_total_bytes = max_bytes
        self.max_input_len = max_input_len

def default_corpus_config() -> CorpusConfig:
    return CorpusConfig(500, 5242880, 65536)

class CorpusManager:
    target_name: str
    root_dir: str
    base_dir: str
    seeds_dir: str
    crashes_dir: str
    timeouts_dir: str
    regressions_dir: str
    config: CorpusConfig
    seen_signatures: set[str]

    def __init__(self: CorpusManager, target_name: str, root_dir: str, config: CorpusConfig) -> None:
        clean_target: str = sanitize_corpus_target(target_name)
        self.target_name = clean_target
        self.root_dir = root_dir
        self.base_dir = root_dir + "/" + clean_target
        self.seeds_dir = self.base_dir + "/seeds"
        self.crashes_dir = self.base_dir + "/crashes"
        self.timeouts_dir = self.base_dir + "/timeouts"
        self.regressions_dir = self.base_dir + "/regressions"
        self.config = config
        self.seen_signatures = set()

    def ensure_directories(self: CorpusManager) -> None:
        ensure_dir(self.root_dir)
        try:
            confined_base: str = nox.path.safe_join(self.root_dir, self.target_name)
            ensure_dir(confined_base)
            self.base_dir = confined_base
            self.seeds_dir = nox.path.join(confined_base, "seeds")
            self.crashes_dir = nox.path.join(confined_base, "crashes")
            self.timeouts_dir = nox.path.join(confined_base, "timeouts")
            self.regressions_dir = nox.path.join(confined_base, "regressions")
        except PathError as pe:
            raise AssertionError("SecurityError: corpus path confinement failed: " + str(pe))
        ensure_dir(self.seeds_dir)
        ensure_dir(self.crashes_dir)
        ensure_dir(self.timeouts_dir)
        ensure_dir(self.regressions_dir)

    def is_new_signature(self: CorpusManager, signature: str) -> bool:
        if signature in self.seen_signatures:
            return False
        sigs: set[str] = self.seen_signatures
        sigs.add(signature)
        self.seen_signatures = sigs
        return True

    def get_seed_count(self: CorpusManager) -> int:
        if not nox.fs.exists(self.seeds_dir):
            return 0
        entries: list[str] = nox.fs.read_dir(self.seeds_dir)
        count: int = 0
        i: int = 0
        while i < len(entries):
            if nox.strings.ends_with(entries[i], ".bin"):
                count = count + 1
            i = i + 1
        return count

    def get_total_seed_bytes(self: CorpusManager) -> int:
        if not nox.fs.exists(self.seeds_dir):
            return 0
        entries: list[str] = nox.fs.read_dir(self.seeds_dir)
        total: int = 0
        i: int = 0
        while i < len(entries):
            if nox.strings.ends_with(entries[i], ".bin"):
                fpath: str = self.seeds_dir + "/" + entries[i]
                try:
                    meta: nox.fs.FileMetadata = nox.fs.metadata(fpath)
                    total = total + meta.size
                except Exception as e:
                    pass
            i = i + 1
        return total

    def get_crash_count(self: CorpusManager) -> int:
        if not nox.fs.exists(self.crashes_dir):
            return 0
        entries: list[str] = nox.fs.read_dir(self.crashes_dir)
        count: int = 0
        i: int = 0
        while i < len(entries):
            if nox.strings.ends_with(entries[i], ".json"):
                count = count + 1
            i = i + 1
        return count

    def add_seed(self: CorpusManager, content: str) -> bool:
        if len(content) > self.config.max_input_len:
            return False
        self.ensure_directories()

        # Hard bounds: max file count and max total bytes
        if self.get_seed_count() >= self.config.max_files:
            return False
        if self.get_total_seed_bytes() + len(content) > self.config.max_total_bytes:
            return False
        
        file_id: str = content_digest_id(content)
        path: str = nox.path.safe_join(self.seeds_dir, "seed_" + file_id + ".bin")
        if nox.fs.exists(path):
            return False
        
        nox.fs.write_string_atomic(path, content)
        return True

    def load_seeds(self: CorpusManager) -> list[str]:
        self.ensure_directories()
        res: list[str] = []
        raw_entries: list[str] = nox.fs.read_dir(self.seeds_dir)
        entries: list[str] = sort_strings(raw_entries)
        i: int = 0
        while i < len(entries):
            fname: str = entries[i]
            if nox.strings.ends_with(fname, ".bin"):
                fpath: str = self.seeds_dir + "/" + fname
                try:
                    c: str = nox.fs.read_to_string(fpath)
                    res.append(c)
                except Exception as e:
                    pass
            i = i + 1
        return res

    def save_crash_artifact(self: CorpusManager, input_data: str, outcome: FuzzOutcome, seed: int, case_index: int) -> str:
        self.ensure_directories()
        # Bound crash files to avoid disk exhaustion
        if self.get_crash_count() >= self.config.max_files:
            return ""

        full_blake3: str = nox.crypto.blake3(input_data)
        file_id: str = full_blake3[0:16]
        raw_path: str = nox.path.safe_join(self.crashes_dir, "crash_" + file_id + ".bin")
        json_path: str = nox.path.safe_join(self.crashes_dir, "crash_" + file_id + ".json")

        # Write raw binary/text payload
        nox.fs.write_string_atomic(raw_path, input_data)

        clean_sig: str = redact_secrets(outcome.signature)
        clean_err: str = redact_secrets(outcome.message)

        # Write JSON artifact descriptor with proper escaping and secret redaction
        json_content: str = "{\n"
        json_content = json_content + "  \"schema_version\": \"1\",\n"
        json_content = json_content + "  \"engine\": \"quartz\",\n"
        json_content = json_content + "  \"kind\": \"fuzz_crash\",\n"
        json_content = json_content + "  \"target\": \"" + escape_json(self.target_name) + "\",\n"
        json_content = json_content + "  \"status\": \"" + escape_json(outcome.status) + "\",\n"
        json_content = json_content + "  \"signature\": \"" + escape_json(clean_sig) + "\",\n"
        json_content = json_content + "  \"content_blake3\": \"" + full_blake3 + "\",\n"
        json_content = json_content + "  \"seed\": " + str(seed) + ",\n"
        json_content = json_content + "  \"case_index\": " + str(case_index) + ",\n"
        json_content = json_content + "  \"duration_ms\": " + str(outcome.duration_ms) + ",\n"
        json_content = json_content + "  \"input_bytes_file\": \"" + escape_json(raw_path) + "\",\n"
        json_content = json_content + "  \"error_message\": \"" + escape_json(clean_err) + "\"\n"
        json_content = json_content + "}\n"

        nox.fs.write_string_atomic(json_path, json_content)
        return json_path

    # Seals sensitive local crash reproducer payloads with ChaCha20-Poly1305 AEAD
    # so local crash corpora remain integrity-protected and encrypted at rest.
    def save_sealed_crash_artifact(self: CorpusManager, input_data: str, outcome: FuzzOutcome, seed: int, case_index: int, key_hex: str, nonce_hex: str = "") -> str:
        self.ensure_directories()
        if self.get_crash_count() >= self.config.max_files:
            return ""
        full_blake3: str = nox.crypto.blake3(input_data)
        file_id: str = full_blake3[0:16]
        eff_nonce: str = nonce_hex
        if len(eff_nonce) == 0:
            eff_nonce = nox.crypto.secure_random_hex(12)
        plaintext: str = input_data
        sealed_hex: str = nox.crypto.aead_seal(key_hex, eff_nonce, plaintext, "quartz:fuzz_crash:" + self.target_name)
        env_path: str = nox.path.safe_join(self.crashes_dir, "crash_" + file_id + ".aead.json")
        env_json: str = "{\n"
        env_json = env_json + "  \"schema_version\": \"1\",\n"
        env_json = env_json + "  \"kind\": \"quartz_sealed_crash\",\n"
        env_json = env_json + "  \"algorithm\": \"chacha20-poly1305\",\n"
        env_json = env_json + "  \"target\": \"" + escape_json(self.target_name) + "\",\n"
        env_json = env_json + "  \"signature\": \"" + escape_json(redact_secrets(outcome.signature)) + "\",\n"
        env_json = env_json + "  \"seed\": " + str(seed) + ",\n"
        env_json = env_json + "  \"case_index\": " + str(case_index) + ",\n"
        env_json = env_json + "  \"nonce_hex\": \"" + escape_json(eff_nonce) + "\",\n"
        env_json = env_json + "  \"ciphertext_hex\": \"" + escape_json(sealed_hex) + "\"\n"
        env_json = env_json + "}\n"
        nox.fs.write_string_atomic(env_path, env_json)
        return env_path

def open_sealed_crash_artifact(path: str, key_hex: str) -> str:
    raw: str = nox.fs.read_to_string(path)
    doc: JsonValue = nox.json.parse(raw)
    target: str = nox.json.as_string(nox.json.get(doc, "target"))
    nonce_hex: str = nox.json.as_string(nox.json.get(doc, "nonce_hex"))
    ciphertext_hex: str = nox.json.as_string(nox.json.get(doc, "ciphertext_hex"))
    return nox.crypto.aead_open(key_hex, nonce_hex, ciphertext_hex, "quartz:fuzz_crash:" + target)
