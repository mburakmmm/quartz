# Quartz Fuzz — Stateful Sequence Fuzzing Engine
# Generates and mutates ordered action sequences to fuzz state machines,
# protocols, and data structures, and shrinks failing sequences to minimal reproducers.

import nox.strings
from core.prng import Prng
from core.report import escape_json

class FuzzAction:
    name: str
    payload_str: str
    payload_int: int

    def __init__(self: FuzzAction, name: str, payload_str: str = "", payload_int: int = 0) -> None:
        self.name = name
        self.payload_str = payload_str
        self.payload_int = payload_int

    def clone(self: FuzzAction) -> FuzzAction:
        return FuzzAction(self.name, self.payload_str, self.payload_int)

    def to_str(self: FuzzAction) -> str:
        s: str = self.name + "("
        has_str: bool = len(self.payload_str) > 0
        if has_str:
            s = s + "\"" + self.payload_str + "\""
            if self.payload_int != 0:
                s = s + ", " + str(self.payload_int)
        elif self.payload_int != 0:
            s = s + str(self.payload_int)
        s = s + ")"
        return s

    def to_json(self: FuzzAction) -> str:
        return "{\"name\":\"" + escape_json(self.name) + "\",\"payload_str\":\"" + escape_json(self.payload_str) + "\",\"payload_int\":" + str(self.payload_int) + "}"

class ActionSequence:
    actions: list[FuzzAction]

    def __init__(self: ActionSequence, actions: list[FuzzAction] | None = None) -> None:
        if actions is None:
            self.actions = []
        else:
            self.actions = actions

    def len(self: ActionSequence) -> int:
        return len(self.actions)

    def append(self: ActionSequence, act: FuzzAction) -> None:
        self.actions.append(act)

    def get(self: ActionSequence, idx: int) -> FuzzAction:
        return self.actions[idx]

    def clone(self: ActionSequence) -> ActionSequence:
        res: list[FuzzAction] = []
        i: int = 0
        while i < len(self.actions):
            res.append(self.actions[i].clone())
            i = i + 1
        return ActionSequence(res)

    def remove_at(self: ActionSequence, idx: int) -> ActionSequence:
        res: list[FuzzAction] = []
        i: int = 0
        while i < len(self.actions):
            if i != idx:
                res.append(self.actions[i].clone())
            i = i + 1
        return ActionSequence(res)

    def swap(self: ActionSequence, i: int, j: int) -> None:
        if i >= 0 and i < len(self.actions) and j >= 0 and j < len(self.actions):
            tmp: FuzzAction = self.actions[i]
            self.actions[i] = self.actions[j]
            self.actions[j] = tmp

    def to_str(self: ActionSequence) -> str:
        if len(self.actions) == 0:
            return "[]"
        parts: list[str] = []
        i: int = 0
        while i < len(self.actions):
            parts.append(self.actions[i].to_str())
            i = i + 1
        return nox.strings.join(parts, " -> ")

    def to_json(self: ActionSequence) -> str:
        s: str = "["
        i: int = 0
        while i < len(self.actions):
            s = s + self.actions[i].to_json()
            if i + 1 < len(self.actions):
                s = s + ","
            i = i + 1
        s = s + "]"
        return s

class TransitionRule:
    from_action: str
    allowed_next: list[str]

    def __init__(self: TransitionRule, from_action: str, allowed_next: list[str]) -> None:
        self.from_action = from_action
        self.allowed_next = allowed_next

class SequenceFuzzer:
    prng: Prng
    action_names: list[str]
    min_length: int
    max_length: int
    rules: list[TransitionRule]
    initial_actions: list[str]

    def __init__(self: SequenceFuzzer, seed: int, action_names: list[str], min_length: int = 1, max_length: int = 10) -> None:
        self.prng = Prng(seed)
        self.action_names = action_names
        self.min_length = min_length
        self.max_length = max_length
        self.rules = []
        self.initial_actions = []

    # Declares which actions are valid as the FIRST action of a sequence (valid start states).
    def set_initial_actions(self: SequenceFuzzer, names: list[str]) -> None:
        self.initial_actions = names

    def is_valid_start(self: SequenceFuzzer, first_action: str) -> bool:
        if len(self.initial_actions) == 0:
            return True
        i: int = 0
        while i < len(self.initial_actions):
            if self.initial_actions[i] == first_action:
                return True
            i = i + 1
        return False

    # True when the sequence starts in a valid state and obeys every transition rule.
    def is_valid_sequence(self: SequenceFuzzer, seq: ActionSequence) -> bool:
        if seq.len() == 0:
            return True
        if not self.is_valid_start(seq.get(0).name):
            return False
        i: int = 0
        while i + 1 < seq.len():
            if not self.is_valid_transition(seq.get(i).name, seq.get(i + 1).name):
                return False
            i = i + 1
        return True

    def add_transition_rule(self: SequenceFuzzer, from_action: str, allowed_next: list[str]) -> None:
        self.rules.append(TransitionRule(from_action, allowed_next))

    def get_allowed_next(self: SequenceFuzzer, from_action: str) -> list[str]:
        i: int = 0
        while i < len(self.rules):
            if self.rules[i].from_action == from_action:
                return self.rules[i].allowed_next
            i = i + 1
        return self.action_names

    def generate_action_for_prev(self: SequenceFuzzer, prev_name: str) -> FuzzAction:
        pool: list[str] = self.action_names
        if len(prev_name) > 0:
            pool = self.get_allowed_next(prev_name)
        elif len(self.initial_actions) > 0:
            pool = self.initial_actions
        if len(pool) == 0:
            return FuzzAction("noop")
        idx: int = self.prng.choose_index(len(pool))
        name: str = pool[idx]
        val_int: int = self.prng.next_int_range(0, 100)
        val_str: str = "item_" + str(val_int)
        return FuzzAction(name, val_str, val_int)

    def generate_random_action(self: SequenceFuzzer) -> FuzzAction:
        return self.generate_action_for_prev("")

    def generate_random_sequence(self: SequenceFuzzer) -> ActionSequence:
        count: int = self.prng.next_int_range(self.min_length, self.max_length)
        res: ActionSequence = ActionSequence([])
        prev_act: str = ""
        i: int = 0
        while i < count:
            act: FuzzAction = self.generate_action_for_prev(prev_act)
            res.append(act)
            prev_act = act.name
            i = i + 1
        return res

    def mutate_sequence(self: SequenceFuzzer, seq: ActionSequence) -> ActionSequence:
        mutated: ActionSequence = seq.clone()
        mode: int = self.prng.next_int_range(0, 3)

        if mode == 0 and mutated.len() < self.max_length:
            # 1. Insert action respecting predecessor
            pos: int = self.prng.next_int_range(0, mutated.len())
            prev_n: str = ""
            if pos > 0:
                prev_n = mutated.get(pos - 1).name
            new_act: FuzzAction = self.generate_action_for_prev(prev_n)
            new_list: list[FuzzAction] = []
            k: int = 0
            while k < mutated.len():
                if k == pos:
                    new_list.append(new_act)
                new_list.append(mutated.get(k))
                k = k + 1
            if pos == mutated.len():
                new_list.append(new_act)
            mutated = ActionSequence(new_list)
        elif mode == 1 and mutated.len() > self.min_length:
            # 2. Delete action
            del_pos: int = self.prng.choose_index(mutated.len())
            mutated = mutated.remove_at(del_pos)
        elif mode == 2 and mutated.len() > 1:
            # 3. Swap two actions
            i1: int = self.prng.choose_index(mutated.len())
            i2: int = self.prng.choose_index(mutated.len())
            mutated.swap(i1, i2)
        else:
            # 4. Mutate payload of an existing action
            if mutated.len() > 0:
                p_idx: int = self.prng.choose_index(mutated.len())
                target_act: FuzzAction = mutated.get(p_idx)
                delta: int = self.prng.next_int_range(-5, 5)
                target_act.payload_int = target_act.payload_int + delta
                target_act.payload_str = "item_" + str(target_act.payload_int)

        return self.validate_and_repair_transitions(mutated)

    def is_valid_transition(self: SequenceFuzzer, from_action: str, to_action: str) -> bool:
        if len(self.rules) == 0:
            return True
        allowed: list[str] = self.get_allowed_next(from_action)
        i: int = 0
        while i < len(allowed):
            if allowed[i] == to_action:
                return True
            i = i + 1
        return False

    def validate_and_repair_transitions(self: SequenceFuzzer, seq: ActionSequence) -> ActionSequence:
        if (len(self.rules) == 0 and len(self.initial_actions) == 0) or seq.len() == 0:
            return seq

        repaired: ActionSequence = ActionSequence([])
        first: FuzzAction = seq.get(0)
        if not self.is_valid_start(first.name):
            first = self.generate_action_for_prev("")
        repaired.append(first)
        prev_name: str = first.name

        step: int = 1
        while step < seq.len():
            act: FuzzAction = seq.get(step)
            if self.is_valid_transition(prev_name, act.name):
                repaired.append(act)
                prev_name = act.name
            else:
                replacement: FuzzAction = self.generate_action_for_prev(prev_name)
                repaired.append(replacement)
                prev_name = replacement.name
            step = step + 1

        return repaired

class SequenceFuzzResult:
    found_failure: bool
    iterations_run: int
    failing_sequence: ActionSequence | None
    shrunk_sequence: ActionSequence | None

    def __init__(self: SequenceFuzzResult, found_failure: bool, iterations_run: int, failing_sequence: ActionSequence | None, shrunk_sequence: ActionSequence | None) -> None:
        self.found_failure = found_failure
        self.iterations_run = iterations_run
        self.failing_sequence = failing_sequence
        self.shrunk_sequence = shrunk_sequence

    def to_json(self: SequenceFuzzResult) -> str:
        s: str = "{"
        s = s + "\"found_failure\":" + ("true" if self.found_failure else "false") + ","
        s = s + "\"iterations_run\":" + str(self.iterations_run) + ","
        f_seq: ActionSequence | None = self.failing_sequence
        if f_seq is not None:
            s = s + "\"failing_sequence\":" + f_seq.to_json() + ","
        else:
            s = s + "\"failing_sequence\":null,"
        s_seq: ActionSequence | None = self.shrunk_sequence
        if s_seq is not None:
            s = s + "\"shrunk_sequence\":" + s_seq.to_json()
        else:
            s = s + "\"shrunk_sequence\":null"
        s = s + "}"
        return s

def seq_acceptable(cand: ActionSequence, validator: (ActionSequence) -> bool) -> bool:
    return validator(cand)

def always_valid_sequence(seq: ActionSequence) -> bool:
    return True

# Shrinks while preserving validity (transition rules / valid start) via the supplied validator.
# IMPORTANT: validator is evaluated BEFORE target_runner so side-effecting targets are never invoked
# on invalid candidate sequences.
def shrink_valid_sequence(seq: ActionSequence, target_runner: (ActionSequence) -> bool, validator: (ActionSequence) -> bool, max_steps: int = 100) -> ActionSequence:
    curr: ActionSequence = seq.clone()
    step: int = 0

    # Phase 1: Delta-debugging chunk deletion
    # Try halving: remove first half, remove second half
    if curr.len() >= 4 and step < max_steps:
        mid: int = curr.len() // 2
        # Try second half only
        cand_half2: list[FuzzAction] = []
        h_i: int = mid
        while h_i < curr.len():
            cand_half2.append(curr.get(h_i).clone())
            h_i = h_i + 1
        seq_half2: ActionSequence = ActionSequence(cand_half2)
        if seq_acceptable(seq_half2, validator):
            step = step + 1
            passed_h2: bool = True
            try:
                passed_h2 = target_runner(seq_half2)
            except Exception as e:
                passed_h2 = False
            if not passed_h2:
                curr = seq_half2

        if curr.len() >= 4 and step < max_steps:
            # Try first half only
            cand_half1: list[FuzzAction] = []
            h_j: int = 0
            while h_j < mid:
                cand_half1.append(curr.get(h_j).clone())
                h_j = h_j + 1
            seq_half1: ActionSequence = ActionSequence(cand_half1)
            if seq_acceptable(seq_half1, validator):
                step = step + 1
                passed_h1: bool = True
                try:
                    passed_h1 = target_runner(seq_half1)
                except Exception as e:
                    passed_h1 = False
                if not passed_h1:
                    curr = seq_half1

    # Phase 2: Single action deletion (1-by-1 from right to left)
    improved: bool = True
    while improved and step < max_steps:
        improved = False
        if curr.len() <= 1:
            break

        i: int = curr.len() - 1
        while i >= 0 and step < max_steps:
            candidate: ActionSequence = curr.remove_at(i)
            if not seq_acceptable(candidate, validator):
                i = i - 1
                continue

            step = step + 1
            passed: bool = True
            try:
                passed = target_runner(candidate)
            except Exception as e:
                passed = False

            if not passed:
                curr = candidate
                improved = True
                break
            i = i - 1

    # Phase 3: Payload integer shrinking towards 0
    p_i: int = 0
    while p_i < curr.len() and step < max_steps:
        act: FuzzAction = curr.get(p_i)
        if act.payload_int != 0:
            orig_val: int = act.payload_int
            # Try setting payload_int to 0
            act.payload_int = 0
            if seq_acceptable(curr, validator):
                step = step + 1
                passed_zero: bool = True
                try:
                    passed_zero = target_runner(curr)
                except Exception as e:
                    passed_zero = False

                if passed_zero:
                    # 0 did not fail; try halving (binary search towards 0)
                    half_val: int = orig_val // 2
                    act.payload_int = half_val
                    if seq_acceptable(curr, validator):
                        step = step + 1
                        passed_half: bool = True
                        try:
                            passed_half = target_runner(curr)
                        except Exception as e:
                            passed_half = False

                        if passed_half:
                            act.payload_int = orig_val
                    else:
                        act.payload_int = orig_val
            else:
                act.payload_int = orig_val
        p_i = p_i + 1

    return curr

def shrink_failing_sequence(seq: ActionSequence, target_runner: (ActionSequence) -> bool, max_steps: int = 100) -> ActionSequence:
    return shrink_valid_sequence(seq, target_runner, always_valid_sequence, max_steps)

def run_sequence_fuzz(fuzzer: SequenceFuzzer, target_runner: (ActionSequence) -> bool, iterations: int = 100, shrink: bool = True) -> SequenceFuzzResult:
    current_seq: ActionSequence = fuzzer.generate_random_sequence()
    it: int = 0

    # Shrinking never leaves the valid state space: transition rules + valid start are preserved
    def fuzzer_validator(s: ActionSequence) -> bool:
        return fuzzer.is_valid_sequence(s)

    while it < iterations:
        it = it + 1
        if it % 2 == 0:
            current_seq = fuzzer.generate_random_sequence()
        else:
            current_seq = fuzzer.mutate_sequence(current_seq)

        passed: bool = True
        try:
            passed = target_runner(current_seq)
        except Exception as e:
            passed = False

        if not passed:
            shrunk: ActionSequence = current_seq
            if shrink:
                shrunk = shrink_valid_sequence(current_seq, target_runner, fuzzer_validator)
            return SequenceFuzzResult(True, it, current_seq, shrunk)

    return SequenceFuzzResult(False, it, None, None)

# Model-based testing: explicit model state (int) with precondition / transition / postcondition.
class StateModel:
    initial_state: int
    precondition: (int, FuzzAction) -> bool
    apply_fn: (int, FuzzAction) -> int
    postcondition: (int, FuzzAction, int) -> bool

    def __init__(
        self: StateModel,
        initial_state: int,
        precondition: (int, FuzzAction) -> bool,
        apply_fn: (int, FuzzAction) -> int,
        postcondition: (int, FuzzAction, int) -> bool
    ) -> None:
        self.initial_state = initial_state
        self.precondition = precondition
        self.apply_fn = apply_fn
        self.postcondition = postcondition

# Executes a sequence against the model.
# When fail_on_precondition=False (default), actions whose precondition does not hold are skipped.
# When fail_on_precondition=True, a violated precondition is treated as a protocol/generator violation.
# Returns "" when every condition holds, else a description of the first violation.
def run_model_sequence(model: StateModel, seq: ActionSequence, fail_on_precondition: bool = False) -> str:
    state: int = model.initial_state
    i: int = 0
    while i < seq.len():
        act: FuzzAction = seq.get(i)
        if model.precondition(state, act):
            new_state: int = model.apply_fn(state, act)
            if not model.postcondition(state, act, new_state):
                return "postcondition violated at step " + str(i) + " (" + act.name + ") state " + str(state) + " -> " + str(new_state)
            state = new_state
        elif fail_on_precondition:
            return "precondition violated at step " + str(i) + " (" + act.name + ") in state " + str(state)
        i = i + 1
    return ""

def model_sequence_runner(model: StateModel, fail_on_precondition: bool = False) -> (ActionSequence) -> bool:
    def runner(seq: ActionSequence) -> bool:
        return len(run_model_sequence(model, seq, fail_on_precondition)) == 0
    return runner

# Runs a real System-Under-Test (SUT) alongside the reference StateModel and compares SUT observable
# state against model state after every applicable action step.
def run_sut_against_model(
    model: StateModel,
    sut_reset: () -> None,
    sut_step: (FuzzAction) -> int,
    seq: ActionSequence,
    fail_on_precondition: bool = False
) -> str:
    sut_reset()
    state: int = model.initial_state
    i: int = 0
    while i < seq.len():
        act: FuzzAction = seq.get(i)
        if model.precondition(state, act):
            expected_state: int = model.apply_fn(state, act)
            if not model.postcondition(state, act, expected_state):
                return "postcondition violated at step " + str(i) + " (" + act.name + ") state " + str(state) + " -> " + str(expected_state)
            actual_sut_state: int = sut_step(act)
            if actual_sut_state != expected_state:
                return "SUT state divergence at step " + str(i) + " (" + act.name + "): expected=" + str(expected_state) + " actual=" + str(actual_sut_state)
            state = expected_state
        elif fail_on_precondition:
            return "precondition violated at step " + str(i) + " (" + act.name + ") in state " + str(state)
        i = i + 1
    return ""

def sut_model_runner(
    model: StateModel,
    sut_reset: () -> None,
    sut_step: (FuzzAction) -> int,
    fail_on_precondition: bool = False
) -> (ActionSequence) -> bool:
    def runner(seq: ActionSequence) -> bool:
        return len(run_sut_against_model(model, sut_reset, sut_step, seq, fail_on_precondition)) == 0
    return runner
