# Quartz Load — Bounded Latency Metrics & Histograms
# High-precision logarithmic-linear histogram spanning 0ms to 60,000ms (60 seconds)
# with 246 fixed buckets, guaranteeing bounded O(1) memory and accurate percentiles.

import nox.time
import nox.mem
from nox.time import Instant
from nox.mem import MemStats
from core.report import escape_json

HISTOGRAM_NUM_BUCKETS: int = 246
HISTOGRAM_OVERFLOW_INDEX: int = 245

US_HISTOGRAM_NUM_BUCKETS: int = 336
US_HISTOGRAM_OVERFLOW_INDEX: int = 335

def get_us_bucket_index(latency_us: int) -> int:
    if latency_us <= 0:
        return 0
    if latency_us < 1000:
        # 0 - 999 us: 20 us resolution (50 buckets: 0..49)
        return latency_us // 20
    if latency_us < 10000:
        # 1,000 - 9,999 us: 200 us resolution (45 buckets: 50..94)
        return 50 + (latency_us - 1000) // 200
    if latency_us < 100000:
        # 10,000 - 99,999 us (10 - 99.9 ms): 2,000 us resolution (45 buckets: 95..139)
        return 95 + (latency_us - 10000) // 2000
    if latency_us < 1000000:
        # 100,000 - 999,999 us (100 - 999.9 ms): 20,000 us resolution (45 buckets: 140..184)
        return 140 + (latency_us - 100000) // 20000
    if latency_us < 5000000:
        # 1,000,000 - 4,999,999 us (1 - 4.999 s): 100,000 us resolution (40 buckets: 185..224)
        return 185 + (latency_us - 1000000) // 100000
    if latency_us < 60000000:
        # 5,000,000 - 59,999,999 us (5 - 59.999 s): 500,000 us resolution (110 buckets: 225..334)
        return 225 + (latency_us - 5000000) // 500000
    return US_HISTOGRAM_OVERFLOW_INDEX

def get_us_bucket_midpoint(idx: int) -> int:
    if idx <= 0:
        return 10
    if idx < 50:
        return idx * 20 + 10
    if idx < 95:
        return 1000 + (idx - 50) * 200 + 100
    if idx < 140:
        return 10000 + (idx - 95) * 2000 + 1000
    if idx < 185:
        return 100000 + (idx - 140) * 20000 + 10000
    if idx < 225:
        return 1000000 + (idx - 185) * 100000 + 50000
    if idx < 335:
        return 5000000 + (idx - 225) * 500000 + 250000
    return 60000000

def compute_interval_overlap_peak(starts_ns: list[int], ends_ns: list[int]) -> int:
    n: int = len(starts_ns)
    if len(ends_ns) < n:
        n = len(ends_ns)
    if n <= 0:
        return 0
    best: int = 1
    i: int = 0
    while i < n:
        t: int = starts_ns[i]
        active_at_t: int = 0
        j: int = 0
        while j < n:
            sj: int = starts_ns[j]
            ej: int = ends_ns[j]
            if ej <= sj:
                ej = sj + 1
            if sj <= t and t < ej:
                active_at_t = active_at_t + 1
            j = j + 1
        if active_at_t > best:
            best = active_at_t
        i = i + 1
    return best

def get_bucket_index(latency_ms: int) -> int:
    if latency_ms <= 0:
        return 0
    if latency_ms < 100:
        # 0 - 99ms: 2ms resolution (50 buckets: 0..49)
        return latency_ms // 2
    if latency_ms < 1000:
        # 100 - 999ms: 20ms resolution (45 buckets: 50..94)
        return 50 + (latency_ms - 100) // 20
    if latency_ms < 5000:
        # 1000 - 4999ms: 100ms resolution (40 buckets: 95..134)
        return 95 + (latency_ms - 1000) // 100
    if latency_ms < 60000:
        # 5000 - 59999ms: 500ms resolution (110 buckets: 135..244)
        return 135 + (latency_ms - 5000) // 500
    # >= 60000ms: overflow bucket (bucket 245)
    return HISTOGRAM_OVERFLOW_INDEX

def get_bucket_midpoint(idx: int) -> int:
    if idx <= 0:
        return 1
    if idx < 50:
        return idx * 2 + 1
    if idx < 95:
        return 100 + (idx - 50) * 20 + 10
    if idx < 135:
        return 1000 + (idx - 95) * 100 + 50
    if idx < 245:
        return 5000 + (idx - 135) * 500 + 250
    return 60000

class LoadMetrics:
    scheduled: int
    completed: int
    successful: int
    failed: int
    timed_out: int
    rejected: int
    overflow_count: int
    min_latency_ms: int
    max_latency_ms: int
    sum_latency_ms: int
    min_latency_ns: int
    max_latency_ns: int
    sum_latency_ns: int
    peak_concurrency: int
    peak_active_vus: int
    peak_overlapping_executions: int
    buckets: list[int]
    us_buckets: list[int]

    def __init__(self: LoadMetrics) -> None:
        self.scheduled = 0
        self.completed = 0
        self.successful = 0
        self.failed = 0
        self.timed_out = 0
        self.rejected = 0
        self.overflow_count = 0
        self.min_latency_ms = -1
        self.max_latency_ms = 0
        self.sum_latency_ms = 0
        self.min_latency_ns = -1
        self.max_latency_ns = 0
        self.sum_latency_ns = 0
        self.peak_concurrency = 0
        self.peak_active_vus = 0
        self.peak_overlapping_executions = 0

        # Initialize 246 ms buckets to 0
        b: list[int] = []
        i: int = 0
        while i < HISTOGRAM_NUM_BUCKETS:
            b.append(0)
            i = i + 1
        self.buckets = b

        # Initialize 336 microsecond HDR-style buckets to 0
        ub: list[int] = []
        ui: int = 0
        while ui < US_HISTOGRAM_NUM_BUCKETS:
            ub.append(0)
            ui = ui + 1
        self.us_buckets = ub

    def record_scheduled(self: LoadMetrics) -> None:
        self.scheduled = self.scheduled + 1

    def record_rejected(self: LoadMetrics) -> None:
        self.rejected = self.rejected + 1

    def record_concurrency(self: LoadMetrics, active_count: int) -> None:
        if active_count > self.peak_concurrency:
            self.peak_concurrency = active_count

    def record_active_vus(self: LoadMetrics, active_vu_count: int) -> None:
        if active_vu_count > self.peak_active_vus:
            self.peak_active_vus = active_vu_count

    def record_execution_spans(self: LoadMetrics, starts_ns: list[int], ends_ns: list[int]) -> int:
        ov: int = compute_interval_overlap_peak(starts_ns, ends_ns)
        if ov > self.peak_overlapping_executions:
            self.peak_overlapping_executions = ov
        return ov

    def _record_internal(self: LoadMetrics, status: int, duration_ms: int, duration_ns: int, is_timeout: bool, is_success: bool) -> None:
        self.completed = self.completed + 1
        if is_timeout:
            self.timed_out = self.timed_out + 1
            self.failed = self.failed + 1
            return

        if not is_success or status >= 400:
            self.failed = self.failed + 1
            return

        self.successful = self.successful + 1
        self.sum_latency_ms = self.sum_latency_ms + duration_ms
        self.sum_latency_ns = self.sum_latency_ns + duration_ns

        if self.min_latency_ms < 0 or duration_ms < self.min_latency_ms:
            self.min_latency_ms = duration_ms
        if duration_ms > self.max_latency_ms:
            self.max_latency_ms = duration_ms

        if self.min_latency_ns < 0 or duration_ns < self.min_latency_ns:
            self.min_latency_ns = duration_ns
        if duration_ns > self.max_latency_ns:
            self.max_latency_ns = duration_ns

        # Record into bounded ms and us histograms
        b_idx: int = get_bucket_index(duration_ms)
        self.buckets[b_idx] = self.buckets[b_idx] + 1
        if b_idx == HISTOGRAM_OVERFLOW_INDEX:
            self.overflow_count = self.overflow_count + 1
        dur_us: int = duration_ns // 1000
        if dur_us < 0:
            dur_us = 0
        us_idx: int = get_us_bucket_index(dur_us)
        self.us_buckets[us_idx] = self.us_buckets[us_idx] + 1

    def record_result(self: LoadMetrics, status: int, duration_ms: int, is_timeout: bool, is_success: bool) -> None:
        ns_est: int = duration_ms * 1000000
        if ns_est < 0:
            ns_est = 0
        self._record_internal(status, duration_ms, ns_est, is_timeout, is_success)

    def record_result_ns(self: LoadMetrics, status: int, duration_ns: int, is_timeout: bool, is_success: bool) -> None:
        clean_ns: int = duration_ns if duration_ns >= 0 else 0
        dur_ms: int = clean_ns // 1000000
        self._record_internal(status, dur_ms, clean_ns, is_timeout, is_success)

    def percentile(self: LoadMetrics, p: float) -> int:
        if self.successful <= 0:
            return 0
        
        # Nearest-rank method: ceil(N * p / 100.0)
        # Using exact integer arithmetic scaled by 10000 to preserve fractional percentiles (e.g. 99.9%):
        p_x100: int = int(p * 100.0 + 0.5)
        target_count: int = (self.successful * p_x100 + 9999) // 10000
        if target_count < 1:
            target_count = 1
        if target_count > self.successful:
            target_count = self.successful

        accum: int = 0
        idx: int = 0
        while idx < HISTOGRAM_NUM_BUCKETS:
            accum = accum + self.buckets[idx]
            if accum >= target_count:
                # If target falls into overflow bucket (>60s), use actual max_latency_ms
                if idx == HISTOGRAM_OVERFLOW_INDEX and self.max_latency_ms > 60000:
                    return self.max_latency_ms
                return get_bucket_midpoint(idx)
            idx = idx + 1

        return self.max_latency_ms

    def p50(self: LoadMetrics) -> int:
        return self.percentile(50.0)

    def p90(self: LoadMetrics) -> int:
        return self.percentile(90.0)

    def p95(self: LoadMetrics) -> int:
        return self.percentile(95.0)

    def p99(self: LoadMetrics) -> int:
        return self.percentile(99.0)

    def percentile_us(self: LoadMetrics, p: float) -> int:
        if self.successful <= 0:
            return 0
        p_x100: int = int(p * 100.0 + 0.5)
        target_count: int = (self.successful * p_x100 + 9999) // 10000
        if target_count < 1:
            target_count = 1
        if target_count > self.successful:
            target_count = self.successful

        accum: int = 0
        idx: int = 0
        while idx < US_HISTOGRAM_NUM_BUCKETS:
            accum = accum + self.us_buckets[idx]
            if accum >= target_count:
                if idx == US_HISTOGRAM_OVERFLOW_INDEX and self.max_latency_us() > 60000000:
                    return self.max_latency_us()
                return get_us_bucket_midpoint(idx)
            idx = idx + 1
        return self.max_latency_us()

    def p50_us(self: LoadMetrics) -> int:
        return self.percentile_us(50.0)

    def p90_us(self: LoadMetrics) -> int:
        return self.percentile_us(90.0)

    def p95_us(self: LoadMetrics) -> int:
        return self.percentile_us(95.0)

    def p99_us(self: LoadMetrics) -> int:
        return self.percentile_us(99.0)

    def mean_latency_ms(self: LoadMetrics) -> float:
        if self.successful <= 0:
            return 0.0
        return float(self.sum_latency_ms) / float(self.successful)

    def min_latency_us(self: LoadMetrics) -> int:
        if self.min_latency_ns < 0:
            return 0
        return self.min_latency_ns // 1000

    def max_latency_us(self: LoadMetrics) -> int:
        if self.max_latency_ns <= 0:
            return 0
        return self.max_latency_ns // 1000

    def mean_latency_us(self: LoadMetrics) -> float:
        if self.successful <= 0:
            return 0.0
        return (float(self.sum_latency_ns) / 1000.0) / float(self.successful)

    def throughput_rps(self: LoadMetrics, total_duration_ms: int) -> float:
        if self.completed <= 0:
            return 0.0
        dur_ms: int = total_duration_ms
        if dur_ms < 1:
            dur_ms = 1
        sec: float = float(dur_ms) / 1000.0
        return float(self.completed) / sec

    def error_rate(self: LoadMetrics) -> float:
        if self.completed <= 0:
            return 0.0
        return float(self.failed) / float(self.completed)

    def unfulfilled_rate(self: LoadMetrics) -> float:
        total: int = self.completed + self.rejected
        if total <= 0:
            return 0.0
        return float(self.failed + self.rejected) / float(total)

    def to_json(self: LoadMetrics, total_duration_ms: int) -> str:
        s: str = "{"
        s = s + "\"scheduled\": " + str(self.scheduled) + ", "
        s = s + "\"completed\": " + str(self.completed) + ", "
        s = s + "\"successful\": " + str(self.successful) + ", "
        s = s + "\"failed\": " + str(self.failed) + ", "
        s = s + "\"timed_out\": " + str(self.timed_out) + ", "
        s = s + "\"rejected\": " + str(self.rejected) + ", "
        s = s + "\"overflow_count\": " + str(self.overflow_count) + ", "
        s = s + "\"min_latency_ms\": " + str(self.min_latency_ms if self.min_latency_ms >= 0 else 0) + ", "
        s = s + "\"max_latency_ms\": " + str(self.max_latency_ms) + ", "
        s = s + "\"mean_latency_ms\": " + str(self.mean_latency_ms()) + ", "
        s = s + "\"min_latency_us\": " + str(self.min_latency_us()) + ", "
        s = s + "\"max_latency_us\": " + str(self.max_latency_us()) + ", "
        s = s + "\"mean_latency_us\": " + str(self.mean_latency_us()) + ", "
        s = s + "\"p50_latency_ms\": " + str(self.p50()) + ", "
        s = s + "\"p90_latency_ms\": " + str(self.p90()) + ", "
        s = s + "\"p95_latency_ms\": " + str(self.p95()) + ", "
        s = s + "\"p99_latency_ms\": " + str(self.p99()) + ", "
        s = s + "\"p50_latency_us\": " + str(self.p50_us()) + ", "
        s = s + "\"p90_latency_us\": " + str(self.p90_us()) + ", "
        s = s + "\"p95_latency_us\": " + str(self.p95_us()) + ", "
        s = s + "\"p99_latency_us\": " + str(self.p99_us()) + ", "
        s = s + "\"throughput_rps\": " + str(self.throughput_rps(total_duration_ms)) + ", "
        s = s + "\"error_rate\": " + str(self.error_rate()) + ", "
        s = s + "\"unfulfilled_rate\": " + str(self.unfulfilled_rate()) + ", "
        s = s + "\"peak_active_vus\": " + str(self.peak_active_vus) + ", "
        s = s + "\"peak_overlapping_executions\": " + str(self.peak_overlapping_executions) + ", "
        s = s + "\"peak_concurrency\": " + str(self.peak_concurrency)
        s = s + "}"
        return s

class MemDelta:
    allocations: int
    frees: int
    live: int
    bytes_allocated: int

    def __init__(self: MemDelta, allocations: int, frees: int, bytes_allocated: int) -> None:
        self.allocations = allocations
        self.frees = frees
        self.live = allocations - frees
        self.bytes_allocated = bytes_allocated

    def to_json(self: MemDelta) -> str:
        return "{\"allocations\": " + str(self.allocations) + ", \"frees\": " + str(self.frees) + ", \"live\": " + str(self.live) + ", \"bytes_allocated\": " + str(self.bytes_allocated) + "}"

def capture_mem_baseline() -> MemStats:
    return nox.mem.stats()

def compute_mem_delta(baseline: MemStats, current: MemStats) -> MemDelta:
    d_alloc: int = current.allocations - baseline.allocations
    d_free: int = current.frees - baseline.frees
    d_bytes: int = current.bytes_allocated - baseline.bytes_allocated
    return MemDelta(d_alloc, d_free, d_bytes)
