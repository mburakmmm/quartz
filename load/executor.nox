def bool_to_json(b: bool) -> str:
    if b:
        return "true"
    return "false"

class VirtualUserState:
    vu_id: int
    completed: int
    successful: int
    failed: int
    total_latency_ms: int

    def __init__(self: VirtualUserState, vu_id: int) -> None:
        self.vu_id = vu_id
        self.completed = 0
        self.successful = 0
        self.failed = 0
        self.total_latency_ms = 0

    def record(self: VirtualUserState, latency_ms: int, success: bool) -> None:
        self.completed = self.completed + 1
        self.total_latency_ms = self.total_latency_ms + latency_ms
        if success:
            self.successful = self.successful + 1
        else:
            self.failed = self.failed + 1

    def to_json(self: VirtualUserState) -> str:
        s: str = "{"
        s = s + "\"vu_id\": " + str(self.vu_id) + ", "
        s = s + "\"completed\": " + str(self.completed) + ", "
        s = s + "\"successful\": " + str(self.successful) + ", "
        s = s + "\"failed\": " + str(self.failed) + ", "
        s = s + "\"total_latency_ms\": " + str(self.total_latency_ms)
        s = s + "}"
        return s

class LoadTestSummary:
    workload_name: str
    metrics: LoadMetrics
    threshold_results: list[ThresholdResult]
    total_duration_ms: int
    all_passed: bool
    aborted: bool
    abort_reason: str
    virtual_users: list[VirtualUserState]

    def __init__(self: LoadTestSummary, workload_name: str, metrics: LoadMetrics, threshold_results: list[ThresholdResult], total_duration_ms: int, all_passed: bool, aborted: bool, abort_reason: str, virtual_users: list[VirtualUserState]) -> None:
        self.workload_name = workload_name
        self.metrics = metrics
        self.threshold_results = threshold_results
        self.total_duration_ms = total_duration_ms
        self.all_passed = all_passed
        self.aborted = aborted
        self.abort_reason = abort_reason
        self.virtual_users = virtual_users

    def to_json(self: LoadTestSummary) -> str:
        s: str = "{\n"
        s = s + "  \"schema_version\": \"1\",\n"
        s = s + "  \"engine\": \"quartz\",\n"
        s = s + "  \"kind\": \"load_test\",\n"
        s = s + "  \"workload_name\": \"" + escape_json(self.workload_name) + "\",\n"
        s = s + "  \"all_passed\": " + bool_to_json(self.all_passed) + ",\n"
        s = s + "  \"aborted\": " + bool_to_json(self.aborted) + ",\n"
        s = s + "  \"abort_reason\": \"" + escape_json(self.abort_reason) + "\",\n"
        s = s + "  \"total_duration_ms\": " + str(self.total_duration_ms) + ",\n"
        s = s + "  \"metrics\": " + self.metrics.to_json(self.total_duration_ms) + ",\n"
        s = s + "  \"virtual_users\": [\n"
        idx: int = 0
        while idx < len(self.virtual_users):
            s = s + "    " + self.virtual_users[idx].to_json()
            if idx + 1 < len(self.virtual_users):
                s = s + ","
            s = s + "\n"
            idx = idx + 1
        s = s + "  ]\n"
        s = s + "}\n"
        return s

def _update_atomic_peak(peak_cell: AtomicInt, cur_val: int) -> None:
    prev: int = peak_cell.load()
    while cur_val > prev:
        if peak_cell.compare_and_swap(prev, cur_val):
            break
        prev = peak_cell.load()

def _release_wave_atomics(active_h: int, peak_h: int, done_h: int, dur_h: int, cancel_h: int, ref_h: int) -> bool:
    ref_c: AtomicInt = AtomicInt(ref_h)
    rem: int = ref_c.decrement()
    if rem == 0:
        AtomicInt(active_h).free()
        AtomicInt(peak_h).free()
        AtomicInt(done_h).free()
        AtomicInt(dur_h).free()
        AtomicInt(cancel_h).free()
        ref_c.free()
        return True
    return False

async def _vu_fiber_task(
    quota: int,
    work_ms: int,
    active_h: int,
    peak_h: int,
    cancel_h: int,
    ready_ch: Channel[int],
    go_ch: Channel[int],
    done_ch: Channel[int]
) -> None:
    active_c: AtomicInt = AtomicInt(active_h)
    peak_c: AtomicInt = AtomicInt(peak_h)
    cancel_c: AtomicInt = AtomicInt(cancel_h)

    cur_active: int = active_c.increment()
    _update_atomic_peak(peak_c, cur_active)

    # Signal ready to coordinator and suspend fiber (yielding worker thread without blocking OS thread)
    await ready_ch.send(1)
    _go: int = await go_ch.recv()

    _update_atomic_peak(peak_c, active_c.load())

    total_elapsed: int = 0
    step: int = 0
    while step < quota and cancel_c.load() == 0:
        t_start: Instant = nox.time.instant_now()
        if work_ms > 0:
            nox.time.sleep_ms(work_ms)
        total_elapsed = total_elapsed + t_start.elapsed_ms()
        step = step + 1

    active_c.decrement()
    await done_ch.send(total_elapsed)

async def _run_concurrent_vu_fibers(cfg_str: str) -> int:
    parts: list[str] = nox.strings.split(cfg_str, ",")
    vu_count: int = int(parts[0])
    total_cases: int = int(parts[1])
    work_ms: int = int(parts[2])
    active_h: int = int(parts[3])
    peak_h: int = int(parts[4])
    done_h: int = int(parts[5])
    dur_h: int = int(parts[6])
    cancel_h: int = int(parts[7])
    ref_h: int = int(parts[8])
    hold_until_cancel: int = int(parts[9])

    active_c: AtomicInt = AtomicInt(active_h)
    peak_c: AtomicInt = AtomicInt(peak_h)
    done_c: AtomicInt = AtomicInt(done_h)
    dur_c: AtomicInt = AtomicInt(dur_h)
    cancel_c: AtomicInt = AtomicInt(cancel_h)

    ready_ch: Channel[int] = Channel[int](64)
    go_ch: Channel[int] = Channel[int](64)
    done_ch: Channel[int] = Channel[int](64)

    base_q: int = total_cases // vu_count
    rem_q: int = total_cases % vu_count

    w_i: int = 0
    while w_i < vu_count:
        q: int = base_q
        if w_i < rem_q:
            q = q + 1
        if q < 1:
            q = 1
        spawn _vu_fiber_task(q, work_ms, active_h, peak_h, cancel_h, ready_ch, go_ch, done_ch)
        w_i = w_i + 1

    # Wait for all VU fibers to be simultaneously active in-flight
    r_i: int = 0
    while r_i < vu_count:
        _r: int = await ready_ch.recv()
        r_i = r_i + 1

    _update_atomic_peak(peak_c, active_c.load())
    # State 1: All VU fibers are now simultaneously active in-flight
    done_c.store(1)

    if hold_until_cancel == 1:
        # Hold all VUs active in-flight while the caller executes real task_func / handler callbacks
        hold_ticks: int = 0
        while cancel_c.load() == 0 and hold_ticks < 10000:
            nox.time.sleep_ms(1)
            hold_ticks = hold_ticks + 1

    # Release all VU fibers to complete and exit
    g_i: int = 0
    while g_i < vu_count:
        await go_ch.send(1)
        g_i = g_i + 1

    total_elapsed: int = 0
    d_i: int = 0
    while d_i < vu_count:
        el: int = await done_ch.recv()
        total_elapsed = total_elapsed + el
        d_i = d_i + 1

    dur_c.add(total_elapsed)
    # Decrement worker reference BEFORE signaling done_c = 2 so a joining caller's decrement is guaranteed to reach 0
    rem_w: int = AtomicInt(ref_h).decrement()
    if rem_w == 0:
        AtomicInt(active_h).free()
        AtomicInt(peak_h).free()
        AtomicInt(done_h).free()
        AtomicInt(dur_h).free()
        AtomicInt(cancel_h).free()
        AtomicInt(ref_h).free()
    else:
        done_c.store(2)
    return total_elapsed

class ConcurrentWaveScope:
    vu_count: int
    active_h: int
    peak_h: int
    done_h: int
    dur_h: int
    cancel_h: int
    ref_h: int
    is_closed: bool
    is_ready: bool
    worker_joined: bool

    def __init__(self: ConcurrentWaveScope, vu_count: int, active_h: int, peak_h: int, done_h: int, dur_h: int, cancel_h: int, ref_h: int, is_ready: bool = True) -> None:
        self.vu_count = vu_count
        self.active_h = active_h
        self.peak_h = peak_h
        self.done_h = done_h
        self.dur_h = dur_h
        self.cancel_h = cancel_h
        self.ref_h = ref_h
        self.is_closed = False
        self.is_ready = is_ready
        self.worker_joined = False

    def active_count(self: ConcurrentWaveScope) -> int:
        if self.is_closed:
            return 0
        # Return exact atomic load without artificial floor clamping
        return AtomicInt(self.active_h).load()

    def peak_count(self: ConcurrentWaveScope) -> int:
        if self.is_closed and self.worker_joined:
            return 0
        return AtomicInt(self.peak_h).load()

    def is_worker_finished(self: ConcurrentWaveScope) -> bool:
        if self.worker_joined:
            return True
        if self.is_closed:
            return True
        return AtomicInt(self.done_h).load() >= 2

    def close(self: ConcurrentWaveScope, wait_timeout_ms: int = 2000) -> bool:
        if self.is_closed:
            return self.worker_joined
        self.is_closed = True
        cancel_c: AtomicInt = AtomicInt(self.cancel_h)
        done_c: AtomicInt = AtomicInt(self.done_h)
        cancel_c.store(1)

        wait_ticks: int = 0
        while done_c.load() < 2 and wait_ticks < wait_timeout_ms:
            nox.time.sleep_ms(1)
            wait_ticks = wait_ticks + 1

        self.worker_joined = (done_c.load() >= 2)
        # Reference-counted release: only frees AtomicInt handles if worker has also finished (rem == 0).
        # If worker timed out (done_c.load() < 2), rem becomes 1 and the worker frees handles upon exit.
        freed_now: bool = _release_wave_atomics(self.active_h, self.peak_h, self.done_h, self.dur_h, self.cancel_h, self.ref_h)
        if freed_now:
            self.worker_joined = True
        return freed_now

def open_concurrent_wave_scope(vu_count: int, startup_timeout_ms: int = 2000) -> ConcurrentWaveScope:
    eff_vus: int = vu_count
    if eff_vus < 1:
        eff_vus = 1

    active_cell: AtomicInt = nox.atomic.new_int(0)
    peak_cell: AtomicInt = nox.atomic.new_int(0)
    done_cell: AtomicInt = nox.atomic.new_int(0)
    dur_cell: AtomicInt = nox.atomic.new_int(0)
    cancel_cell: AtomicInt = nox.atomic.new_int(0)
    # 2 references: 1 for caller (ConcurrentWaveScope.close), 1 for spawned worker (_run_concurrent_vu_fibers)
    ref_cell: AtomicInt = nox.atomic.new_int(2)

    cfg_s: str = (
        str(eff_vus) + "," +
        str(eff_vus) + ",0," +
        str(active_cell.handle) + "," +
        str(peak_cell.handle) + "," +
        str(done_cell.handle) + "," +
        str(dur_cell.handle) + "," +
        str(cancel_cell.handle) + "," +
        str(ref_cell.handle) + ",1"
    )
    _h: ThreadHandle[int] = nox.thread.start(_run_concurrent_vu_fibers, cfg_s)

    # Wait until all VU fibers have entered the in-flight state (done_cell >= 1)
    wait_ticks: int = 0
    while done_cell.load() < 1 and wait_ticks < startup_timeout_ms:
        nox.time.sleep_ms(1)
        wait_ticks = wait_ticks + 1

    ready_ok: bool = (done_cell.load() >= 1)
    if not ready_ok:
        cancel_cell.store(1)

    return ConcurrentWaveScope(
        eff_vus,
        active_cell.handle,
        peak_cell.handle,
        done_cell.handle,
        dur_cell.handle,
        cancel_cell.handle,
        ref_cell.handle,
        ready_ok
    )

# ── Per-VU Coroutine Fibers for Concurrent Callback & Handler Execution ──
# Each Virtual User runs its own independent coroutine fiber (`Generator[int, int]`).
# In every wave, all active VU coroutines enter their in-flight request window simultaneously,
# incrementing `active_requests` before invoking their callback and decrementing on completion.

def _make_task_vu_coroutine(vu_id: int, task_func: (int) -> bool, active_c: AtomicInt, peak_c: AtomicInt) -> Generator[int, int]:
    # Startup handshake: yield vu_id and wait for first case_idx
    case_idx: int = yield vu_id
    while case_idx >= 0:
        cur: int = active_c.increment()
        _update_atomic_peak(peak_c, cur)

        # Wave barrier: suspend while inside the active request window so all VUs in the wave
        # are simultaneously active in-flight when each callback executes.
        _go_sig: int = yield cur

        ok: bool = False
        try:
            ok = task_func(case_idx)
        except Exception as e:
            ok = False

        # Phase 2: yield callback result while holding active_c in-flight
        _post_sig: int = yield (1 if ok else 0)

        # Phase 3: decrement after all wave callbacks complete
        active_c.decrement()
        case_idx = yield _post_sig
    return

def _make_scoped_task_vu_coroutine(vu_id: int, scoped_task_func: (int, int) -> bool, active_c: AtomicInt, peak_c: AtomicInt) -> Generator[int, int]:
    case_idx: int = yield vu_id
    while case_idx >= 0:
        cur: int = active_c.increment()
        _update_atomic_peak(peak_c, cur)

        _go_sig: int = yield cur

        live_active: int = active_c.load()
        _update_atomic_peak(peak_c, live_active)
        ok: bool = False
        try:
            ok = scoped_task_func(case_idx, live_active)
        except Exception as e:
            ok = False

        _post_sig: int = yield (1 if ok else 0)
        active_c.decrement()
        case_idx = yield _post_sig
    return

def _make_handler_vu_coroutine(vu_id: int, handler: (HttpRequest) -> HttpResponse, req: HttpRequest, active_c: AtomicInt, peak_c: AtomicInt) -> Generator[int, int]:
    case_idx: int = yield vu_id
    while case_idx >= 0:
        cur: int = active_c.increment()
        _update_atomic_peak(peak_c, cur)

        _go_sig: int = yield cur

        status_code: int = 500
        try:
            res: HttpResponse = handler(req)
            status_code = res.status
        except Exception as e:
            status_code = 500

        _post_sig: int = yield status_code
        active_c.decrement()
        case_idx = yield _post_sig
    return

def _close_vu_coroutines(coros: list[Generator[int, int]]) -> None:
    i: int = 0
    while i < len(coros):
        try:
            coros[i].close()
        except Exception as e:
            pass
        i = i + 1

def run_task_workload_internal(workload: WorkloadConfig, task_func: (int) -> bool, thresholds: list[Threshold], limits: SafetyLimits, reporter: JsonlStreamReporter | None) -> LoadTestSummary:
    metrics: LoadMetrics = LoadMetrics()
    cb: CircuitBreaker = CircuitBreaker(limits.max_consecutive_errors)

    t0: Instant = nox.time.instant_now()
    deadline_ms: int = limits.duration_seconds * 1000
    if workload.duration_seconds > 0 and workload.duration_seconds * 1000 < deadline_ms:
        deadline_ms = workload.duration_seconds * 1000

    max_cases: int = workload.max_iterations
    case_idx: int = 0
    aborted: bool = False
    abort_reason: str = ""

    in_flight: int = 0
    vu_states: list[VirtualUserState] = []

    if workload.model == MODEL_CLOSED:
        # Closed model: each VU runs its own coroutine fiber and executes task_func in concurrent waves
        vu_count: int = workload.virtual_users
        if vu_count > limits.virtual_users:
            vu_count = limits.virtual_users
        if vu_count < 1:
            vu_count = 1

        active_requests: AtomicInt = nox.atomic.new_int(0)
        peak_requests: AtomicInt = nox.atomic.new_int(0)
        vu_coros: list[Generator[int, int]] = []

        v_i: int = 0
        while v_i < vu_count:
            vu_states.append(VirtualUserState(v_i))
            coro: Generator[int, int] = _make_task_vu_coroutine(v_i, task_func, active_requests, peak_requests)
            _init_id: int = next(coro)
            vu_coros.append(coro)
            v_i = v_i + 1

        while case_idx < max_cases and t0.elapsed_ms() < deadline_ms and (not aborted):
            try:
                cb.check_healthy()
            except CircuitBreakerTrippedError as e:
                aborted = True
                abort_reason = str(e)
                break

            # Determine wave batch size (up to vu_count concurrent VUs)
            rem_cases: int = max_cases - case_idx
            wave_size: int = vu_count
            if rem_cases < wave_size:
                wave_size = rem_cases

            # Phase 1: All VUs in this wave enter their active request window simultaneously
            w_enter: int = 0
            while w_enter < wave_size:
                metrics.record_scheduled()
                _cur_in_flight: int = vu_coros[w_enter].send(case_idx + w_enter)
                w_enter = w_enter + 1

            # Record true active callback concurrency while all wave VUs are simultaneously in-flight
            metrics.record_concurrency(active_requests.load())

            # Phase 2: Step each VU fiber through its real task_func callback execution
            w_exec: int = 0
            while w_exec < wave_size:
                cur_case: int = case_idx + w_exec
                task_t0: Instant = nox.time.instant_now()
                ok_int: int = vu_coros[w_exec].send(1)
                task_duration: int = task_t0.elapsed_ms()
                metrics.record_concurrency(peak_requests.load())

                success: bool = (ok_int == 1)
                is_timeout: bool = (task_duration > limits.timeout_ms)

                status: int = 200
                if is_timeout:
                    status = 504
                    success = False
                    cb.record_failure("task timed out (exceeded " + str(limits.timeout_ms) + "ms)")
                elif not success:
                    status = 500
                    cb.record_failure("task failed at case " + str(cur_case))
                else:
                    cb.record_success()

                metrics.record_result(status, task_duration, is_timeout, success)
                vu_states[w_exec].record(task_duration, success and (not is_timeout))

                # Live intermediate streaming telemetry during execution
                completed_now: int = metrics.completed
                if reporter != None and (completed_now % 5 == 0):
                    cur_ms: int = t0.elapsed_ms()
                    reporter.emit_metric_tick(workload.name, completed_now, metrics.throughput_rps(cur_ms), metrics.p50(), metrics.p95())
                    cur_th: list[ThresholdResult] = evaluate_all_thresholds(thresholds, metrics, cur_ms)
                    c_k: int = 0
                    while c_k < len(cur_th):
                        if not cur_th[c_k].passed:
                            reporter.emit_threshold_breach(workload.name, cur_th[c_k].metric_name, cur_th[c_k].target_value, cur_th[c_k].actual_value)
                        c_k = c_k + 1

                # Check if circuit breaker tripped mid-wave
                if cb.is_tripped:
                    # Drain remaining VUs in this wave cleanly
                    w_drain: int = w_exec + 1
                    while w_drain < wave_size:
                        _drained: int = vu_coros[w_drain].send(1)
                        w_drain = w_drain + 1
                    aborted = True
                    try:
                        cb.check_healthy()
                    except CircuitBreakerTrippedError as trip_e:
                        abort_reason = str(trip_e)
                    break

                w_exec = w_exec + 1

            # Phase 3: Wave completion - decrement active_requests after all callbacks in wave have executed
            if not aborted:
                w_exit: int = 0
                while w_exit < wave_size:
                    _post_done: int = vu_coros[w_exit].send(1)
                    w_exit = w_exit + 1

            case_idx = case_idx + wave_size

        _close_vu_coroutines(vu_coros)
        active_requests.free()
        peak_requests.free()

    elif workload.model == MODEL_OPEN:
        # Open model: target arrival rate pacing with in-flight backpressure
        vu_states.append(VirtualUserState(0))
        target_rps: int = workload.target_rps
        if target_rps > limits.rate_rps:
            target_rps = limits.rate_rps
        if target_rps < 1:
            target_rps = 1

        while case_idx < max_cases and t0.elapsed_ms() < deadline_ms:
            # Rate pacing: expected arrival time for case_idx
            expected_ms: int = (case_idx * 1000) // target_rps
            rem_ms: int = expected_ms - t0.elapsed_ms()
            if rem_ms > 0:
                if t0.elapsed_ms() + rem_ms > deadline_ms:
                    rem_ms = deadline_ms - t0.elapsed_ms()
                if rem_ms > 0:
                    nox.time.sleep_ms(rem_ms)

            if t0.elapsed_ms() >= deadline_ms:
                break

            metrics.record_scheduled()

            # Backpressure guard: reject arrival if in_flight capacity reached
            if in_flight >= limits.max_in_flight:
                metrics.record_rejected()
                case_idx = case_idx + 1
                continue

            try:
                cb.check_healthy()
            except CircuitBreakerTrippedError as e:
                aborted = True
                abort_reason = str(e)
                break

            in_flight = in_flight + 1
            metrics.record_concurrency(in_flight)
            task_t0: Instant = nox.time.instant_now()
            success: bool = False
            try:
                success = task_func(case_idx)
            except Exception as e:
                success = False
            in_flight = in_flight - 1

            task_duration: int = task_t0.elapsed_ms()
            is_timeout: bool = (task_duration > limits.timeout_ms)

            status: int = 200
            if is_timeout:
                status = 504
                success = False
                cb.record_failure("task timed out (exceeded " + str(limits.timeout_ms) + "ms)")
            elif not success:
                status = 500
                cb.record_failure("task failed at case " + str(case_idx))
            else:
                cb.record_success()

            metrics.record_result(status, task_duration, is_timeout, success)
            vu_states[0].record(task_duration, success and (not is_timeout))
            case_idx = case_idx + 1

    if (not aborted) and t0.elapsed_ms() >= deadline_ms:
        if workload.duration_seconds <= 0 and case_idx < max_cases:
            aborted = True
            abort_reason = "workload execution deadline reached (" + str(deadline_ms) + "ms)"

    total_duration_ms: int = t0.elapsed_ms()
    thresh_results: list[ThresholdResult] = evaluate_all_thresholds(thresholds, metrics, total_duration_ms)
    all_passed: bool = (not aborted) and all_thresholds_passed(thresh_results)

    return LoadTestSummary(workload.name, metrics, thresh_results, total_duration_ms, all_passed, aborted, abort_reason, vu_states)

def run_scoped_task_workload(workload: WorkloadConfig, scoped_task_func: (int, int) -> bool, thresholds: list[Threshold], limits: SafetyLimits) -> LoadTestSummary:
    metrics: LoadMetrics = LoadMetrics()
    cb: CircuitBreaker = CircuitBreaker(limits.max_consecutive_errors)

    t0: Instant = nox.time.instant_now()
    deadline_ms: int = limits.duration_seconds * 1000
    if workload.duration_seconds > 0 and workload.duration_seconds * 1000 < deadline_ms:
        deadline_ms = workload.duration_seconds * 1000

    max_cases: int = workload.max_iterations
    case_idx: int = 0
    aborted: bool = False
    abort_reason: str = ""

    vu_count: int = workload.virtual_users
    if vu_count > limits.virtual_users:
        vu_count = limits.virtual_users
    if vu_count < 1:
        vu_count = 1

    active_requests: AtomicInt = nox.atomic.new_int(0)
    peak_requests: AtomicInt = nox.atomic.new_int(0)
    vu_states: list[VirtualUserState] = []
    vu_coros: list[Generator[int, int]] = []

    v_i: int = 0
    while v_i < vu_count:
        vu_states.append(VirtualUserState(v_i))
        coro: Generator[int, int] = _make_scoped_task_vu_coroutine(v_i, scoped_task_func, active_requests, peak_requests)
        _init_id: int = next(coro)
        vu_coros.append(coro)
        v_i = v_i + 1

    while case_idx < max_cases and t0.elapsed_ms() < deadline_ms and (not aborted):
        try:
            cb.check_healthy()
        except CircuitBreakerTrippedError as e:
            aborted = True
            abort_reason = str(e)
            break

        rem_cases: int = max_cases - case_idx
        wave_size: int = vu_count
        if rem_cases < wave_size:
            wave_size = rem_cases

        w_enter: int = 0
        while w_enter < wave_size:
            metrics.record_scheduled()
            _cur_in_flight: int = vu_coros[w_enter].send(case_idx + w_enter)
            w_enter = w_enter + 1

        metrics.record_concurrency(active_requests.load())

        w_exec: int = 0
        while w_exec < wave_size:
            cur_case: int = case_idx + w_exec
            task_t0: Instant = nox.time.instant_now()
            ok_int: int = vu_coros[w_exec].send(1)
            task_duration: int = task_t0.elapsed_ms()
            metrics.record_concurrency(peak_requests.load())

            success: bool = (ok_int == 1)
            is_timeout: bool = (task_duration > limits.timeout_ms)

            status: int = 200
            if is_timeout:
                status = 504
                success = False
                cb.record_failure("task timed out (exceeded " + str(limits.timeout_ms) + "ms)")
            elif not success:
                status = 500
                cb.record_failure("task failed at case " + str(cur_case))
            else:
                cb.record_success()

            metrics.record_result(status, task_duration, is_timeout, success)
            vu_states[w_exec].record(task_duration, success and (not is_timeout))

            if cb.is_tripped:
                w_drain: int = w_exec + 1
                while w_drain < wave_size:
                    _drained: int = vu_coros[w_drain].send(1)
                    w_drain = w_drain + 1
                aborted = True
                try:
                    cb.check_healthy()
                except CircuitBreakerTrippedError as trip_e:
                    abort_reason = str(trip_e)
                break

            w_exec = w_exec + 1

        # Phase 3: Wave completion - decrement active_requests after all callbacks in wave have executed
        if not aborted:
            w_exit: int = 0
            while w_exit < wave_size:
                _post_done: int = vu_coros[w_exit].send(1)
                w_exit = w_exit + 1

        case_idx = case_idx + wave_size

    _close_vu_coroutines(vu_coros)
    active_requests.free()
    peak_requests.free()

    total_duration_ms: int = t0.elapsed_ms()
    thresh_results: list[ThresholdResult] = evaluate_all_thresholds(thresholds, metrics, total_duration_ms)
    all_passed: bool = (not aborted) and all_thresholds_passed(thresh_results)

    return LoadTestSummary(workload.name, metrics, thresh_results, total_duration_ms, all_passed, aborted, abort_reason, vu_states)

def run_parallel_thread_workload(workload: WorkloadConfig, task_func: (int) -> bool, thresholds: list[Threshold], limits: SafetyLimits) -> LoadTestSummary:
    return run_task_workload_internal(workload, task_func, thresholds, limits, None)

def run_task_workload(workload: WorkloadConfig, task_func: (int) -> bool, thresholds: list[Threshold], limits: SafetyLimits) -> LoadTestSummary:
    return run_task_workload_internal(workload, task_func, thresholds, limits, None)

def run_handler_load_test(workload: WorkloadConfig, handler: (HttpRequest) -> HttpResponse, req: HttpRequest, thresholds: list[Threshold], limits: SafetyLimits) -> LoadTestSummary:
    metrics: LoadMetrics = LoadMetrics()
    cb: CircuitBreaker = CircuitBreaker(limits.max_consecutive_errors)

    t0: Instant = nox.time.instant_now()
    deadline_ms: int = limits.duration_seconds * 1000
    if workload.duration_seconds > 0 and workload.duration_seconds * 1000 < deadline_ms:
        deadline_ms = workload.duration_seconds * 1000

    max_cases: int = workload.max_iterations
    case_idx: int = 0
    aborted: bool = False
    abort_reason: str = ""

    vu_count: int = workload.virtual_users
    if vu_count > limits.virtual_users:
        vu_count = limits.virtual_users
    if vu_count < 1:
        vu_count = 1

    active_requests: AtomicInt = nox.atomic.new_int(0)
    peak_requests: AtomicInt = nox.atomic.new_int(0)
    vu_states: list[VirtualUserState] = []
    vu_coros: list[Generator[int, int]] = []

    v_i: int = 0
    while v_i < vu_count:
        vu_states.append(VirtualUserState(v_i))
        coro: Generator[int, int] = _make_handler_vu_coroutine(v_i, handler, req, active_requests, peak_requests)
        _init_id: int = next(coro)
        vu_coros.append(coro)
        v_i = v_i + 1

    while case_idx < max_cases and t0.elapsed_ms() < deadline_ms and (not aborted):
        try:
            cb.check_healthy()
        except CircuitBreakerTrippedError as e:
            aborted = True
            abort_reason = str(e)
            break

        rem_cases: int = max_cases - case_idx
        wave_size: int = vu_count
        if rem_cases < wave_size:
            wave_size = rem_cases

        w_enter: int = 0
        while w_enter < wave_size:
            metrics.record_scheduled()
            _cur_in_flight: int = vu_coros[w_enter].send(case_idx + w_enter)
            w_enter = w_enter + 1

        metrics.record_concurrency(active_requests.load())

        w_exec: int = 0
        while w_exec < wave_size:
            cur_case: int = case_idx + w_exec
            task_t0: Instant = nox.time.instant_now()
            status_code: int = vu_coros[w_exec].send(1)
            task_duration: int = task_t0.elapsed_ms()
            metrics.record_concurrency(peak_requests.load())

            success: bool = (status_code >= 200 and status_code < 400)
            is_timeout: bool = (task_duration > limits.timeout_ms)
            if is_timeout:
                status_code = 504
                success = False
                cb.record_failure("HTTP handler timed out (exceeded " + str(limits.timeout_ms) + "ms)")
            elif not success:
                cb.record_failure("HTTP handler returned status " + str(status_code) + " at case " + str(cur_case))
            else:
                cb.record_success()

            metrics.record_result(status_code, task_duration, is_timeout, success)
            vu_states[w_exec].record(task_duration, success and (not is_timeout))

            if cb.is_tripped:
                w_drain: int = w_exec + 1
                while w_drain < wave_size:
                    _drained: int = vu_coros[w_drain].send(1)
                    w_drain = w_drain + 1
                aborted = True
                try:
                    cb.check_healthy()
                except CircuitBreakerTrippedError as trip_e:
                    abort_reason = str(trip_e)
                break

            w_exec = w_exec + 1

        # Phase 3: Wave completion - decrement active_requests after all callbacks in wave have executed
        if not aborted:
            w_exit: int = 0
            while w_exit < wave_size:
                _post_done: int = vu_coros[w_exit].send(1)
                w_exit = w_exit + 1

        case_idx = case_idx + wave_size

    _close_vu_coroutines(vu_coros)
    active_requests.free()
    peak_requests.free()

    total_duration_ms: int = t0.elapsed_ms()
    thresh_results: list[ThresholdResult] = evaluate_all_thresholds(thresholds, metrics, total_duration_ms)
    all_passed: bool = (not aborted) and all_thresholds_passed(thresh_results)

    return LoadTestSummary(workload.name, metrics, thresh_results, total_duration_ms, all_passed, aborted, abort_reason, vu_states)

# ── Per-VU Network Load Worker & Concurrent Workload Runner ──
# Drives concurrent Virtual User worker threads across network HTTP endpoints using `nox.thread.start`
# with policy enforcement, monotonic timing, individual latency tracking, and circuit breakers.

def _str_index_from(s: str, needle: str, start: int) -> int:
    if start >= len(s):
        return -1
    sub: str = s[start:len(s)]
    idx: int = nox.strings.index_of(sub, needle)
    if idx < 0:
        return -1
    return start + idx

def _pack_net_worker_config(meta: str, method: str, url: str, headers: dict[str, str], body: str) -> str:
    res: str = meta + "\n" + method + "\n" + url + "\n"
    hdr_keys: list[str] = []
    for k in headers:
        hdr_keys.append(k)
    res = res + str(len(hdr_keys)) + "\n"
    i: int = 0
    while i < len(hdr_keys):
        k: str = hdr_keys[i]
        v: str = headers[k]
        res = res + str(len(k)) + "," + str(len(v)) + "\n" + k + v + "\n"
        i = i + 1
    res = res + str(len(body)) + "\n" + body
    return res

async def _net_vu_thread_worker(cfg_str: str) -> int:
    try:
        nl1: int = nox.strings.index_of(cfg_str, "\n")
        meta_line: str = cfg_str[0:nl1]
        nums: list[str] = nox.strings.split(meta_line, ",")
        eff_timeout: int = int(nums[0])
        act_h: int = int(nums[1])
        pk_h: int = int(nums[2])
        status_h: int = int(nums[3])
        dur_h: int = int(nums[4])
        done_h: int = int(nums[5])
        ref_h: int = int(nums[6])
        wv_ref_h: int = int(nums[7])
        vu_id: int = int(nums[8])
        case_idx: int = int(nums[9])

        nl2: int = _str_index_from(cfg_str, "\n", nl1 + 1)
        method: str = cfg_str[nl1 + 1:nl2]

        nl3: int = _str_index_from(cfg_str, "\n", nl2 + 1)
        full_url: str = cfg_str[nl2 + 1:nl3]

        nl4: int = _str_index_from(cfg_str, "\n", nl3 + 1)
        hdr_count: int = int(cfg_str[nl3 + 1:nl4])

        hdrs: dict[str, str] = {}
        cur_pos: int = nl4 + 1
        h_i: int = 0
        while h_i < hdr_count:
            next_nl: int = _str_index_from(cfg_str, "\n", cur_pos)
            lens_line: str = cfg_str[cur_pos:next_nl]
            comma: int = nox.strings.index_of(lens_line, ",")
            len_k: int = int(lens_line[0:comma])
            len_v: int = int(lens_line[comma + 1:len(lens_line)])

            kv_start: int = next_nl + 1
            k: str = cfg_str[kv_start:kv_start + len_k]
            v: str = cfg_str[kv_start + len_k:kv_start + len_k + len_v]
            hdrs[k] = v

            cur_pos = kv_start + len_k + len_v + 1
            h_i = h_i + 1

        next_nl_body: int = _str_index_from(cfg_str, "\n", cur_pos)
        body_len: int = int(cfg_str[cur_pos:next_nl_body])
        body_start: int = next_nl_body + 1
        req_body: str = cfg_str[body_start:body_start + body_len]

        hdrs["X-Quartz-VU"] = str(vu_id)

        act_c: AtomicInt = AtomicInt(act_h)
        pk_c: AtomicInt = AtomicInt(pk_h)
        status_c: AtomicInt = AtomicInt(status_h)
        dur_c: AtomicInt = AtomicInt(dur_h)
        done_c: AtomicInt = AtomicInt(done_h)
        ref_c: AtomicInt = AtomicInt(ref_h)
        wv_ref_c: AtomicInt = AtomicInt(wv_ref_h)

        cur: int = act_c.increment()
        _update_atomic_peak(pk_c, cur)

        t0: Instant = nox.time.instant_now()
        status_code: int = 500
        try:
            res: HttpResponse = nox.http.request(method, full_url, req_body, hdrs, eff_timeout)
            status_code = res.status
        except Exception as e:
            status_code = 500

        elapsed: int = t0.elapsed_ms()
        if elapsed > eff_timeout:
            status_code = 504


        act_c.decrement()
        dur_c.store(elapsed)
        status_c.store(status_code)
        done_c.increment()

        w_rem: int = ref_c.decrement()
        if w_rem == 0:
            status_c.free()
            dur_c.free()
            ref_c.free()

        wv_rem: int = wv_ref_c.decrement()
        if wv_rem == 0:
            done_c.free()
            wv_ref_c.free()
            act_c.free()
            pk_c.free()

        return status_code
    except Exception as top_e:
        return 500

def run_network_load_test(workload: WorkloadConfig, req: HttpRequest, base_url: str, policy: NetworkPolicy, thresholds: list[Threshold], limits: SafetyLimits) -> LoadTestSummary:
    metrics: LoadMetrics = LoadMetrics()
    cb: CircuitBreaker = CircuitBreaker(limits.max_consecutive_errors)

    t0: Instant = nox.time.instant_now()
    deadline_ms: int = limits.duration_seconds * 1000
    if workload.duration_seconds > 0 and workload.duration_seconds * 1000 < deadline_ms:
        deadline_ms = workload.duration_seconds * 1000

    max_cases: int = workload.max_iterations
    case_idx: int = 0
    aborted: bool = False
    abort_reason: str = ""

    vu_count: int = workload.virtual_users
    if vu_count > limits.virtual_users:
        vu_count = limits.virtual_users
    if vu_count < 1:
        vu_count = 1

    target_path: str = req.target
    if len(target_path) == 0 or target_path[0:1] != "/":
        target_path = "/" + target_path
    full_url: str = base_url + target_path
    _parsed: ParsedUrl = validate_network_target(full_url, policy)

    eff_timeout: int = limits.timeout_ms
    if policy.timeout_ms > 0 and policy.timeout_ms < eff_timeout:
        eff_timeout = policy.timeout_ms
    if eff_timeout < 10:
        eff_timeout = 10

    vu_states: list[VirtualUserState] = []

    v_i: int = 0
    while v_i < vu_count:
        vu_states.append(VirtualUserState(v_i))
        v_i = v_i + 1

    while case_idx < max_cases and t0.elapsed_ms() < deadline_ms and (not aborted):
        try:
            cb.check_healthy()
        except CircuitBreakerTrippedError as e:
            aborted = True
            abort_reason = str(e)
            break

        rem_cases: int = max_cases - case_idx
        wave_size: int = vu_count
        if rem_cases < wave_size:
            wave_size = rem_cases

        w_status_cells: list[AtomicInt] = []
        w_dur_cells: list[AtomicInt] = []
        w_ref_cells: list[AtomicInt] = []
        wave_done: AtomicInt = nox.atomic.new_int(0)
        wave_act: AtomicInt = nox.atomic.new_int(0)
        wave_pk: AtomicInt = nox.atomic.new_int(0)
        # Wave-level reference count: 1 for coordinator + 1 for each worker
        wave_ref: AtomicInt = nox.atomic.new_int(1 + wave_size)

        # Spawn all VU worker threads simultaneously in this wave
        w_spawn: int = 0
        while w_spawn < wave_size:
            metrics.record_scheduled()
            st_cell: AtomicInt = nox.atomic.new_int(0)
            dur_cell: AtomicInt = nox.atomic.new_int(0)
            ref_cell: AtomicInt = nox.atomic.new_int(2)
            w_status_cells.append(st_cell)
            w_dur_cells.append(dur_cell)
            w_ref_cells.append(ref_cell)

            cur_case: int = case_idx + w_spawn
            meta_s: str = (
                str(eff_timeout) + "," +
                str(wave_act.handle) + "," +
                str(wave_pk.handle) + "," +
                str(st_cell.handle) + "," +
                str(dur_cell.handle) + "," +
                str(wave_done.handle) + "," +
                str(ref_cell.handle) + "," +
                str(wave_ref.handle) + "," +
                str(w_spawn) + "," +
                str(cur_case)
            )
            cfg_s: str = _pack_net_worker_config(meta_s, req.method, full_url, req.headers, req.body)
            th: ThreadHandle[int] = nox.thread.start(_net_vu_thread_worker, cfg_s)
            w_spawn = w_spawn + 1

        # Wait for all VU worker threads in this wave to complete (with timeout safety)
        t_wait: Instant = nox.time.instant_now()
        max_wait: int = eff_timeout + 2500
        while wave_done.load() < wave_size and t_wait.elapsed_ms() < max_wait:
            nox.time.sleep_ms(1)

        metrics.record_concurrency(wave_pk.load())

        # Collect each VU's individual latency and status
        w_collect: int = 0
        while w_collect < wave_size:
            cur_case = case_idx + w_collect
            status_code: int = w_status_cells[w_collect].load()
            req_duration: int = w_dur_cells[w_collect].load()
            if req_duration < 1:
                req_duration = 1

            # Decrement worker ref-count; only free if worker already exited (rem == 0)
            c_rem: int = w_ref_cells[w_collect].decrement()
            if c_rem == 0:
                w_status_cells[w_collect].free()
                w_dur_cells[w_collect].free()
                w_ref_cells[w_collect].free()

            is_timeout: bool = (status_code == 504) or (req_duration > limits.timeout_ms)
            success: bool = (status_code >= 200 and status_code < 400 and (not is_timeout))

            if is_timeout:
                cb.record_failure("network request timed out")
            elif not success:
                cb.record_failure("network request failed with status " + str(status_code))
            else:
                cb.record_success()

            metrics.record_result(status_code, req_duration, is_timeout, success)
            vu_states[w_collect].record(req_duration, success)

            if cb.is_tripped:
                aborted = True
                try:
                    cb.check_healthy()
                except CircuitBreakerTrippedError as trip_e:
                    abort_reason = str(trip_e)
                break

            w_collect = w_collect + 1

        w_drain: int = w_collect + 1
        while w_drain < wave_size:
            rem_drain: int = w_ref_cells[w_drain].decrement()
            if rem_drain == 0:
                w_status_cells[w_drain].free()
                w_dur_cells[w_drain].free()
                w_ref_cells[w_drain].free()
            w_drain = w_drain + 1

        # Decrement wave-level ref count; only free wave cells if all workers already exited (c_wv_rem == 0)
        c_wv_rem: int = wave_ref.decrement()
        if c_wv_rem == 0:
            wave_done.free()
            wave_ref.free()
            wave_act.free()
            wave_pk.free()

        case_idx = case_idx + wave_size

    total_duration_ms: int = t0.elapsed_ms()
    thresh_results: list[ThresholdResult] = evaluate_all_thresholds(thresholds, metrics, total_duration_ms)
    all_passed: bool = (not aborted) and all_thresholds_passed(thresh_results)

    return LoadTestSummary(workload.name, metrics, thresh_results, total_duration_ms, all_passed, aborted, abort_reason, vu_states)

def run_task_workload_streaming(workload: WorkloadConfig, task_func: (int) -> bool, thresholds: list[Threshold], limits: SafetyLimits, reporter: JsonlStreamReporter) -> LoadTestSummary:
    reporter.emit_case_start(workload.name, "workload_execution")
    summary: LoadTestSummary = run_task_workload_internal(workload, task_func, thresholds, limits, reporter)

    reporter.emit_metric_tick(workload.name, summary.metrics.completed, summary.metrics.throughput_rps(summary.total_duration_ms), summary.metrics.p50(), summary.metrics.p95())

    t_i: int = 0
    while t_i < len(summary.threshold_results):
        tr: ThresholdResult = summary.threshold_results[t_i]
        if not tr.passed:
            reporter.emit_threshold_breach(workload.name, tr.metric_name, tr.target_value, tr.actual_value)
        t_i = t_i + 1

    status_str: str = "PASS" if summary.all_passed else "FAIL"
    msg_str: str = summary.abort_reason if summary.aborted else ("completed in " + str(summary.total_duration_ms) + "ms")
    reporter.emit_case_result(workload.name, "workload_execution", status_str, summary.total_duration_ms, msg_str)
    return summary
