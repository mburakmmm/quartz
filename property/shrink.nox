# Quartz Property — Shrinking Engine

class ShrinkResultInt:
    value: int
    attempts: int

    def __init__(self: ShrinkResultInt, value: int, attempts: int) -> None:
        self.value = value
        self.attempts = attempts

class ShrinkResultStr:
    value: str
    attempts: int

    def __init__(self: ShrinkResultStr, value: str, attempts: int) -> None:
        self.value = value
        self.attempts = attempts

class ShrinkResultListInt:
    value: list[int]
    attempts: int

    def __init__(self: ShrinkResultListInt, value: list[int], attempts: int) -> None:
        self.value = value
        self.attempts = attempts

def shrink_int(initial: int, predicate: (int) -> bool, max_attempts: int) -> ShrinkResultInt:
    # If initial doesn't fail, nothing to shrink
    if predicate(initial):
        return ShrinkResultInt(initial, 0)

    current: int = initial
    attempts: int = 0

    # 1. Try zero first
    if current != 0 and attempts < max_attempts:
        attempts = attempts + 1
        if not predicate(0):
            current = 0
            return ShrinkResultInt(0, attempts)

    # 2. Try sign flip if negative
    if current < 0 and attempts < max_attempts:
        attempts = attempts + 1
        flipped: int = -current
        if not predicate(flipped):
            current = flipped

    # 3. Halving / binary search towards zero
    while attempts < max_attempts:
        if current == 0 or current == 1 or current == -1:
            break

        half: int = current // 2
        attempts = attempts + 1
        if not predicate(half):
            current = half
        else:
            # Try decrementing magnitude by 1
            step: int = current - 1
            if current < 0:
                step = current + 1
            attempts = attempts + 1
            if not predicate(step):
                current = step
            else:
                break

    return ShrinkResultInt(current, attempts)

def shrink_str(initial: str, predicate: (str) -> bool, max_attempts: int) -> ShrinkResultStr:
    if predicate(initial):
        return ShrinkResultStr(initial, 0)

    current: str = initial
    attempts: int = 0

    # 1. Try empty string
    if len(current) > 0 and attempts < max_attempts:
        attempts = attempts + 1
        if not predicate(""):
            return ShrinkResultStr("", attempts)

    # 2. Delta-debugging: try dropping chunks (first half, second half)
    while len(current) > 1 and attempts < max_attempts:
        str_len: int = len(current)
        mid: int = str_len // 2

        # Try first half
        left: str = ""
        i: int = 0
        while i < mid:
            left = left + current[i]
            i = i + 1

        attempts = attempts + 1
        if not predicate(left):
            current = left
        else:
            # Try second half
            right: str = ""
            j: int = mid
            while j < str_len:
                right = right + current[j]
                j = j + 1
            attempts = attempts + 1
            if not predicate(right):
                current = right
            else:
                # Try dropping single character from end
                shorter: str = ""
                k: int = 0
                while k < str_len - 1:
                    shorter = shorter + current[k]
                    k = k + 1
                attempts = attempts + 1
                if not predicate(shorter):
                    current = shorter
                else:
                    break

    return ShrinkResultStr(current, attempts)

def shrink_list_int(initial: list[int], predicate: (list[int]) -> bool, max_attempts: int) -> ShrinkResultListInt:
    if predicate(initial):
        return ShrinkResultListInt(initial, 0)

    current: list[int] = []
    c_idx: int = 0
    while c_idx < len(initial):
        current.append(initial[c_idx])
        c_idx = c_idx + 1

    attempts: int = 0

    # 1. Try empty list
    if len(current) > 0 and attempts < max_attempts:
        attempts = attempts + 1
        empty_list: list[int] = []
        if not predicate(empty_list):
            return ShrinkResultListInt(empty_list, attempts)

    # 2. Delta-debugging: delete halves
    while len(current) > 1 and attempts < max_attempts:
        n: int = len(current)
        mid: int = n // 2

        left_half: list[int] = []
        li: int = 0
        while li < mid:
            left_half.append(current[li])
            li = li + 1

        attempts = attempts + 1
        if not predicate(left_half):
            current = left_half
        else:
            right_half: list[int] = []
            ri: int = mid
            while ri < n:
                right_half.append(current[ri])
                ri = ri + 1

            attempts = attempts + 1
            if not predicate(right_half):
                current = right_half
            else:
                # Try removing single element from tail
                shorter_list: list[int] = []
                si: int = 0
                while si < n - 1:
                    shorter_list.append(current[si])
                    si = si + 1
                attempts = attempts + 1
                if not predicate(shorter_list):
                    current = shorter_list
                else:
                    break

    return ShrinkResultListInt(current, attempts)
